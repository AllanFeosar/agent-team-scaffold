# SubagentStop gate: when a subagent finishes, run the self-verification check
# for whichever layer it touched. Exit 2 sends the subagent back with the
# failure output; exit 0 lets the result through.
# FAIL OPEN: any environment problem (tool missing, git broken) exits 0 —
# a gate that blocks every subagent because a tool isn't installed is worse
# than no gate.
#
# CIRCUIT BREAKER: this gate's scoping depends on `git status --porcelain`
# reflecting only the CURRENT subagent's own changes. That assumption breaks
# if the tree already has a large uncommitted diff before this subagent even
# starts (a pending initial scaffold commit not yet landed, a concurrent
# session, etc.) — every subsequent subagent's stop then trips the SAME
# unrelated check, and one correctly refusing to blind-fix a pre-existing,
# out-of-scope failure gets sent back into an identical loop forever.
# Verified live: this happened for real, repeatedly, and burned an entire
# session's usage window with zero progress before anyone could intervene —
# see REFERENCE.md#the-self-verification-gate. GateFailBudget stops that:
# after this many CONSECUTIVE times the exact same check has failed, the
# gate fails OPEN instead of blocking again, so a stuck gate can never trap
# a subagent (or a whole session) indefinitely — it surfaces loudly instead,
# for a human to fix at the source (commit the pending diff, or fix the
# gate's scoping), the same 3-attempt budget already used everywhere else
# in this scaffold (orchestrator.mjs's SELF_VERIFY_ATTEMPT_BUDGET, the
# roster-wide "max 3 dispatches per agent per issue" rule).
$ErrorActionPreference = 'Continue'
$GateStatePath = Join-Path $PSScriptRoot '.subagent-gate-state.json'
$GateFailBudget = 3

function Get-GateState {
    if (Test-Path $GateStatePath) {
        try { return (Get-Content $GateStatePath -Raw | ConvertFrom-Json) } catch { return New-Object PSObject }
    }
    return New-Object PSObject
}

function Get-GateCount($state, [string]$check) {
    $prop = $state.PSObject.Properties[$check]
    if ($prop) { return [int]$prop.Value }
    return 0
}

function Set-GateCount($state, [string]$check, [int]$value) {
    if ($state.PSObject.Properties[$check]) { $state.$check = $value }
    else { $state | Add-Member -MemberType NoteProperty -Name $check -Value $value -Force }
}

function Save-GateState($state) {
    try { $state | ConvertTo-Json | Set-Content $GateStatePath } catch { } # best-effort; never block on state-file I/O
}

function Fail-Open([string]$msg) {
    Write-Output "subagent-gate: $msg (fail-open, letting result through)"
    exit 0
}

function Fail-Gate([string]$check, [string]$output) {
    $state = Get-GateState
    $count = (Get-GateCount $state $check) + 1

    if ($count -ge $GateFailBudget) {
        Write-Output "subagent-gate: '$check' has failed $count times in a row - circuit breaker tripped, failing OPEN rather than loop again. A human needs to look at this (a pending uncommitted diff likely makes git-status-based scoping unreliable right now, or this is a real pre-existing failure this gate can't attribute to any one subagent)."
        Set-GateCount $state $check 0  # reset so a future genuinely-new failure gets its own budget, not an instant trip
        Save-GateState $state
        exit 0
    }
    Set-GateCount $state $check $count
    Save-GateState $state

    # Trim to the last 60 lines so the subagent gets the errors, not a wall of text
    $lines = $output -split "`r?`n"
    if ($lines.Count -gt 60) { $lines = $lines[-60..-1] }
    [Console]::Error.WriteLine("Self-verification gate failed: $check (attempt $count of $GateFailBudget before this fails open)")
    [Console]::Error.WriteLine(($lines -join "`n"))
    [Console]::Error.WriteLine("Fix the failures above and rerun the check before reporting done.")
    exit 2
}

$porcelain = cmd /c "git status --porcelain 2>nul"
if ($LASTEXITCODE -ne 0) { Fail-Open "git status failed" }
if (-not $porcelain) { exit 0 }

$files = @($porcelain) | ForEach-Object {
    $p = $_.Substring(3)
    if ($p -match ' -> ') { $p = ($p -split ' -> ')[-1] }   # renames: keep new path
    $p.Trim('"')
}

<# One block per agent layer in the confirmed roster. Each block:
   1. filters $files by that layer's real path/extension pattern
   2. runs that layer's real self-verification command (from agent.md's
      Self-verification section) only if files matched
   3. Fail-Open on missing tooling, Fail-Gate on a real check failure
   Delete blocks for layers that don't exist in this project; add more for
   layers not shown here. Keep every check fast (unit tests/typecheck/config
   validation) — no e2e in this gate. #>

$<layer1>Changed = $files | Where-Object { $_ -match '<path-regex-for-layer-1, e.g. ^backend/.*\.py$>' }
if ($<layer1>Changed) {
    $out = cmd /c "<self-verification command for layer 1, e.g. cd backend && python -m pytest tests/unit -q> 2>&1"
    if ($LASTEXITCODE -eq 9009) { Fail-Open "<tool for layer 1> not on PATH" }
    if ($out -match '<a distinctive missing-dependency string for layer 1>') { Fail-Open "<dependency for layer 1> not installed" }
    if ($LASTEXITCODE -ne 0) { Fail-Gate "<layer 1 check name>" ($out -join "`n") }
}

$<layer2>Changed = $files | Where-Object { $_ -match '<path-regex-for-layer-2>' }
if ($<layer2>Changed) {
    if (-not (Test-Path '<a required local dependency for layer 2, e.g. frontend/node_modules>')) { Fail-Open "<dependency> missing" }
    $out = cmd /c "<self-verification command for layer 2> 2>&1"
    if ($LASTEXITCODE -eq 9009) { Fail-Open "<tool for layer 2> not on PATH" }
    if ($LASTEXITCODE -ne 0) { Fail-Gate "<layer 2 check name>" ($out -join "`n") }
}

# Reached here without any Fail-Gate call — every matched layer's check
# passed clean this run. Clear all accumulated failure counts rather than
# let a stale count from an already-resolved issue silently count toward a
# future, unrelated circuit-breaker trip.
if (Test-Path $GateStatePath) { Remove-Item $GateStatePath -Force -ErrorAction SilentlyContinue }
exit 0
