# PreToolUse gate on Bash: blocks `git commit` / `git push` when staged
# security-sensitive files (endpoints, auth, middleware — whatever this
# project's confirmed roster treats as security-relevant) have no matching
# entry in the security-audit-log ledger. Exit 2 blocks the command and
# returns the message to the agent; exit 0 lets it through.
# The verdict must be TIED TO THIS EXACT DIFF, not just "an audit happened
# recently" — so this checks that the ledger file itself is staged in the
# same commit AND that its new entry names every sensitive file, not just
# that <security-agent-name> ran at some point.
# FAIL OPEN: any environment problem exits 0 — this gate should never be the
# reason a legitimate commit can't land.
$ErrorActionPreference = 'Continue'

function Fail-Open([string]$msg) {
    Write-Output "security-gate: $msg (fail-open, letting the command through)"
    exit 0
}

function Fail-Gate([string]$msg) {
    [Console]::Error.WriteLine("Security gate blocked this commit: $msg")
    [Console]::Error.WriteLine("Dispatch <security-agent-name> to audit the files above, have it append a .claude/contracts/security-audit-log.md entry naming them, then retry.")
    exit 2
}

try {
    $payload = [Console]::In.ReadToEnd() | ConvertFrom-Json
} catch { Fail-Open "could not parse hook input" }

$cmd = $payload.tool_input.command
if (-not $cmd) { exit 0 }
if ($cmd -notmatch 'git\s+(commit|push)') { exit 0 }

$staged = cmd /c "git diff --cached --name-only 2>nul"
if ($LASTEXITCODE -ne 0) { Fail-Open "git diff failed" }
if (-not $staged) { exit 0 }

# The path list lives in ONE file (.claude/security-sensitive-paths.txt, from
# assets/security-sensitive-paths.template.txt) so AGENTS.md/CLAUDE.md and the
# security agent point at it instead of copying it. A missing list would silently
# disable the gate, so that blocks instead of failing open.
$pathsFile = '.claude/security-sensitive-paths.txt'
if (-not (Test-Path $pathsFile)) {
    Fail-Gate "$pathsFile is missing, so no file can be classified as security-sensitive"
}
$required = @()
$optional = @()
foreach ($line in Get-Content $pathsFile) {
    $line = $line.Trim()
    if (-not $line -or $line.StartsWith('#')) { continue }
    if ($line.StartsWith('?')) { $optional += $line.Substring(1) } else { $required += $line }
}
$patterns = $required + $optional
if (-not $patterns) { Fail-Gate "$pathsFile has no patterns" }
$sensitivePattern = ($patterns | ForEach-Object { "(?:$_)" }) -join '|'

# Liveness: every required pattern must still match a tracked file. Path-based
# gates rot silently when a refactor moves files (the moved files simply stop
# matching and become ungated). git ls-files reads the index, so this blocks the
# very commit that moves them until the list moves too.
$tracked = @(cmd /c "git ls-files 2>nul")
if ($LASTEXITCODE -ne 0) { Fail-Open "git ls-files failed" }
$dead = @($required) | Where-Object { $p = $_; -not (@($tracked) | Where-Object { $_ -match $p } | Select-Object -First 1) }
if ($dead) {
    [Console]::Error.WriteLine("Security gate blocked this commit: these patterns in $pathsFile match no tracked file: $($dead -join ', ')")
    [Console]::Error.WriteLine("Files they covered were moved or deleted. Point the patterns at the new paths (or prefix a planned path with '?'), stage $pathsFile, then retry.")
    exit 2
}

$sensitive = @($staged) | Where-Object { $_ -match $sensitivePattern -and $_ -notmatch '<test-file-regex, e.g. \.(unit|integration)\.tests\.ts$>' }
if (-not $sensitive) { exit 0 }

$ledgerPath = '.claude/contracts/security-audit-log.md'
if (-not (Test-Path $ledgerPath)) {
    Fail-Gate "security-sensitive files staged ($($sensitive -join ', ')) but $ledgerPath does not exist yet"
}

$ledgerStaged = @($staged) | Where-Object { $_ -eq $ledgerPath }
if (-not $ledgerStaged) {
    Fail-Gate "security-sensitive files staged ($($sensitive -join ', ')) but no new $ledgerPath entry is staged in this commit"
}

$ledgerDiff = (cmd /c "git diff --cached -- `"$ledgerPath`" 2>nul") -join "`n"
# $ledgerDiff must be a single joined string here, not the raw line array cmd
# returns: -notmatch against a multi-line array filters element-by-element and
# returns a (nearly always non-empty, i.e. truthy) subset, not a real boolean
# "is this substring present anywhere" check.
$missing = @($sensitive) | Where-Object { $ledgerDiff -notmatch [regex]::Escape($_) }
if ($missing) {
    Fail-Gate "these security-sensitive files aren't named in the new $ledgerPath entry: $($missing -join ', ')"
}

exit 0
