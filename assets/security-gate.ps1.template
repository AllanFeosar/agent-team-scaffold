# Security gate: blocks a change when it touches security-sensitive files and
# the security-audit-log ledger doesn't name them in lines that same change
# appends. One script, three entry points, so every tool enforces one rule:
#
#   security-gate.ps1                     Claude Code PreToolUse hook on the
#                                         Bash / PowerShell tools (reads the hook
#                                         JSON from stdin; acts on git commit/push)
#   security-gate.ps1 pre-commit          git pre-commit hook: covers Codex,
#                                         Gemini CLI, any other agent, and people
#   security-gate.ps1 range <base> <head> a branch or PR diff: orchestrator.mjs
#                                         before a worktree merge, and CI
#
# Exit 2 blocks (the PreToolUse hook and git both treat non-zero as a block);
# exit 0 lets the change through.
#
# The path list is .claude/security-sensitive-paths.txt. It is read from git,
# never the working tree, so an unstaged edit can't weaken the gate, and a
# change can't remove its own coverage: classification uses the union of the
# list before and after the change. The gate's own files are hard-coded below.
#
# FAIL OPEN only for problems outside the repo's control (unparseable hook
# input, not inside a git repository). Anything that would silently disable
# the gate (missing or invalid list, git failing mid-check) blocks instead.
param([string]$Mode = 'pretooluse', [string]$Base, [string]$Head)
$ErrorActionPreference = 'Continue'

$ledgerPath = '.claude/contracts/security-audit-log.md'
$pathsFile = '.claude/security-sensitive-paths.txt'
$selfPattern = '^\.claude/(hooks/security-gate\.(ps1|sh)|security-sensitive-paths\.txt|settings(\.local)?\.json)$|^\.githooks/'
$testPattern = '<test-file regex, e.g. \.(unit|integration)\.tests\.ts$ or (^|/)tests?/>'
$emptyTree = '4b825dc642cb6eb9a060e54bf8d69288fbee4904'

function Fail-Open([string]$msg) {
    Write-Output "security-gate: $msg (fail-open, letting the change through)"
    exit 0
}
function Fail-Config([string]$msg) {
    [Console]::Error.WriteLine("Security gate blocked this change: $msg")
    exit 2
}
function Fail-Gate([string]$msg) {
    [Console]::Error.WriteLine("Security gate blocked this change: $msg")
    [Console]::Error.WriteLine("Dispatch <security-agent-name> to audit the files above, have it append a $ledgerPath entry naming them, then retry.")
    exit 2
}
# git is called directly (never through cmd.exe), so the gate runs under Windows
# PowerShell and under pwsh on Linux and macOS alike. Arguments are split on spaces
# with "double quotes" grouping; every argument here is built from constants and refs.
function Split-Args([string]$argText) {
    return @([regex]::Matches($argText, '"[^"]*"|\S+') | ForEach-Object { $_.Value.Trim('"') })
}
function Git-Lines([string]$gitArgs) {
    $argv = @('-c', 'core.quotePath=false') + (Split-Args $gitArgs)
    $out = @(& git @argv 2>$null)
    return @{ Ok = ($LASTEXITCODE -eq 0); Lines = @($out | Where-Object { $_ -ne $null }) }
}
function Git-Quiet([string]$gitArgs) {
    $argv = Split-Args $gitArgs
    $out = @(& git @argv 2>$null)
    return @{ Ok = ($LASTEXITCODE -eq 0); Text = (($out | Where-Object { $_ -ne $null }) -join "`n").Trim() }
}

# One line on every passing check in pre-commit and range mode, so CI can tell a
# real check from an old gate script that ignores its arguments and exits 0.
function Pass-Checked([int]$n) {
    if ($Mode -ne 'pretooluse') { Write-Output "security-gate: checked $n changed file(s) in $Mode mode" }
    exit 0
}

# Splits a shell command into tokens, honouring '...' and "..." quotes, and stops
# at the first unquoted newline, command separator, or redirection. Enough to read the options
# of one git invocation; heredoc bodies on later lines are never reached.
function Read-Tokens([string]$text) {
    $tokens = New-Object System.Collections.ArrayList
    $cur = New-Object System.Text.StringBuilder
    $quote = $null
    $has = $false
    for ($i = 0; $i -lt $text.Length; $i++) {
        $c = $text[$i]
        if ($quote) {
            if ($c -eq $quote) { $quote = $null } else { [void]$cur.Append($c) }
            continue
        }
        if ($c -eq "'" -or $c -eq '"') { $quote = $c; $has = $true; continue }
        if ($c -eq '<' -or $c -eq '>') {
            # A file-descriptor number right before a redirection (`2>&1`) belongs to it.
            if ($has -and $cur.ToString() -match '^\d+$') { $has = $false }
            break
        }
        if ($c -eq "`n" -or $c -eq "`r" -or $c -eq ';' -or $c -eq '&' -or $c -eq '|') { break }
        if ([char]::IsWhiteSpace($c)) {
            if ($has) { [void]$tokens.Add($cur.ToString()); [void]$cur.Clear(); $has = $false }
            continue
        }
        [void]$cur.Append($c); $has = $true
    }
    if ($has) { [void]$tokens.Add($cur.ToString()) }
    return ,$tokens
}

# Returns the command with the contents of quoted strings, and of heredoc bodies
# (Bash tool) or here-string bodies (PowerShell tool), replaced by '_' (same length,
# newlines kept), so text inside a commit message can't trigger the checks below
# while positions still line up for Read-Tokens. Returns $null when the quoting is
# ambiguous (escaped quotes, ANSI-C $'...', here-strings in bash, <<<, arithmetic
# shifts, comments, odd heredoc tags, a quote or body left open): the caller then
# scans the raw command, which can only block more, never less.
function Mask-Quoted([string]$text, [string]$tool) {
    if ($text -match '\\[''"]|\$''|<<<|\$\(\(|#|`[''"]') { return $null }
    $chars = $text.ToCharArray()
    $lines = [regex]::Split($text, '(?<=\n)')
    $pos = 0; $endTag = $null; $hereEnd = $null
    foreach ($line in $lines) {
        $bare = $line.TrimEnd("`r", "`n")
        if ($endTag) {
            if ($bare.Trim() -eq $endTag) { $endTag = $null } else { for ($k = 0; $k -lt $bare.Length; $k++) { $chars[$pos + $k] = '_' } }
        } elseif ($hereEnd) {
            if ($bare.StartsWith($hereEnd)) { $hereEnd = $null } else { for ($k = 0; $k -lt $bare.Length; $k++) { $chars[$pos + $k] = '_' } }
        } elseif ($tool -ne 'PowerShell' -and $bare.Contains('<<')) {
            $hd = [regex]::Matches($bare, '<<-?\s*([''"]?)([A-Za-z_][A-Za-z0-9_]*)\1')
            # Exactly one well-formed heredoc per line, and no other '<<' on it.
            if ($hd.Count -ne 1 -or ([regex]::Matches($bare, '<<')).Count -ne 1) { return $null }
            $endTag = $hd[0].Groups[2].Value
        } elseif ($tool -eq 'PowerShell' -and $bare -match '@([''"])\s*$') {
            $hereEnd = $Matches[1] + '@'
        }
        $pos += $line.Length
    }
    if ($endTag -or $hereEnd) { return $null }
    $quote = $null
    for ($i = 0; $i -lt $chars.Length; $i++) {
        $c = $chars[$i]
        if ($quote) { if ($c -eq $quote) { $quote = $null } elseif ($c -ne "`n") { $chars[$i] = '_' }; continue }
        if ($c -eq "'" -or $c -eq '"') { $quote = $c }
    }
    if ($quote) { return $null }
    return -join $chars
}

# Checks a git commit's own options (tokens after the subcommand at index $i).
# Blocks forms that stage files at commit time, after this hook has looked at the
# index, and -n, which skips the git pre-commit layer. Returns $true for --amend.
function Test-CommitOptions($tokens, [int]$i) {
    $isAmend = $false
    $valueShort = 'mFCct'
    $valueLong = '^--(message|file|reuse-message|reedit-message|template|author|date|cleanup|fixup|squash|trailer)$'
    $stageLong = '^--(all|include|only|patch|interactive|pathspec-from-file)(=|$)'
    $j = $i + 1
    while ($j -lt $tokens.Count) {
        $t = $tokens[$j]
        if ($t -eq '--') {
            if (($j + 1) -lt $tokens.Count) { Fail-Config "git commit with paths stages them after this check; git add the files first, then commit without paths" }
            break
        }
        if ($t -match '^--amend$') { $isAmend = $true; $j++; continue }
        if ($t -match $stageLong) { Fail-Config "git commit $t stages files after this check; git add the files first, then commit without $t" }
        if ($t -match $valueLong) { $j += 2; continue }
        if ($t.StartsWith('--')) { $j++; continue }
        if ($t.StartsWith('-') -and $t.Length -gt 1) {
            $skipNext = $false
            for ($k = 1; $k -lt $t.Length; $k++) {
                $ch = $t[$k]
                if ('aiop'.Contains($ch)) { Fail-Config "git commit -$ch stages files after this check; git add the files first, then commit without -$ch" }
                if ($ch -ceq 'n') { Fail-Config "git commit -n skips the git pre-commit gate; run it without -n" }
                # -u<mode> and -S<keyid> take an optional value attached to the same token.
                if ('uS'.Contains($ch)) { break }
                if ($valueShort.Contains($ch)) { if ($k -eq $t.Length - 1) { $skipNext = $true }; break }
            }
            $j += $(if ($skipNext) { 2 } else { 1 })
            continue
        }
        Fail-Config "git commit with a path ('$t') stages it after this check; git add the files first, then commit without paths"
    }
    return $isAmend
}

$amend = $false
switch ($Mode) {
    'pretooluse' {
        try { $payload = [Console]::In.ReadToEnd() | ConvertFrom-Json } catch { Fail-Open "could not parse hook input" }
        $cmd = $payload.tool_input.command
        if (-not $cmd) { exit 0 }
        # Join bash backslash-newline and PowerShell backtick-newline continuations.
        $cmd = $cmd -replace '\\\r?\n', ' ' -replace '`\r?\n', ' '
        # Anchored on the subcommand: git, then only global options, then commit or push.
        $trigger = '(?i)\bgit(\.exe)?((\s+(-C|-c)\s+\S+)|(\s+--[\w-]+(=\S+)?))*\s+(commit|push)\b'
        $masked = Mask-Quoted $cmd ([string]$payload.tool_name)
        if ($null -eq $masked) { $masked = $cmd }
        # Anything that turns off the git pre-commit layer, or defines an alias that
        # could hide a commit from the trigger below, is checked on every git command
        # first: `git -c alias.ci=commit ci --no-verify` never matches the trigger.
        # Unquoted markers are found in the masked text; quoted ones (-c "core.hooksPath=")
        # in each git invocation's own tokens.
        $skipMarker = '(?i)--no-veri|hookspath|\bGIT_CONFIG_(COUNT|PARAMETERS|KEY_|VALUE_)|\balias\.'
        $gitAt = [regex]::Matches($masked, '(?i)\bgit(\.exe)?\b')
        $skip = $false
        # Also with quote and escape characters removed, so `gi""t` or `g\it` still reads as git.
        $dequoted = $cmd -replace '[''"`\\]', ''
        if (($cmd -match '(?i)\bgit' -or $dequoted -match '(?i)\bgit') -and ($cmd -match $skipMarker -or $dequoted -match $skipMarker)) { $skip = $true }
        foreach ($g in $gitAt) {
            foreach ($t in (Read-Tokens $cmd.Substring($g.Index))) {
                if ($t -match '(?i)^--no-veri|^(-c)?core\.hookspath|^(-c)?alias\.') { $skip = $true }
            }
        }
        if ($skip) {
            Fail-Config "a git command with --no-verify, core.hooksPath, GIT_CONFIG_* or an alias.* definition would skip or hide from the security gate; run it without them"
        }
        # Plumbing that writes commits without running any hook, and edits to the
        # hook or git config files, would take the pre-commit layer out of the loop.
        if ($dequoted -match '(?i)\b(commit-tree|update-ref)\b') {
            Fail-Config "git commit-tree / update-ref write commits without the pre-commit gate; use git commit"
        }
        # Marking a hook executable for git (`git add|update-index --chmod=+x`) makes it
        # run on other clones, so that one form is allowed; `-x` or a plain chmod is not.
        $tamperText = $dequoted -replace '(?i)\bgit\s+(add|update-index)\s+--chmod=\+x\b', ''
        if ($tamperText -match '(?i)\.git[\\/](config|hooks)|\.githooks[\\/]' -and
            $tamperText -match '(?i)\b(sed|mv|rm|cp|tee|chmod|ln|truncate)\b|>|Set-Content|Add-Content|Out-File|Remove-Item|Move-Item|Rename-Item|Copy-Item|Clear-Content') {
            Fail-Config "changing .git/config, .git/hooks or .githooks/ from a command would disable the git pre-commit gate; edit hook files with the editor tools, then commit them through the gate"
        }

        # Every git invocation anywhere in the command (raw and quote-stripped, so
        # `git "commit"`, `bash -c "git commit ..."` and `gi""t` are all seen): read the
        # subcommand from its tokens. A subcommand that can't be known statically
        # (`$c`, `$(...)`, backticks, escapes) is blocked; a commit gets its option checks.
        # Options are checked on the raw text, where quotes still group words; the
        # quote-stripped pass only counts invocations, and finding more there than in
        # the raw text means git itself was spelled to hide (`gi""t commit`).
        $sawCommitOrPush = $false
        $counts = @{}
        foreach ($text in @($cmd, $dequoted)) {
            $counts[$text -ceq $cmd] = 0
            foreach ($g in [regex]::Matches($text, '(?i)\bgit(\.exe)?\b')) {
                $tk = Read-Tokens $text.Substring($g.Index)
                if ($tk.Count -lt 2 -or $tk[0] -notmatch '^(?i)git(\.exe)?$') { continue }
                $i = 1
                while ($i -lt $tk.Count) {
                    # git -c key=value (or attached -ckey=value): a key or value built at run
                    # time, or a key that can change hooks, includes or aliases, can switch
                    # the git-side gate off for this one command.
                    $cfg = $null
                    if ($tk[$i] -ceq '-c' -and ($i + 1) -lt $tk.Count) { $cfg = $tk[$i + 1] }
                    elseif ($tk[$i].StartsWith('-c') -and -not $tk[$i].StartsWith('-c-') -and $tk[$i] -cne '-c' -and $tk[$i] -cne '-C') { $cfg = $tk[$i].Substring(2) }
                    if ($null -ne $cfg) {
                        if ($cfg -match '[\$`{}()\\]|^@') { Fail-Config "git -c '$cfg' is built at run time, so this check can't read it; write the setting out" }
                        if ($cfg -match '(?i)^(core\.(?!quotepath=)|include|alias\.)') { Fail-Config "git -c '$cfg' can change hooks, includes or aliases for this command; run it without that setting" }
                        $i += $(if ($tk[$i] -ceq '-c') { 2 } else { 1 }); continue
                    }
                    if ($tk[$i] -ceq '-C') { $i += 2; continue }
                    # Global options that take their value as the next word.
                    if ($tk[$i] -match '^--(namespace|git-dir|work-tree|exec-path|super-prefix|config-env|attr-source|list-cmds)$') { $i += 2; continue }
                    if ($tk[$i].StartsWith('-')) { $i++; continue }
                    break
                }
                if ($i -ge $tk.Count) { continue }
                $sub = $tk[$i]
                if ($sub -match '[\$`\\({]') {
                    Fail-Config "git subcommand '$sub' can't be determined before it runs, so it could be an unchecked commit; spell the subcommand out"
                }
                # git config edits that drop or rewrite whole sections (core holds hooksPath),
                # or open the file for free-form editing, can switch the git-side gate off.
                if ($sub -ieq 'config') {
                    foreach ($t in $tk[($i + 1)..($tk.Count - 1)]) {
                        if ($t -match '^(?i)--(remove-section|rename-section|edit|file|blob|global|system)$|^-(e|f)$') {
                            Fail-Config "git config $t can remove or rewrite the hooks setting; change git config by hand outside the agent"
                        }
                    }
                }
                if ($sub -ieq 'commit' -or $sub -ieq 'push') {
                    $sawCommitOrPush = $true
                    $counts[$text -ceq $cmd]++
                    if ($sub -ieq 'commit' -and ($text -ceq $cmd)) {
                        if (Test-CommitOptions $tk $i) { $amend = $true }
                    }
                }
            }
        }
        # A command word that is a variable or substitution followed by commit/push
        # (`$G commit`, `${G} push`, `$(which git) commit`) can't be read statically.
        if ($dequoted -match '(?i)(^|[;&|(\s])(\$\{?[A-Za-z_]\w*\}?|\$\([^)]*\)|`[^`]*`)\s+(commit|push)\b') {
            Fail-Config "a variable or command substitution runs commit/push here, so this check can't read it; call git directly"
        }
        if ($dequoted -cne $cmd -and $counts[$false] -gt $counts[$true]) {
            Fail-Config "git is spelled with quotes or escapes around a commit or push, which hides its options from this check; write it plainly"
        }

        $hits = [regex]::Matches($masked, $trigger)
        if ($hits.Count -eq 0 -and -not $sawCommitOrPush) { exit 0 }
        if ($masked -match '(?i)\bGIT_(INDEX_FILE|DIR|WORK_TREE|COMMON_DIR|OBJECT_DIRECTORY)\s*=' -or
            $masked -match '(?i)\$env:GIT_(INDEX_FILE|DIR|WORK_TREE|COMMON_DIR|OBJECT_DIRECTORY)\b' -or
            $masked -match '(?i)\s--(git-dir|work-tree)\b') {
            Fail-Config "git commit/push with GIT_INDEX_FILE, GIT_DIR, GIT_WORK_TREE, --git-dir or --work-tree can't be checked; run it without the override"
        }

        # Relative -C resolves from where the command runs (the hook's cwd field), not the project root.
        $startDir = if ($payload.cwd) { $payload.cwd } elseif ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }
        $repoDir = $startDir
        foreach ($m in $hits) {
            $tokens = Read-Tokens $cmd.Substring($m.Index)
            $dir = $startDir
            $i = 1
            while ($i -lt $tokens.Count -and $tokens[$i] -notmatch '^(commit|push)$') {
                # -ceq: git's -C (directory) and -c (config) differ only by case.
                if ($tokens[$i] -ceq '-C' -and ($i + 1) -lt $tokens.Count) {
                    $target = $tokens[$i + 1]
                    if (-not [System.IO.Path]::IsPathRooted($target)) { $target = Join-Path $dir $target }
                    $dir = $target
                    $i += 2; continue
                }
                if ($tokens[$i] -ceq '-c') { $i += 2; continue }
                $i++
            }
            $repoDir = $dir
            $sub = if ($i -lt $tokens.Count) { $tokens[$i] } else { '' }
            if ($sub -ne 'commit') { continue }

            if (Test-CommitOptions $tokens $i) { $amend = $true }
        }
        $Mode = 'pretooluse'
        Set-Location -LiteralPath $repoDir -ErrorAction SilentlyContinue
        if (-not $?) { Fail-Config "git -C target '$repoDir' does not exist" }
        $actualTop = (Git-Quiet "rev-parse --show-toplevel").Text
        # A matched commit outside any repository can't be checked: block rather than fail open.
        if (-not $actualTop) { Fail-Config "git commit/push target '$repoDir' is not inside a git repository this gate can check" }
        $expectedTop = if ($env:CLAUDE_PROJECT_DIR) { (Git-Quiet "-C `"$env:CLAUDE_PROJECT_DIR`" rev-parse --show-toplevel").Text } else { $null }
        if ($expectedTop -and ($expectedTop -ne $actualTop)) {
            Fail-Config "git -C points outside this project ($actualTop); commit from the project repository"
        }
    }
    'pre-commit' { }
    'range' { if (-not $Base -or -not $Head) { Fail-Config "range mode needs <base> <head>" } }
    default { Fail-Config "unknown mode '$Mode'" }
}

$topR = Git-Quiet "rev-parse --show-toplevel"
$top = $topR.Text
if (-not $topR.Ok -or -not $top) {
    # In pre-commit and range mode git itself is running us inside a repository, so
    # failing to find it means something is wrong: block rather than wave it through.
    if ($Mode -eq 'pretooluse') { Fail-Open "not inside a git repository" }
    Fail-Config "git rev-parse failed in $Mode mode, so the change can't be checked"
}
Set-Location $top

# What the change is compared against. --amend replaces HEAD, so its parent is the base.
if ($Mode -eq 'range') {
    $baseRef = $Base
} elseif ($amend) {
    $baseRef = if ((Git-Quiet "rev-parse --verify --quiet HEAD~1").Ok) { 'HEAD~1' } else { $emptyTree }
} else {
    $baseRef = if ((Git-Quiet "rev-parse --verify --quiet HEAD").Ok) { 'HEAD' } else { $emptyTree }
}

# Changed files, the list before and after, tracked files, and the ledger.
# --no-renames lists a move as delete + add, so the source path is classified too.
if ($Mode -eq 'range') {
    $changedR = Git-Lines "diff --name-only --no-renames $Base...$Head"
    $afterR = Git-Lines "show ${Head}:$pathsFile"
    $trackedR = Git-Lines "ls-tree -r --name-only $Head"
    $ledgerDiffArgs = "diff -U0 $Base...$Head -- `"$ledgerPath`""
    $ledgerBeforeArgs = "show ${Base}:$ledgerPath"
    $ledgerAfterArgs = "show ${Head}:$ledgerPath"
    $where = "at $Head"
} else {
    $changedR = Git-Lines "diff --cached --name-only --no-renames $baseRef"
    $afterR = Git-Lines "show :$pathsFile"
    $trackedR = Git-Lines "ls-files"
    $ledgerDiffArgs = "diff --cached -U0 $baseRef -- `"$ledgerPath`""
    $ledgerBeforeArgs = "show ${baseRef}:$ledgerPath"
    $ledgerAfterArgs = "show :$ledgerPath"
    $where = "in the index"
}
$beforeR = Git-Lines "show ${baseRef}:$pathsFile"
if (-not $changedR.Ok) { Fail-Config "git diff failed, so changed files can't be checked" }
$changed = @($changedR.Lines | Where-Object { $_ })
if (-not $changed) { Pass-Checked 0 }
if (-not $afterR.Ok) { Fail-Config "$pathsFile is missing $where, so no file can be classified as security-sensitive" }
if (-not $trackedR.Ok) { Fail-Config "listing tracked files failed, so the path list can't be checked" }

function Parse-List($lines) {
    $required = @(); $optional = @(); $tests = @()
    foreach ($line in $lines) {
        $line = "$line".Trim()
        if (-not $line -or $line.StartsWith('#')) { continue }
        # '!' marks a required path that stays sensitive even though it is a test file
        # (a test that is itself a security control, such as the RLS suite).
        if ($line.StartsWith('!')) { $tests += $line.Substring(1); $required += $line.Substring(1); continue }
        if ($line.StartsWith('?')) { $optional += $line.Substring(1) } else { $required += $line }
    }
    return @{ Required = $required; Optional = $optional; Tests = $tests }
}
function Try-Compile([string]$pattern) {
    try {
        return [System.Text.RegularExpressions.Regex]::new($pattern,
            [System.Text.RegularExpressions.RegexOptions]::IgnoreCase, [TimeSpan]::FromSeconds(1))
    } catch { return $null }
}
function Matches-Any([string]$path, $regexes) {
    foreach ($re in $regexes) {
        try { if ($re.IsMatch($path)) { return $true } } catch { Fail-Config "pattern '$re' timed out on '$path'" }
    }
    return $false
}

$after = Parse-List $afterR.Lines
$before = if ($beforeR.Ok) { Parse-List $beforeR.Lines } else { @{ Required = @(); Optional = @(); Tests = @() } }
if (-not ($after.Required + $after.Optional)) { Fail-Config "$pathsFile has no patterns" }

# Each line compiled on its own. A bad line in the new list blocks; a bad line
# that is only in the old list is skipped with a warning (it never matched
# anything), so the commit that fixes it isn't blocked by it.
$compiled = New-Object System.Collections.ArrayList
[void]$compiled.Add((Try-Compile $selfPattern))
foreach ($p in @($after.Required + $after.Optional | Select-Object -Unique)) {
    $re = Try-Compile $p
    if (-not $re) { Fail-Config "invalid pattern in ${pathsFile}: '$p'" }
    [void]$compiled.Add($re)
}
foreach ($p in @($before.Required + $before.Optional | Select-Object -Unique)) {
    if (($after.Required + $after.Optional) -contains $p) { continue }
    $re = Try-Compile $p
    if ($re) { [void]$compiled.Add($re) } else { Write-Output "security-gate: ignoring invalid pattern '$p' from the previous $pathsFile" }
}

# Liveness: every required pattern must still match a tracked file. A pattern
# that matches nothing means files moved or were deleted without the list moving
# with them, which would leave them ungated. Keep one path per line so a dead
# alternative inside a grouped pattern can't hide behind a live one.
$dead = @()
foreach ($p in $after.Required) {
    $re = Try-Compile $p
    $hit = $false
    foreach ($f in $trackedR.Lines) {
        try { if ($re.IsMatch($f)) { $hit = $true; break } } catch { Fail-Config "pattern '$p' timed out on '$f'" }
    }
    if (-not $hit) { $dead += $p }
}
if ($dead) {
    [Console]::Error.WriteLine("Security gate blocked this change: these patterns in $pathsFile match no tracked file: $($dead -join ', ')")
    [Console]::Error.WriteLine("Files they covered were moved or deleted. Point the patterns at the new paths (or prefix a planned path with '?'), then retry.")
    exit 2
}

$testControls = @(@($after.Tests + $before.Tests) | Select-Object -Unique | ForEach-Object { Try-Compile $_ } | Where-Object { $_ })
$sensitive = @($changed | Where-Object { (Matches-Any $_ $compiled) -and ($_ -notmatch $testPattern -or (Matches-Any $_ $testControls)) })
if (-not $sensitive) { Pass-Checked $changed.Count }

if (-not ($changed -contains $ledgerPath)) {
    Fail-Gate "security-sensitive files changed ($($sensitive -join ', ')) but $ledgerPath has no new entry in this change"
}

# The ledger is append-only: the old content must be an exact prefix of the new.
$ledgerBefore = Git-Lines $ledgerBeforeArgs
$ledgerAfter = Git-Lines $ledgerAfterArgs
if (-not $ledgerAfter.Ok) { Fail-Config "$ledgerPath can't be read $where" }
if ($ledgerBefore.Ok) {
    $old = @($ledgerBefore.Lines | ForEach-Object { "$_".TrimEnd("`r") })
    $new = @($ledgerAfter.Lines | ForEach-Object { "$_".TrimEnd("`r") })
    $prefixOk = $new.Count -ge $old.Count
    for ($n = 0; $prefixOk -and $n -lt $old.Count; $n++) { if ($old[$n] -cne $new[$n]) { $prefixOk = $false } }
    if (-not $prefixOk) { Fail-Config "$ledgerPath is append-only; this change edits or removes existing lines" }
}

# Only lines this change appends count, matched case-sensitively on path
# boundaries, so `a/b.ts` doesn't satisfy `a/b.tsx` or `xa/b.ts`.
$ledgerR = Git-Lines $ledgerDiffArgs
if (-not $ledgerR.Ok) { Fail-Config "git diff of $ledgerPath failed" }
$added = (@($ledgerR.Lines) | Where-Object { $_.StartsWith('+') -and -not $_.StartsWith('+++') } |
    ForEach-Object { $_.Substring(1) }) -join "`n"
$missing = @($sensitive | Where-Object { $added -cnotmatch ('(?<![\w./-])' + [regex]::Escape($_) + '(?![\w/-]|\.[\w./-])') })
if ($missing) {
    Fail-Gate "these security-sensitive files aren't named in the lines this change adds to ${ledgerPath}: $($missing -join ', ')"
}

Pass-Checked $changed.Count
