#!/usr/bin/env bash
# {{PROJECT_NAME}} auto-continue — runs ONE headless phase via orchestrator.mjs, then exits.
# Runs locally (not a cloud routine) so it can verify against {{LOCAL_VERIFY_DEPS}}
# that a cloud routine has no access to.
#
# All the safety logic (overlap guard, resume-anchor read, self-verification,
# one-phase-per-firing) lives in orchestrator.mjs itself now — real code, not
# an LLM prompt asking a headless session to remember to check git status
# first. This script is just the cron wrapper; it doesn't know or care which
# provider CLI orchestrator.mjs picks for the queued item, so it never needs
# editing when the roster's mix of providers changes.
#
# ENABLE (cron, every {{INTERVAL_HOURS}}h):
#   crontab -e
#   0 */{{INTERVAL_HOURS}} * * * {{HOOK_SCRIPT_PATH}} >> {{LOG_PATH}} 2>&1
# DISABLE: remove the crontab line above.
# TEST IT NOW (foreground, no cron): just run this script directly.

set -euo pipefail
cd "{{PROJECT_PATH}}"

node .agent-team/orchestrator.mjs run-phase
