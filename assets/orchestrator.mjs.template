#!/usr/bin/env node
// Provider-agnostic orchestrator. Copied into the target project as-is —
// all per-project variation lives in roster.json and providers.json, not
// in this file. Node builtins only, no install step.
//
// This script exists because harness-native hooks (Claude Code's
// SubagentStop/PreToolUse, Codex's hooks.json, Gemini CLI's hooks) are
// three incompatible mechanisms with no shared standard — but every CLI
// coding agent shares one thing: headless single-prompt execution that
// exits with a checkable status. Self-verification gating, security
// gating, and scheduled continuation are all implemented HERE, once,
// wrapping that universal contract — not as a harness-specific hook.
// See REFERENCE.md#provider-agnostic-orchestration for the reasoning.
//
// State lives under .agent-team/ (sibling to .claude/, not inside it —
// this script has no dependency on Claude Code being the active harness):
//   .agent-team/roster.json                    - agents: ownership, provider, self-verification, routing
//   .agent-team/providers.json                 - provider adapters: how to invoke each CLI headlessly
//   .agent-team/STATUS.md                      - resume anchor: queue + status log + blocked list
//   .agent-team/tentacles/<agent>/CONTEXT.md   - that agent's durable context (mirrors agent.md's body)
//   .agent-team/tentacles/<agent>/todo.md      - that agent's task queue, checkbox items
//   .agent-team/worktrees/<id>/                - git worktree isolation for a phase, when enabled
//   .agent-team/integrity.json                 - signed hashes of protected files (seal / integrity)
//   .agent-team/events.jsonl                   - append-only run record: dispatches, attempts, verdicts, merges
//   .agent-team/STOP                           - kill-switch file; present = no dispatch runs
//   .claude/contracts/security-audit-log.md    - shared with the Claude-Code-native path, if it exists
//
// Commands:
//   node orchestrator.mjs run-phase              - one bounded phase, then stop (invoke this manually
//                                                   or from whatever external trigger you set up yourself —
//                                                   this script has no built-in scheduling of its own)
//   node orchestrator.mjs spawn <agent> "<task>" [--worktree]  - one ad hoc dispatch, foreground
//   node orchestrator.mjs ask <provider> [--model <id>]  - prompt on stdin, ONE text-only answer on stdout
//                                                   from that provider using its read-only adviceArgs
//                                                   (the llm-council skill's non-Claude members)
//   node orchestrator.mjs seal | integrity       - record / verify a signed hash of the gate config, hooks, agent
//                                                   files and playbooks (seal needs a person at a TTY)
//   node orchestrator.mjs stop | resume          - kill switch: halt running workers, block new dispatches
//   node orchestrator.mjs lint                   - mechanical checks on the generated setup (sizes, placeholders, allowlist)
//   node orchestrator.mjs stamp write|check|show - remember that a check passed for THIS exact tree, so the next role reuses it
//   node orchestrator.mjs tier "<task>"         - which model tier should this task START on? (light only for clearly mechanical work)
//   node orchestrator.mjs plan [--json]         - group open queue items into batches that can run in parallel worktrees
//   node orchestrator.mjs risk [base [head]]    - classify a diff as mechanical / import-only / logic: how deep must the security audit go?
//   node orchestrator.mjs usage [--days N]      - per-agent runs, tokens, model mix, playbook uptake, flags (from Claude Code transcripts)
//   node orchestrator.mjs log [n]                - last n lines of .agent-team/events.jsonl (the run record)
//   node orchestrator.mjs status                 - print queue/status summary, no side effects
//   node orchestrator.mjs quota                  - print each configured provider's real quota
//                                                   reading (or why it couldn't get one), no side effects

import { execFile, spawn, spawnSync } from "node:child_process";
import { promisify } from "node:util";
import https from "node:https";
import fs from "node:fs";
import path from "node:path";
import os from "node:os";
import crypto from "node:crypto";

const execFileP = promisify(execFile);
const ROOT = process.argv[2] === "hook" && process.env.CLAUDE_PROJECT_DIR ? path.resolve(process.env.CLAUDE_PROJECT_DIR) : process.cwd();
const TEAM_DIR = path.join(ROOT, ".agent-team");
const ROSTER_PATH = path.join(TEAM_DIR, "roster.json");
const PROVIDERS_PATH = path.join(TEAM_DIR, "providers.json");
const STATUS_PATH = path.join(TEAM_DIR, "STATUS.md");

const SELF_VERIFY_ATTEMPT_BUDGET = 3;
const PHASE_TIMEOUT_MS = 30 * 60 * 1000; // 30 min wall-clock cap per dispatch — the orchestrator
// owns the subprocess, so unlike a harness hook (which only fires on completion) it can actually
// kill a hung or looping worker instead of leaving it unrescuable. Tune per project.

// Staged quota thresholds — checked BEFORE a dispatch starts, not after. Below
// QUOTA_SOFT_THRESHOLD, dispatch freely. From SOFT to HARD is the "emergency"
// band: a new dispatch is still allowed to start (each dispatch is one atomic
// subprocess call — there's no way to let it use "2% more" mid-generation and
// then interrupt it), but it's logged so it's visible that headroom is thin.
// At or above QUOTA_HARD_THRESHOLD, no new token-consuming dispatch starts at
// all — the item is deferred until the window resets. This only ever gates
// invokeProvider; runSelfVerification, git operations, and everything else
// non-token-consuming is untouched at every tier, always.
const QUOTA_SOFT_THRESHOLD = 96;
const QUOTA_HARD_THRESHOLD = 98;

function readJson(p) {
  return JSON.parse(fs.readFileSync(p, "utf8"));
}

function trimOutput(text, maxLines = 60) {
  const lines = text.split(/\r?\n/);
  if (lines.length <= maxLines) return text;
  return `… (${lines.length - maxLines} earlier lines trimmed) …\n` + lines.slice(-maxLines).join("\n");
}

function isTreeClean() {
  const { status, stdout } = spawnSync("git", ["status", "--porcelain"], { cwd: ROOT });
  if (status !== 0) return { clean: false, reason: "git status failed" };
  return { clean: stdout.toString().trim() === "", reason: null };
}

function readStatusFile() {
  if (!fs.existsSync(STATUS_PATH)) {
    throw new Error(`${STATUS_PATH} not found — run the scaffold's Step (roster) generation first`);
  }
  return fs.readFileSync(STATUS_PATH, "utf8");
}

function writeStatusFile(content) {
  fs.writeFileSync(STATUS_PATH, content);
}

// Parses "- [ ] text" / "- [x] text" lines the same way Octogent's todo.md
// parser does — proven convention, not reinvented here. Each queue line may
// tag an explicit owner: "- [ ] [backend-agent] add refund endpoint".
//
// A blocked item stays "- [ ]" (markItemBlocked only appends an HTML
// comment, it never flips the checkbox — flipping it to [x] would make a
// failed dispatch look done) — so blocked-ness has to be tracked as its own
// flag, not inferred from the checkbox. Without this, nextQueueItem would
// hand the exact same blocked item back on every subsequent run-phase
// firing forever, burning the self-verification attempt budget again each
// time instead of waiting for a human to clear it, exactly the "Blocked"
// section's own contract in STATUS.md.
function parseQueue(statusContent) {
  const items = [];
  const lines = statusContent.split(/\r?\n/);
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(/^- \[( |x)\] (?:\[([a-z0-9-]+)\] )?(?:\[tier:(light|default|high)\] )?(.+)$/i);
    if (m) {
      const blockedMatch = m[4].match(/^(.*?)\s*<!--\s*BLOCKED:.*-->\s*$/);
      const effortTag = (blockedMatch ? blockedMatch[1] : m[4]).match(/\[effort:(low|medium|high|xhigh)\]\s*/i);
      items.push({
        lineIndex: i,
        done: m[1].toLowerCase() === "x",
        blocked: Boolean(blockedMatch),
        agent: m[2] || null,
        // Optional per-task tier: a risky or cross-cutting item can ask for more
        // than its agent's usual tier, a mechanical one for less.
        tier: m[3] ? m[3].toLowerCase() : null,
        // Optional per-task effort ([effort:low|medium|high|xhigh]): how hard the model thinks, on the same model.
        effort: effortTag ? effortTag[1].toLowerCase() : null,
        text: (blockedMatch ? blockedMatch[1] : m[4]).replace(/\[effort:(low|medium|high|xhigh)\]\s*/i, ""),
      });
    }
  }
  return items;
}

function nextQueueItem(items) {
  return items.find((i) => !i.done && !i.blocked) || null;
}

function markItemDone(statusContent, lineIndex) {
  const lines = statusContent.split(/\r?\n/);
  lines[lineIndex] = lines[lineIndex].replace("[ ]", "[x]");
  return lines.join("\n");
}

function markItemBlocked(statusContent, lineIndex, reason) {
  const lines = statusContent.split(/\r?\n/);
  lines[lineIndex] = lines[lineIndex] + `  <!-- BLOCKED: ${reason.replace(/\n/g, " ")} -->`;
  return lines.join("\n");
}

function resolveAgent(roster, item) {
  if (item.agent) {
    const a = roster.agents.find((a) => a.name === item.agent);
    if (!a) throw new Error(`queue item tags unknown agent "${item.agent}"`);
    return a;
  }
  // Fall back to routing keyword match against each agent's `routing` list. Hyphens/underscores and
  // spaces are treated alike ("schema-drift" matches "schema drift"). If MORE THAN ONE agent
  // matches, refuse to guess: silently taking the first in roster order sent "audit the new endpoints"
  // to the backend agent instead of security when tested against a real 8-agent roster.
  const norm = (t) => t.toLowerCase().replace(/[-_]+/g, " ");
  const text = norm(item.text);
  const matches = roster.agents.filter((a) => !a.dormant && (a.routing || []).some((r) => text.includes(norm(r))));
  if (!matches.length) throw new Error(`no agent matches queue item and it has no [agent-name] tag: "${item.text}"`);
  if (matches.length > 1) throw new Error(`ambiguous routing — ${matches.map((m) => m.name).join(", ")} all match; tag the queue item with [agent-name]: "${item.text}"`);
  return matches[0];
}

function buildPrompt(agent, taskText, priorFailure, roster = {}) {
  const contextPath = path.join(TEAM_DIR, "tentacles", agent.name, "CONTEXT.md");
  const context = fs.existsSync(contextPath) ? fs.readFileSync(contextPath, "utf8") : "";
  // The playbook (process layer + Definition of done) is appended inline rather than just referenced:
  // a headless worker that is told "read PLAYBOOK.md" can skip it, one that is handed it cannot.
  // AGENT_TEAM_NO_PLAYBOOK=1 omits it so an eval can measure the same task with and without it —
  // context files that restate what the code shows have been measured to NOT help (arXiv 2602.11988).
  const playbookPath = path.join(TEAM_DIR, "tentacles", agent.name, "PLAYBOOK.md");
  const playbook = process.env.AGENT_TEAM_NO_PLAYBOOK !== "1" && fs.existsSync(playbookPath) ? fs.readFileSync(playbookPath, "utf8") : "";
  // Long-running work: a fresh session knows nothing, so it re-orients from files instead of
  // declaring victory on partial progress (Anthropic, "Effective harnesses for long-running agents").
  const startup = roster.featureList
    ? `\n## Startup routine\nBefore changing anything: read the git log, ${roster.progressFile || "the progress notes"}, and ${roster.featureList}. Pick the single highest-priority feature whose "passes" is false and work on only that one. ${roster.initScript ? `Run ${roster.initScript} and a basic end-to-end check first, so a broken starting state is fixed before new work. ` : ""}Set "passes" to true only after the feature's steps verifiably work; you may not add, remove or otherwise edit feature entries or tests. Commit with a descriptive message and update the progress notes before finishing.`
    : "";
  const parts = [
    context,
    playbook ? `\n## Playbook\n${playbook}` : "",
    startup,
    `\n## Task\n${taskText}`,
    `\n## Completion criterion\nThe task is done when the change is made AND this command passes: \`${agent.selfVerification}\`. Run it yourself before finishing; the orchestrator re-checks it independently regardless.${playbook ? " Also run every check in the playbook's Definition of done and end your output with one PASS|FAIL line per check (with the evidence you observed) and an UNVERIFIED list." : ""} Never delete, skip or weaken a test to make a check pass, and do not edit .agent-team/, .claude/hooks/, .claude/agents/ or any PLAYBOOK.md — the orchestrator detects both and rejects the work.`,
    // This instruction exists because a headless worker is a full CLI session with real shell
    // access — unlike a Claude Code subagent, nothing structurally stops it from spawning another
    // agent process. See REFERENCE.md's headless-worker gotcha for why this can't be left implicit.
    `\n## Hard constraint\nDo not invoke this orchestrator, any other agent CLI, or any provider binary from within this session — no recursive dispatch, no spawning child agent processes, no shelling out to "claude", "codex", "gemini", or similar. Do the task's own file edits directly. If the task genuinely needs another agent's work, stop and report "NEEDS <agent-name>: <what's needed>" as your final output instead of trying to invoke it yourself.`,
  ];
  if (priorFailure) {
    parts.push(`\n## Previous attempt failed\n${trimOutput(priorFailure)}\nFix this and rerun the check yourself before finishing.`);
  }
  return parts.join("\n");
}

// The prompt travels over stdin, never as a CLI argument. Verified by real
// dispatch during this scaffold's own pilot: a multi-line prompt containing
// quotes/backticks, substituted into an argv string and run through
// `shell: true` (needed on Windows just to resolve an npm .cmd shim like
// claude.cmd), gets silently truncated/mangled by cmd.exe's own re-parsing
// — a much worse failure than the ENOENT it was fixing, because it's silent.
// Every provider checked documents stdin input for exactly this reason
// (`claude -p` — "useful for pipes"; `codex exec` — "read from stdin" when
// no PROMPT argument is given), so `providers.json`'s `args` carry only
// fixed flags, never a `{prompt}` placeholder — this function writes the
// prompt to the child's stdin directly, which isn't shell-parsed at all.
// Model tier: roster.json gives each agent an optional `tier` (e.g. "high", "default",
// "light"); providers.json maps each tier to that CLI's model id and names the CLI's
// model flag (`--model` for claude, `-m` for codex exec and gemini). No tier, or no
// mapping for it, means the CLI's own default model, the same as before tiers existed.
// The command runs through a shell (shell: true), so a model id is restricted to plain id characters.
const MODEL_ID_RE = /^[A-Za-z0-9._:\/-]+$/;
const EFFORT_LADDER = ["low", "medium", "high", "xhigh"]; // "max" is allowed when asked for, but never escalated to
const EFFORT_RE = /^(low|medium|high|xhigh|max)$/;
function providerArgs(p, tier, effort) {
  const args = [...p.args];
  const model = tier && p.tiers ? p.tiers[tier] : undefined;
  if (model && p.modelFlag) {
    if (!MODEL_ID_RE.test(String(model))) throw new Error(`providers.json: the "${tier}" tier model "${model}" contains characters outside [A-Za-z0-9._:/-]`);
    args.push(p.modelFlag, model);
  }
  // Effort: how much the model thinks, on the same model. Only for a provider that declares an effortFlag (the claude
  // CLI documents `--effort <level>`); changing it costs nothing in prompt cache, unlike changing the model mid-task.
  if (effort && p.effortFlag) {
    if (!EFFORT_RE.test(String(effort))) throw new Error(`effort "${effort}" is not one of low, medium, high, xhigh, max`);
    args.push(p.effortFlag, effort);
  }
  return args;
}

async function invokeProvider(providerName, providers, prompt, cwd, opts = {}) {
  const p = providers[providerName];
  if (!p) throw new Error(`no provider adapter named "${providerName}" in providers.json`);
  const MAX_BUFFER = 20 * 1024 * 1024;
  const args = opts.args || p.args; // `ask` passes the provider's read-only adviceArgs instead
  const timeoutMs = opts.timeoutMs || PHASE_TIMEOUT_MS;
  return new Promise((resolve) => {
    const child = spawn(p.command, args, { cwd, shell: true, detached: process.platform !== "win32" });
    activeChildren.add(child);
    let stdout = "";
    let stderr = "";
    let timedOut = false;

    let stopped = false;
    const timer = setTimeout(() => {
      timedOut = true;
      killTree(child);
    }, timeoutMs);
    // The kill switch: poll for .agent-team/STOP while a worker runs so `stop` takes effect in
    // seconds, not at the next attempt boundary.
    const stopPoll = opts.watchStop
      ? setInterval(() => {
          if (stopRequested()) {
            stopped = true;
            killTree(child);
          }
        }, 2000)
      : null;

    child.stdout.on("data", (d) => {
      if (stdout.length < MAX_BUFFER) stdout += d;
    });
    child.stderr.on("data", (d) => {
      if (stderr.length < MAX_BUFFER) stderr += d;
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      if (stopPoll) clearInterval(stopPoll);
      resolve({ ok: false, output: err.message, timedOut: false });
    });
    child.on("close", (code) => {
      activeChildren.delete(child);
      clearTimeout(timer);
      if (stopPoll) clearInterval(stopPoll);
      if (code === 0 && !timedOut && !stopped) {
        resolve({ ok: true, output: stdout + stderr });
      } else {
        resolve({
          ok: false,
          output: (stdout + stderr) || `exited with code ${code}`,
          timedOut,
          stopped,
        });
      }
    });

    child.stdin.write(prompt);
    child.stdin.end();
  });
}

// A provider usage-limit hit ("Claude AI usage limit reached. Your limit will
// reset at ...") looks like any other abnormal exit to invokeProvider — but
// treating it like one is wrong: dispatchOnce's normal retry loop fires again
// immediately with no delay, so all SELF_VERIFY_ATTEMPT_BUDGET attempts hit
// the same still-active limit within seconds and the item ends up BLOCKED —
// which nextQueueItem then skips forever, so the next scheduled run-phase
// firing (hours later, once the limit has actually reset) never retries it
// either. A human would have to notice and manually unblock the line. This
// check lets dispatchOnce recognize that case and stop immediately without
// spending an attempt or writing a blocked marker, so the item stays queued
// exactly as it was and the NEXT scheduled firing is a clean retry. Each
// provider's own usageLimitPatterns in providers.json drives this — see that
// file's usageLimitNote for why the patterns must be re-verified per CLI.
function isUsageLimitHit(providerName, providers, output) {
  const patterns = (providers[providerName] && providers[providerName].usageLimitPatterns) || [];
  return patterns.some((p) => new RegExp(p, "i").test(output));
}

// --- Proactive quota checks — real percentages, checked BEFORE a dispatch,
// not inferred after a refusal like isUsageLimitHit above. Every checker
// returns { reliable, percent, resetsAt, error } and NEVER throws — a
// checker that can't get a real number returns { reliable: false }, and
// dispatchOnce treats that exactly like having no check at all (fail open,
// same discipline as every other gate in this script). None of these log or
// persist the credentials they read — read once, used once, in memory only.

// Claude Code's own local OAuth token, read from the same credentials file
// the `claude` CLI itself uses — this isn't exfiltrating anything, it's
// calling Anthropic's own usage endpoint with the user's own valid token,
// locally, the same way third-party usage-tracking tools already do.
// Verified live against the real endpoint: returns an integer 0-100
// `utilization` for both the 5-hour session window and the 7-day window,
// plus a `severity` field Anthropic sets itself ("warning" observed at 76%).
// UNDOCUMENTED API — the `anthropic-beta` header is a versioned string that
// could be retired at any time; that's exactly why this fails open instead
// of hard-failing when the shape changes.
function readClaudeCodeToken() {
  const credPath = path.join(os.homedir(), ".claude", ".credentials.json");
  if (!fs.existsSync(credPath)) return null;
  try {
    const creds = JSON.parse(fs.readFileSync(credPath, "utf8"));
    return (creds.claudeAiOauth && creds.claudeAiOauth.accessToken) || null;
  } catch {
    return null;
  }
}

function checkQuotaClaudeCode() {
  return new Promise((resolve) => {
    const token = readClaudeCodeToken();
    if (!token) return resolve({ reliable: false, error: "no local Claude Code credentials found" });
    const req = https.request(
      {
        hostname: "api.anthropic.com",
        path: "/api/oauth/usage",
        method: "GET",
        headers: { Authorization: `Bearer ${token}`, "anthropic-beta": "oauth-2025-04-20" },
        timeout: 10000,
      },
      (res) => {
        let body = "";
        res.on("data", (d) => (body += d));
        res.on("end", () => {
          try {
            const data = JSON.parse(body);
            if (res.statusCode !== 200 || !data.five_hour || typeof data.five_hour.utilization !== "number") {
              return resolve({ reliable: false, error: `unexpected usage-endpoint response (status ${res.statusCode})` });
            }
            resolve({
              reliable: true,
              percent: data.five_hour.utilization,
              resetsAt: data.five_hour.resets_at ? new Date(data.five_hour.resets_at).getTime() : null,
            });
          } catch {
            resolve({ reliable: false, error: "could not parse usage-endpoint response" });
          }
        });
      }
    );
    req.on("error", (e) => resolve({ reliable: false, error: e.message }));
    req.on("timeout", () => {
      req.destroy();
      resolve({ reliable: false, error: "usage-endpoint request timed out" });
    });
    req.end();
  });
}

// Codex's app-server JSON-RPC interface — its own IDE-integration surface,
// not a stable public contract either, but more official-feeling than
// Claude Code's endpoint above. Requires an `initialize` handshake before
// any other method responds (verified live: calling account/rateLimits/read
// first returns a bare "Not initialized" error). Verified live end to end:
// initialize succeeds, then account/rateLimits/read returns an integer
// usedPercent and a unix-seconds resetsAt for the account's primary window.
function checkQuotaCodex() {
  return new Promise((resolve) => {
    let settled = false;
    let child;
    const done = (result) => {
      if (settled) return;
      settled = true;
      try {
        child.kill();
      } catch {
        // already exited — nothing to clean up
      }
      resolve(result);
    };
    try {
      child = spawn("codex", ["app-server"], { shell: true });
    } catch (e) {
      return resolve({ reliable: false, error: e.message });
    }
    let buf = "";
    let initialized = false;
    child.stdout.on("data", (d) => {
      buf += d;
      const lines = buf.split("\n");
      buf = lines.pop();
      for (const line of lines) {
        if (!line.trim()) continue;
        let msg;
        try {
          msg = JSON.parse(line);
        } catch {
          continue;
        }
        if (msg.id === 1 && !initialized) {
          initialized = true;
          child.stdin.write(JSON.stringify({ jsonrpc: "2.0", id: 2, method: "account/rateLimits/read", params: {} }) + "\n");
        } else if (msg.id === 2) {
          const primary = msg.result && msg.result.rateLimits && msg.result.rateLimits.primary;
          if (primary && typeof primary.usedPercent === "number") {
            done({
              reliable: true,
              percent: primary.usedPercent,
              resetsAt: primary.resetsAt ? primary.resetsAt * 1000 : null,
            });
          } else {
            done({ reliable: false, error: "unexpected rateLimits response shape" });
          }
        }
      }
    });
    child.on("error", (e) => done({ reliable: false, error: e.message }));
    child.stdin.write(
      JSON.stringify({ jsonrpc: "2.0", id: 1, method: "initialize", params: { clientInfo: { name: "agent-team-scaffold", version: "1.0.0" } } }) + "\n"
    );
    setTimeout(() => done({ reliable: false, error: "codex app-server timed out" }), 10000);
  });
}

// Gemini CLI has no documented quota-check interface at all, official or
// otherwise (confirmed against Gemini CLI's own issue tracker) — there is
// nothing real to query. This always returns unreliable, on purpose, rather
// than fabricate a percentage from an unrelated proxy (e.g. counting local
// session files) and presenting a guess as if it were a measurement.
function checkQuotaGemini() {
  return Promise.resolve({ reliable: false, error: "Gemini CLI exposes no quota interface to check" });
}

const QUOTA_CHECKERS = { claude: checkQuotaClaudeCode, codex: checkQuotaCodex, gemini: checkQuotaGemini };

async function checkQuota(providerName) {
  const checker = QUOTA_CHECKERS[providerName];
  if (!checker) return { reliable: false, error: `no quota checker registered for provider "${providerName}"` };
  try {
    return await checker();
  } catch (e) {
    return { reliable: false, error: e.message };
  }
}

// Self-verification commands are project-authored, and which shell they
// need is genuinely bimodal — not something to keep guessing at with one
// hardcoded default. POSIX-style commands (`vendor/bin/phpunit`,
// `./node_modules/.bin/jest`) need bash: cmd.exe reports "'vendor' is not
// recognized", splitting on the slash instead of resolving the path
// (verified live). Windows-native tools using single-slash flag syntax
// (MSBuild, csc.exe, devenv.exe) need cmd.exe instead: bash's own MSYS
// path-conversion silently mangles a leading "/" on any argument that
// looks like a Unix path, turning `/p:Configuration=Debug` into
// `p:Configuration=Debug` and producing a confusing MSBuild error instead
// of a clean failure (also verified live, against a real .NET Framework
// solution — the exact same command that fails through bash builds clean
// through cmd.exe). Default to bash on win32 since POSIX-style commands are
// the more common case across this scaffold's own worked examples, but let
// an agent override it per `roster.json`'s optional `"shell"` field
// ("cmd" or "bash") when its own tooling needs the other one — see
// roster.json.template.
function runSelfVerification(command, cwd, shellOverride) {
  const preferCmd = shellOverride === "cmd";
  const preferBash = shellOverride === "bash" || (!shellOverride && process.platform === "win32");
  const shell = preferCmd ? true : preferBash ? "bash" : true;
  let res = spawnSync(command, { cwd, shell, encoding: "utf8" });
  if (preferBash && res.error && res.error.code === "ENOENT") {
    // bash itself isn't on PATH — fall back to cmd.exe rather than fail outright.
    res = spawnSync(command, { cwd, shell: true, encoding: "utf8" });
  }
  return { pass: res.status === 0, output: (res.stdout || "") + (res.stderr || "") };
}

// The headless security gate runs the SAME script the Claude Code PreToolUse hook
// and the git pre-commit hook run (.claude/hooks/security-gate.{sh,ps1}), in its
// `range <base> <head>` mode, against the worker's branch before it merges. One
// implementation and one path list (.claude/security-sensitive-paths.txt) for
// every provider, so the headless rule can't drift from the interactive one.
// Fails closed: if the roster names a security agent but no gate script exists,
// the merge is blocked rather than waved through.
function runSecurityGate(cwd, base, head, roster) {
  if (!roster.securityAgent) return { pass: true };
  const sh = path.join(cwd, ".claude", "hooks", "security-gate.sh");
  const ps1 = path.join(cwd, ".claude", "hooks", "security-gate.ps1");
  let res;
  if (fs.existsSync(sh)) {
    res = spawnSync("bash", [sh, "range", base, head], { cwd, encoding: "utf8" });
  } else if (fs.existsSync(ps1)) {
    res = spawnSync("powershell", ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ps1, "range", base, head], { cwd, encoding: "utf8" });
  } else {
    return { pass: false, output: "roster.json names a security agent but .claude/hooks/security-gate.{sh,ps1} is missing" };
  }
  if (res.error) return { pass: false, output: `security gate could not run: ${res.error.message}` };
  return { pass: res.status === 0, output: (res.stdout || "") + (res.stderr || "") };
}


// Escalation: a failed self-verification retries one tier up (light -> default ->
// high) instead of re-running the same model on the same failure. The agent's own
// tier, or the queue item's [tier:x] tag, is where it starts. Set
// "escalateOnFail": false on a roster agent to keep every attempt on one tier.
const TIER_LADDER = ["light", "default", "high"];
function tierForAttempt(startTier, attempt, escalate) {
  if (!startTier) return undefined;
  const i = TIER_LADDER.indexOf(startTier);
  if (i < 0 || escalate === false) return startTier;
  return TIER_LADDER[Math.min(i + attempt - 1, TIER_LADDER.length - 1)];
}

// With an effortFlag on the provider the ladder gets a second axis. A failed check retries one step up, MORE EFFORT FIRST on
// the same model (cheap, keeps the cache), then a bigger model: low -> medium on the cheap tier, then the next tier at its
// own default effort. Anthropic's rule of thumb: if the model skipped a file or didn't run the tests, raise effort; if it
// had everything and was still wrong, use a bigger model. A cheap tier gets ONE extra effort step, not five attempts: failed
// cheap runs cost several times a successful one. "escalateEffortFirst": false on the roster restores tier-only steps.
function stepForAttempt(startTier, startEffort, attempt, escalate, p, effortFirst = true) {
  const tier = tierForAttempt(startTier, attempt, escalate);
  if (!p || !p.effortFlag) return { tier, effort: undefined };
  const te = p.tierEfforts || {};
  const tierEffort = (t) => (EFFORT_LADDER.includes(te[t]) ? te[t] : startEffort || "medium");
  const first = startEffort || tierEffort(startTier);
  if (escalate === false) return { tier: startTier, effort: first };
  const steps = [{ tier: startTier, effort: first }];
  const e0 = EFFORT_LADDER.indexOf(first);
  if (effortFirst && e0 >= 0 && e0 < EFFORT_LADDER.length - 1) steps.push({ tier: startTier, effort: EFFORT_LADDER[e0 + 1] });
  for (let j = TIER_LADDER.indexOf(startTier) + 1; startTier && j > 0 && j < TIER_LADDER.length; j++) steps.push({ tier: TIER_LADDER[j], effort: tierEffort(TIER_LADDER[j]) });
  return steps[Math.min(attempt - 1, steps.length - 1)];
}

// One `dispatch_end` event per dispatch in .agent-team/events.jsonl: which tier each
// attempt used, how many attempts, pass or blocked, and wall time. Reviewing it is
// how tiers get tuned: an agent that always escalates should start a tier higher;
// one that never fails on its first tier may be able to start a tier lower. It goes
// in the event log rather than a file of its own, so it is never committed and never
// makes the tree look dirty to the next run-phase.
function logDispatch(entry) {
  logEvent("dispatch_end", entry);
}


// Ownership, test-path and runtime-path globs use this; the security path list is regexes.
// Two-pass blind replace (** -> .*, then * -> [^/]*) corrupts itself: the
// first pass's own output contains literal "*" characters that the second
// pass then re-matches and mangles. A placeholder protects "**" through
// both passes instead — "@@" is plain text, never produced by either regex
// pass, so it survives untouched until the final swap. Also escapes regex
// metacharacters (a literal "." in a path glob must not become "match any
// character") and anchors the pattern so "auth" can't match as a substring
// of "authors/file.py".
function globToRegex(glob) {
  // `**/` is "any number of directories, including none" (as in .gitignore), so `**/*.test.*` must match a root-level
  // `a.test.ts` as well as `src/a.test.ts`; a bare `**` matches anything.
  const DIRS = "@D@";
  const PLACEHOLDER = "@@";
  const escaped = glob.replace(/[.+^${}()|[\]\\]/g, "\\$&");
  const withDirs = escaped.split("**/").join(DIRS);
  const withGlobstar = withDirs.split("**").join(PLACEHOLDER);
  const withStar = withGlobstar.replace(/\*/g, "[^/]*");
  const final = withStar.split(DIRS).join("(?:.*/)?").split(PLACEHOLDER).join(".*");
  return new RegExp(`^${final}$`);
}

// ---------------------------------------------------------------------------
// Safety layer: event log, kill switch, integrity seal, tamper guards,
// independent verifier, lint. Everything here is local file I/O and git —
// no provider call except runVerifier/adviseOnce.
// ---------------------------------------------------------------------------
// Files the orchestrator itself writes into the project. They are not agent output: never counted as an
// ownership violation and never committed (a shared-workspace dispatch runs in the repo root, where
// they exist untracked unless .gitignore happens to list them).
const RUNTIME_PATHS = [".agent-team/events.jsonl", ".agent-team/stamps.json", ".agent-team/STOP", ".agent-team/integrity.json", ".agent-team/worktrees/**", ".agent-team/evals/results-*.json"];
const STOP_PATH = path.join(TEAM_DIR, "STOP");
const EVENTS_PATH = path.join(TEAM_DIR, "events.jsonl");
const INTEGRITY_PATH = path.join(TEAM_DIR, "integrity.json");

// Append-only run record. Deliberately logs sizes, durations, verdicts and short reasons — never
// prompts or provider output, which can contain secrets or private code. A logging failure must
// never break a dispatch, hence the swallow.
function logEvent(type, data = {}) {
  try {
    fs.mkdirSync(TEAM_DIR, { recursive: true });
    fs.appendFileSync(EVENTS_PATH, JSON.stringify({ ts: new Date().toISOString(), type, ...data }) + "\n");
  } catch {
    /* intentionally ignored */
  }
}

// Kill switch. `orchestrator.mjs stop` creates .agent-team/STOP; every dispatch checks it before it
// starts and between attempts, and invokeProvider polls it while a worker runs and kills the process
// tree. `resume` deletes it.
function stopRequested() {
  return fs.existsSync(STOP_PATH);
}

// child.kill() only kills the shell that `shell: true` wrapped around the CLI, not the CLI itself, so a
// timeout or STOP would leave the real worker running (found by CI on Linux: a 30s worker was still
// running 30s after STOP). Windows: taskkill /T takes the tree. POSIX: the child is spawned detached so
// it leads its own process group, and a negative pid signals the whole group.
const activeChildren = new Set();
function killTree(child) {
  if (!child.pid) return;
  if (process.platform === "win32") {
    spawnSync("taskkill", ["/pid", String(child.pid), "/T", "/F"]);
  } else {
    try {
      process.kill(-child.pid, "SIGKILL");
    } catch {
      child.kill("SIGKILL");
    }
  }
}
// A detached child no longer receives the terminal's Ctrl-C, so do not leave workers behind if the
// orchestrator itself is interrupted.
for (const sig of ["SIGINT", "SIGTERM"]) process.on(sig, () => { for (const c of activeChildren) killTree(c); process.exit(130); });
process.on("exit", () => { for (const c of activeChildren) killTree(c); });

// --- Integrity seal -------------------------------------------------------
// The gate trusts roster.json's selfVerification, the hooks, the agent files and the playbooks.
// If an agent could edit those, "the check passed" would mean nothing — a prompt-injected or merely
// confused worker could rewrite its own check to `true`. The seal records a SHA-256 of every such
// file, signed with a key kept in the user's home directory (outside the repo), and every dispatch
// re-checks it before and after the worker runs. This is tamper-EVIDENT, not tamper-proof: a worker
// with unrestricted shell access could in principle read the key and re-seal. It stops accidents,
// drift, and injected "edit the config" instructions; real prevention is OS permissions, CODEOWNERS,
// and deny rules.
const PROTECTED_FILES = [".agent-team/roster.json", ".agent-team/providers.json", ".agent-team/council.json", ".agent-team/allowlist.json", ".agent-team/orchestrator.mjs", "AGENTS.md", "CLAUDE.md"];
const PROTECTED_DIRS = [".claude/hooks", ".claude/agents"];

function walkFiles(dir, base) {
  const out = [];
  const abs = path.join(base, dir);
  if (!fs.existsSync(abs)) return out;
  for (const entry of fs.readdirSync(abs, { withFileTypes: true })) {
    const rel = `${dir}/${entry.name}`;
    if (entry.isDirectory()) out.push(...walkFiles(rel, base));
    else if (entry.isFile()) out.push(rel);
  }
  return out;
}

// The SubagentStop gate keeps its circuit-breaker state inside .claude/hooks/ (the .ps1 gate writes
// .subagent-gate-state.json on every run, the .sh gate a .subagent-gate-state/ directory on failure). That
// is runtime state, not code: sealing it made every sealed project report its own gate as tampering
// (a consuming project worked around this with a per-project integrityExclude). Excluded by default.
const GATE_STATE_RE = /^\.claude\/hooks\/\.subagent-gate-state(\.json|\/.*)?$/;

function protectedFiles(base, roster) {
  const out = new Set();
  for (const f of PROTECTED_FILES) if (fs.existsSync(path.join(base, f))) out.add(f);
  for (const d of PROTECTED_DIRS) walkFiles(d, base).forEach((f) => out.add(f));
  const tentacles = path.join(base, ".agent-team", "tentacles");
  if (fs.existsSync(tentacles)) {
    for (const t of fs.readdirSync(tentacles, { withFileTypes: true })) {
      if (!t.isDirectory()) continue;
      const root = `.agent-team/tentacles/${t.name}`;
      for (const f of ["PLAYBOOK.md", "CONTEXT.md"]) if (fs.existsSync(path.join(base, root, f))) out.add(`${root}/${f}`);
      walkFiles(`${root}/files`, base).forEach((f) => out.add(f));
    }
  }
  const exclude = new Set(((roster && roster.integrityExclude) || []).map((p) => p.replace(/\\/g, "/")));
  return [...out].filter((f) => !exclude.has(f) && !GATE_STATE_RE.test(f)).sort();
}

// Line endings are normalised before hashing: a git worktree can check files out with different
// CRLF/LF than the main tree on Windows, and that must not read as tampering.
function hashFile(abs) {
  const buf = fs.readFileSync(abs);
  const data = buf.includes(0) ? buf : Buffer.from(buf.toString("utf8").replace(/\r\n/g, "\n"), "utf8");
  return crypto.createHash("sha256").update(data).digest("hex");
}

function computeManifest(base, roster) {
  const files = {};
  for (const f of protectedFiles(base, roster)) files[f] = hashFile(path.join(base, f));
  return files;
}

// The key is looked up by project path, so the path must be CANONICAL. process.cwd() keeps whatever alias
// it was started under — on Windows an 8.3 short name (C:\Users\RUNNER~1\...) and its long form are
// different strings for the same directory, so a project sealed from one and checked from the other
// (a Node child vs a PowerShell hook, as on GitHub's Windows runners) found no key and failed integrity.
function canonicalRoot() {
  try {
    const r = fs.realpathSync.native(ROOT);
    return process.platform === "win32" ? r.toLowerCase() : r;
  } catch {
    return ROOT;
  }
}

function sealKeyPath() {
  return path.join(os.homedir(), ".agent-team", "seal-keys", crypto.createHash("sha1").update(canonicalRoot()).digest("hex") + ".key");
}

function getSealKey(create) {
  const p = sealKeyPath();
  if (fs.existsSync(p)) return fs.readFileSync(p, "utf8").trim();
  if (!create) return null;
  fs.mkdirSync(path.dirname(p), { recursive: true });
  const key = crypto.randomBytes(32).toString("hex");
  fs.writeFileSync(p, key, { mode: 0o600 });
  return key;
}

function signManifest(files, key) {
  return crypto.createHmac("sha256", key).update(JSON.stringify(files)).digest("hex");
}

// `lenient` is for a git worktree: gitignored or untracked files (often .agent-team/ itself) simply
// aren't there, so "missing" is not evidence of tampering — but a changed file, or a new file in a
// protected location, still is.
function verifyIntegrity(base, roster, { lenient = false } = {}) {
  if (!fs.existsSync(INTEGRITY_PATH)) return { sealed: false, problems: [] };
  let manifest;
  try {
    manifest = JSON.parse(fs.readFileSync(INTEGRITY_PATH, "utf8"));
  } catch {
    return { sealed: true, problems: ["integrity.json is unreadable"] };
  }
  const problems = [];
  const key = getSealKey(false);
  if (!key) {
    problems.push("no seal key for this checkout (sealed on another machine or key deleted) — the manifest signature cannot be verified");
  } else if (manifest.signature !== signManifest(manifest.files || {}, key)) {
    problems.push("integrity.json was modified after sealing (signature mismatch)");
  }
  const sealed = manifest.files || {};
  const current = computeManifest(base, roster);
  for (const [f, h] of Object.entries(sealed)) {
    if (!(f in current)) {
      if (!lenient) problems.push(`removed: ${f}`);
    } else if (current[f] !== h) {
      problems.push(`changed: ${f}`);
    }
  }
  for (const f of Object.keys(current)) if (!(f in sealed)) problems.push(`added: ${f}`);
  return { sealed: true, problems };
}

function sealNow(roster) {
  const files = computeManifest(ROOT, roster);
  const key = getSealKey(true);
  fs.mkdirSync(TEAM_DIR, { recursive: true });
  fs.writeFileSync(INTEGRITY_PATH, JSON.stringify({ sealedAt: new Date().toISOString(), files, signature: signManifest(files, key) }, null, 2) + "\n");
  logEvent("seal", { files: Object.keys(files).length });
  return Object.keys(files).length;
}

// --- Test-tamper and feature-list guards ------------------------------------
// The most common way an agent "passes" is to weaken the check: delete the failing test, add a
// skip, or flip a feature to passing without doing the work. These run BEFORE self-verification so
// a gutted test can never be what makes the check go green.
const TEST_PATH_DEFAULTS = ["**/*.test.*", "**/*.spec.*", "**/test_*.py", "**/*_test.*", "**/tests/**", "**/test/**", "**/__tests__/**"];
const ASSERT_RE = /(\bassert\w*\b|\bexpect\s*\(|\b(?:it|test)\s*\(|\bdef\s+test_|@Test\b|\[Fact\]|\[Theory\]|\bTEST_CASE\b|\bt\.Run\()/;

// What counts as a skip is easy to get wrong in both directions. A static disable (`it.skip("x", ...)`, `xit`,
// `@Disabled`, `it.todo`) removes a check, so it counts. A skip that depends on a condition at run time
// (`if (!db) return ctx.skip()`, `test.skip(isCI, "why")`, `it.skipIf(!db)(...)`, `pytest.mark.skipif`) is how an
// integration test says "this needs a service": counting it made one guard line read as "17 skip markers" at five
// different agents. An unconditional runtime skip (a bare `ctx.skip()`, `t.Skip("x")` with no `if` around it) still counts.
const STATIC_SKIP_RE = /(\bxit\s*\(|\bxtest\s*\(|\bxdescribe\s*\(|@Disabled\b|@Ignore\b|pytest\.mark\.skip\b|@unittest\.skip\b|\[Fact\(Skip|\[Theory\(Skip|\b(?:it|test)\.todo\b|\.skipIf\(\s*true\s*\)|\.runIf\(\s*false\s*\))/;
const REGISTRATION_SKIP_RE = /\b(?:it|test|describe|suite|context|specify|bench)(?:\.[A-Za-z]+)*\.skip\b(.*)/;
const RUNTIME_SKIP_RE = /\b\w+(?:\.\w+)*\.(?:skip|Skip|Skipf|skipTest)\s*\((.*)/;
const GUARD_RE = /\b(?:if|else|unless|when|catch|switch|case)\b|\?|&&|\|\|/;
// `line` is an added line of a test file; `before` is the (up to two) added lines just above it, where a guard may sit.
function isSkipMarker(line, before = "") {
  if (STATIC_SKIP_RE.test(line)) return true;
  const reg = line.match(REGISTRATION_SKIP_RE);
  if (reg) {
    // `test.skip("title", fn)`, `describe.skip.each(...)` and a bare `test.skip()` disable a test; `test.skip(cond, "why")` is conditional
    const arg = reg[1].match(/^\s*\(\s*(.?)/);
    return !arg || /["'`)]|^$/.test(arg[1]) || /^\s*\(\s*true\b/.test(reg[1]);
  }
  const rt = line.match(RUNTIME_SKIP_RE);
  if (!rt) return false;
  const arg = rt[1].trim();
  // skip(), skip("reason") and skip(true) never depend on anything, so only an enclosing `if` makes them conditional
  if (arg === "" || /^(?:\)|["'`]|true\b)/.test(arg)) return !GUARD_RE.test(line.slice(0, rt.index)) && !GUARD_RE.test(before);
  return false; // skip(!hasDb): the condition is the argument
}

function gitHead(cwd) {
  const r = spawnSync("git", ["rev-parse", "HEAD"], { cwd, encoding: "utf8" });
  return r.status === 0 ? r.stdout.trim() : null;
}

// What the tests look like now compared with `baseSha`: deleted test files, assertion lines removed and added, skips added.
function testChangeStats(cwd, baseSha, roster) {
  const res = spawnSync("git", ["diff", baseSha, "-U0", "--no-color"], { cwd, encoding: "utf8", maxBuffer: 50 * 1024 * 1024 });
  if (res.status !== 0) return null;
  const patterns = (roster.testPaths || TEST_PATH_DEFAULTS).map(globToRegex);
  const isTest = (f) => patterns.some((re) => re.test(f));
  const stats = { deleted: [], removed: 0, added: 0, skips: 0 };
  let file = null;
  let inTest = false;
  let before = [];
  for (const line of res.stdout.split("\n")) {
    const hdr = line.match(/^diff --git a\/(.+?) b\/(.+)$/);
    if (hdr) {
      file = hdr[2];
      inTest = isTest(file);
      before = [];
      continue;
    }
    if (!inTest) continue;
    if (line.startsWith("@@")) before = [];
    else if (line.startsWith("deleted file mode")) stats.deleted.push(file);
    else if (line.startsWith("-") && !line.startsWith("---") && ASSERT_RE.test(line)) stats.removed++;
    else if (line.startsWith("+") && !line.startsWith("+++")) {
      if (ASSERT_RE.test(line)) stats.added++;
      if (isSkipMarker(line, before.join("\n"))) stats.skips++;
      before = [...before, line].slice(-2);
    }
  }
  // New (untracked) test files are not in `git diff`; a skip marker added there must still count.
  for (const f of untrackedFiles(cwd).filter(isTest)) {
    try {
      const lines = fs.readFileSync(path.join(cwd, f), "utf8").split("\n");
      stats.skips += lines.filter((l, i) => isSkipMarker(l, lines.slice(Math.max(0, i - 2), i).join("\n"))).length;
    } catch {
      /* unreadable: ignore */
    }
  }
  return stats;
}

// `base` is what the tree already looked like when the agent started. In a shared tree another agent's uncommitted
// skip or edit is in the diff at every later agent's stop; without a baseline it was blamed on each of them in turn.
function checkTestTamper(cwd, baseSha, roster, taskText, base = null) {
  if (!baseSha || roster.testTamperGuard === false || /\[allow-test-changes\]/i.test(taskText)) return [];
  const now = testChangeStats(cwd, baseSha, roster);
  if (!now) return [];
  const was = base || { deleted: [], removed: 0, added: 0, skips: 0 };
  const deleted = now.deleted.filter((f) => !was.deleted.includes(f));
  const skips = now.skips - was.skips;
  const net = now.removed - now.added - (was.removed - was.added);
  const problems = [];
  if (deleted.length) problems.push(`deleted test file(s): ${deleted.join(", ")}`);
  if (skips > 0) problems.push(`added ${skips} skip/disable marker(s) to tests`);
  if (net > 0) problems.push(`removed ${net} more assertion/test line(s) than were added`);
  return problems;
}

// Ownership is the scaffold's core partition (no two agents own the same path) — but until this guard
// nothing ENFORCED it at dispatch time. In a live run, a testing agent asked to add one small test
// also created build config, a lockfile and a monorepo pipeline file outside its remit.
// `.claude/contracts/**` is always allowed (agents must update contracts and write handoffs);
// roster `sharedPaths` adds more. Opt out with `ownershipGuard: false` on the roster or an agent.
//
// The security audit ledger is the exception to the exception: the security gate accepts a sensitive change when
// the ledger names it, so an agent that could append to the ledger could approve its own change. When the roster
// names a `securityAgent`, only that agent may touch the ledger, and `ownershipGuard: false` does not lift this.
const LEDGER_REL = ".claude/contracts/security-audit-log.md";
const ledgerForbidden = (agent, roster, rel) => !!roster.securityAgent && agent.name !== roster.securityAgent && rel === LEDGER_REL;
const LEDGER_MSG = (roster) => `changed ${LEDGER_REL}, which only the security agent (${roster.securityAgent}) may change: the security gate trusts that file, so an agent must not write its own approval. Revert it and report what needs auditing`;
function checkOwnership(cwd, baseSha, agent, roster) {
  if (!baseSha) return [];
  const guarded = roster.ownershipGuard !== false && agent.ownershipGuard !== false && (agent.ownership || []).length;
  if (!guarded && !roster.securityAgent) return [];
  const list = (args) => (spawnSync("git", args, { cwd, encoding: "utf8", maxBuffer: 50 * 1024 * 1024 }).stdout || "").split(/\r?\n/).filter(Boolean);
  const changed = [...new Set([...list(["diff", "--name-only", baseSha]), ...list(["ls-files", "--others", "--exclude-standard"])])];
  const problems = [];
  if (changed.some((f) => ledgerForbidden(agent, roster, f))) problems.push(LEDGER_MSG(roster));
  if (guarded) {
    const allowed = [...agent.ownership, ...(roster.sharedPaths || []), ".claude/contracts/**", ...RUNTIME_PATHS].map(globToRegex);
    const outside = changed.filter((f) => !allowed.some((re) => re.test(f)));
    if (outside.length) problems.push(`changed ${outside.length} file(s) outside this agent's ownership: ${outside.slice(0, 15).join(", ")}${outside.length > 15 ? ", …" : ""}. Revert them; if the task genuinely needs another agent's files, stop and report NEEDS <agent-name>: <what's needed>`);
  }
  return problems;
}

function checkFeatureList(cwd, baseSha, roster) {
  if (!roster.featureList || !baseSha) return [];
  const rel = roster.featureList;
  const show = spawnSync("git", ["show", `${baseSha}:${rel}`], { cwd, encoding: "utf8", maxBuffer: 20 * 1024 * 1024 });
  if (show.status !== 0) return []; // not tracked at the base commit — nothing to compare against
  const load = (txt) => {
    const j = JSON.parse(txt);
    return Array.isArray(j) ? j : j.features;
  };
  let before;
  let after;
  try {
    before = load(show.stdout);
    after = load(fs.readFileSync(path.join(cwd, rel), "utf8"));
  } catch (e) {
    return [`feature list ${rel} is not valid JSON after the change (${e.message})`];
  }
  if (!Array.isArray(before) || !Array.isArray(after)) return [];
  if (before.length !== after.length) return [`feature count changed from ${before.length} to ${after.length} — features may be marked passing, never added or removed`];
  const strip = (f) => JSON.stringify({ ...f, passes: undefined });
  const problems = [];
  before.forEach((f, i) => {
    if (strip(f) !== strip(after[i])) problems.push(`feature #${i + 1} was edited beyond its "passes" field`);
  });
  return problems;
}

// --- Independent verifier ---------------------------------------------------
// MAST (arXiv 2503.13657) finds missing and incorrect verification are among the most common
// multi-agent failures; a worker that checks its own work shares its own blind spots. When an agent
// has `"verifier": { "provider": "...", "model": "..." }`, a SECOND read-only call reviews the diff
// against the playbook's Definition of done after the self-verification command passes. It fails
// OPEN (verdict "unavailable") if it cannot run or returns no verdict, like every other gate here.
function extractDefinitionOfDone(playbookText) {
  const m = playbookText.match(/^## Definition of done[\s\S]*?(?=^## |(?![\s\S]))/m);
  return m ? m[0].trim() : "(no Definition of done found in the playbook)";
}

// `git diff <sha>` shows changes to tracked files only — a file the worker just CREATED is untracked
// until it is committed, so it is invisible. A live run had the reviewer reply
// "no files appear in the diff" for a change that was entirely new files. Append each untracked file's
// content (capped) so the reviewer sees what the worker actually produced.
function untrackedFiles(cwd) {
  return (spawnSync("git", ["ls-files", "--others", "--exclude-standard"], { cwd, encoding: "utf8" }).stdout || "").split(/\r?\n/).filter(Boolean);
}

function diffIncludingNew(cwd, baseSha) {
  let out = spawnSync("git", ["diff", baseSha, "--no-color"], { cwd, encoding: "utf8", maxBuffer: 50 * 1024 * 1024 }).stdout || "";
  for (const f of untrackedFiles(cwd)) {
    let body;
    try {
      const buf = fs.readFileSync(path.join(cwd, f));
      body = buf.includes(0) ? "(binary file)" : buf.toString("utf8").slice(0, 8000);
    } catch {
      body = "(unreadable)";
    }
    out += `\n--- /dev/null\n+++ b/${f}   (NEW FILE)\n${body.split("\n").map((l) => "+" + l).join("\n")}\n`;
  }
  return out;
}

async function runVerifier(agent, taskText, cwd, baseSha, providers, workerOutput) {
  const v = agent.verifier;
  if (!v || !v.provider) return { verdict: "skip" };
  const playbookPath = path.join(TEAM_DIR, "tentacles", agent.name, "PLAYBOOK.md");
  const dod = fs.existsSync(playbookPath) ? extractDefinitionOfDone(fs.readFileSync(playbookPath, "utf8")) : "(no playbook)";
  const diff = baseSha ? diffIncludingNew(cwd, baseSha) : "";
  const MAX_DIFF = 60000;
  const prompt = [
    "You are an independent reviewer. You did not write this change and you have no stake in it passing.",
    `\n## Task that was assigned\n${taskText}`,
    `\n## Definition of done for this job\n${dod}`,
    `\n## The worker's own end-of-job report (tail)\n${trimOutput(workerOutput, 40)}`,
    `\n## The change (git diff)\n${diff.length > MAX_DIFF ? diff.slice(0, MAX_DIFF) + "\n… (diff truncated)" : diff || "(empty diff)"}`,
    "\n## What to do",
    "Check the diff against the task and each Definition-of-done check. Look specifically for: tests deleted, skipped or weakened; hard-coded outputs that make a check pass without doing the work; unrelated changes; claims in the worker's report that the diff does not support. You may not edit anything. Reply with brief findings, then a final line that is exactly `VERDICT: PASS` or `VERDICT: FAIL - <one-sentence reason>`.",
  ].join("\n");
  const r = await adviseOnce(v.provider, providers, prompt, { model: v.model });
  if (!r.ok) {
    logEvent("verifier", { agent: agent.name, verdict: "unavailable", reason: r.message.slice(0, 200) });
    return { verdict: "unavailable", reason: r.message };
  }
  // Tolerant of markdown a model adds around the line ("**VERDICT: PASS**", "> VERDICT: FAIL"): the
  // a live run returned a verdict the strict parser threw away.
  const matches = [...r.answer.matchAll(/^[\s*_#>`-]*VERDICT:\s*\**\s*(PASS|FAIL)\b[\s*_`:-]*(.*)$/gim)];
  if (!matches.length) {
    logEvent("verifier", { agent: agent.name, verdict: "unavailable", reason: "no VERDICT line" });
    return { verdict: "unavailable", reason: "reviewer returned no VERDICT line" };
  }
  const last = matches[matches.length - 1];
  const verdict = last[1].toUpperCase();
  logEvent("verifier", { agent: agent.name, verdict, provider: v.provider });
  return { verdict, reason: trimOutput(r.answer, 30) };
}

// --- Lint -------------------------------------------------------------------
// Mechanical checks on the generated setup itself. Size limits exist because repo-level context
// files that restate what the code already shows did not improve task success and raised cost
// ~20% in arXiv 2602.11988 — every line in a playbook should pass "would removing this cause a
// mistake?". Warnings, not errors, for size; errors for things that are plainly broken.
// <word ...> with no shell metacharacters inside. A bare `>` is just a redirect (`cmd > /dev/null`) and must
// not read as a placeholder; `<the exact command>` and `<agent-name>` must.
const PLACEHOLDER_RE = /<[A-Za-z][^<>|&;\n]{2,}>/;
const LINE_BUDGETS = { playbook: 150, context: 120, agent: 200, notes: 60 };

function parseFrontmatter(text) {
  const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (!m) return null;
  const fm = {};
  let listKey = null;
  let foldKey = null;
  for (const line of m[1].split(/\r?\n/)) {
    const li = line.match(/^\s+-\s+(.*)$/);
    if (li && listKey) {
      fm[listKey].push(li[1].trim());
      continue;
    }
    const kv = line.match(/^([A-Za-z_-]+):\s*(.*)$/);
    if (kv) {
      listKey = foldKey = null;
      if (kv[2] === "") {
        fm[kv[1]] = [];
        listKey = kv[1];
      } else if (kv[2] === ">" || kv[2] === "|") {
        fm[kv[1]] = "";
        foldKey = kv[1];
      } else {
        fm[kv[1]] = kv[2].replace(/^["']|["']$/g, "");
      }
    } else if (foldKey && /^\s+\S/.test(line)) {
      fm[foldKey] += (fm[foldKey] ? " " : "") + line.trim();
    }
  }
  return fm;
}

function countLines(p) {
  return fs.readFileSync(p, "utf8").split(/\r?\n/).length;
}

// Does the ownership map fit the tree it guards? The guards are only as good as these globs: a file nobody owns is
// refused to every guarded agent, a file two agents own is nobody's job, and a test file the testPaths do not
// cover can be deleted or skipped unseen. In a live run all three showed up as blocked writes (a framework config,
// shared API type files) and an `*.integration.tests.ts` suite that neither the owner globs nor testPaths matched.
const CODE_EXT_RE = /\.(?:[cm]?[jt]sx?|py|go|java|cs|rb|php|kt|rs|swift)$/;
const NOT_OWNED_RE = /(?:^|\/)(?:\.git[^/]*|LICENSE[^/]*|[^/]*lock[^/]*|[^/]*\.md|\.agent-team\/.*|\.claude\/.*)$/;
function ownershipFit(roster) {
  const out = [];
  if (roster.ownershipGuard === false) return out;
  const ls = spawnSync("git", ["ls-files"], { cwd: ROOT, encoding: "utf8", maxBuffer: 50 * 1024 * 1024 });
  const tracked = ls.status === 0 ? ls.stdout.split(/\r?\n/).filter(Boolean) : [];
  if (!tracked.length) return out;
  const agents = (roster.agents || []).filter((a) => !a.dormant && a.ownershipGuard !== false && (a.ownership || []).length && !(a.ownership || []).some((o) => PLACEHOLDER_RE.test(o)));
  const owners = agents.map((a) => ({ name: a.name, res: a.ownership.map((g) => [g, globToRegex(g)]) }));
  const shared = [...(roster.sharedPaths || []), ".claude/contracts/**", ...RUNTIME_PATHS].map(globToRegex);
  const sample = (xs, n = 5) => xs.slice(0, n).join(", ") + (xs.length > n ? `, … (${xs.length} in all)` : "");
  for (const o of owners) {
    const dead = o.res.filter(([, re]) => !tracked.some((f) => re.test(f))).map(([g]) => g);
    if (dead.length) out.push({ level: "info", msg: `agent ${o.name}: ownership ${dead.map((g) => `"${g}"`).join(", ")} matches no tracked file (a typo, or a path that does not exist yet)` });
  }
  const unowned = [];
  const multi = [];
  for (const f of tracked) {
    if (shared.some((re) => re.test(f)) || NOT_OWNED_RE.test(f)) continue;
    const who = owners.filter((o) => o.res.some(([, re]) => re.test(f))).map((o) => o.name);
    if (!who.length) unowned.push(f);
    else if (who.length > 1) multi.push(`${f} (${who.join(" + ")})`);
  }
  if (owners.length && unowned.length) out.push({ level: "info", msg: `${unowned.length} tracked file(s) are in no agent's ownership or sharedPaths, so every guarded agent is blocked from editing them (e.g. ${sample(unowned)}). Give each an owner, or list the genuinely cross-cutting ones in roster "sharedPaths"` });
  if (multi.length) out.push({ level: "warn", msg: `${multi.length} file(s) are owned by more than one agent (${sample(multi, 3)}) — one owner per path is the rule that keeps parallel agents from overwriting each other` });
  const testRes = (roster.testPaths || TEST_PATH_DEFAULTS).map(globToRegex);
  const looksLikeTest = tracked.filter((f) => CODE_EXT_RE.test(f) && /.[._-](?:tests?|specs?)[._-]/i.test(path.basename(f)) && !testRes.some((re) => re.test(f)));
  if (roster.testTamperGuard !== false && looksLikeTest.length) out.push({ level: "warn", msg: `${looksLikeTest.length} file(s) look like tests but match no testPaths (${sample(looksLikeTest, 3)}), so the test-tamper guard cannot see them deleted or skipped — add a glob for them to roster "testPaths" (setting it replaces the defaults, so keep those too)` });
  return out;
}

function lintProject() {
  const findings = [];
  const add = (level, msg) => findings.push({ level, msg });
  if (!fs.existsSync(ROSTER_PATH)) {
    add("error", "no .agent-team/roster.json");
    return findings;
  }
  const roster = readJson(ROSTER_PATH);
  // An optional key left as "<optional - ...>" is silently WRONG, not absent: testPaths would match
  // nothing (disabling the tamper guard) and maxBudgetUsd would throw at dispatch time.
  const leftovers = fs.readFileSync(ROSTER_PATH, "utf8").match(/"<[^"]*>"/g) || [];
  if (leftovers.length) add("error", `roster.json still contains ${leftovers.length} template placeholder value(s), e.g. ${leftovers[0].slice(0, 60)}… — fill or delete them`);
  const providers = fs.existsSync(PROVIDERS_PATH) ? readJson(PROVIDERS_PATH) : {};
  const allow = fs.existsSync(path.join(TEAM_DIR, "allowlist.json")) ? readJson(path.join(TEAM_DIR, "allowlist.json")) : null;
  for (const [pn, pv] of Object.entries(providers)) {
    for (const [tn, ev] of Object.entries((pv && pv.tierEfforts) || {})) {
      if (!EFFORT_RE.test(String(ev))) add("error", `providers.json: provider "${pn}" tierEfforts.${tn} is "${ev}", not one of low, medium, high, xhigh, max`);
    }
    if (pv && pv.effortFlag && !/^--?[A-Za-z][A-Za-z-]*$/.test(String(pv.effortFlag))) add("error", `providers.json: provider "${pn}" effortFlag "${pv.effortFlag}" is not a plain flag`);
    if (pv && pv.tierEfforts && !pv.effortFlag) add("warn", `providers.json: provider "${pn}" has tierEfforts but no effortFlag, so no effort is passed`);
    for (const [tn, tm] of Object.entries((pv && pv.tiers) || {})) {
      if (!MODEL_ID_RE.test(String(tm))) add("error", `providers.json: provider "${pn}" tier "${tn}" has model "${tm}", which contains characters outside [A-Za-z0-9._:/-] (the command runs through a shell)`);
    }
  }
  if (!allow) add("warn", "no .agent-team/allowlist.json — skills and MCP tools given to agents are unvetted (supply-chain risk)");
  if (!fs.existsSync(INTEGRITY_PATH)) add("warn", "project is not sealed — run `node .agent-team/orchestrator.mjs seal` so edits to the gate config, hooks, agent files and playbooks are detected");
  for (const a of roster.agents || []) {
    const tag = `agent ${a.name}`;
    if (a.dormant) add("info", `${tag}: dormant (not routed to; delete the flag when it is needed)`);
    if (!providers[a.provider]) add("error", `${tag}: provider "${a.provider}" is not in providers.json`);
    if (!a.selfVerification || PLACEHOLDER_RE.test(a.selfVerification)) add("error", `${tag}: selfVerification is empty or still a template placeholder`);
    if (a.effort !== undefined && !EFFORT_RE.test(String(a.effort))) add("error", `${tag}: effort "${a.effort}" is not one of low, medium, high, xhigh, max`);
    if (a.effort && providers[a.provider] && !providers[a.provider].effortFlag) add("info", `${tag}: effort is set but provider "${a.provider}" has no effortFlag in providers.json, so headless dispatch ignores it (the agent file's effort: line still applies in a live session)`);
    if (!(a.ownership || []).length || (a.ownership || []).some((o) => PLACEHOLDER_RE.test(o))) add("error", `${tag}: ownership is empty or still a template placeholder`);
    if (a.mergePolicy === "manual" && !a.worktree) add("error", `${tag}: mergePolicy "manual" needs "worktree": true — without a branch there is nothing to hold back`);
    if (a.verifier && a.verifier.provider && !(providers[a.verifier.provider] && providers[a.verifier.provider].adviceArgs)) {
      add("error", `${tag}: verifier provider "${a.verifier.provider}" has no read-only adviceArgs in providers.json`);
    }
    const agentFile = path.join(ROOT, ".claude", "agents", `${a.name}.md`);
    if (fs.existsSync(agentFile)) {
      const text = fs.readFileSync(agentFile, "utf8");
      const fm = parseFrontmatter(text);
      if (!fm) add("error", `${tag}: .claude/agents/${a.name}.md has no frontmatter`);
      else {
        if (!fm.name || fm.name !== a.name) add("error", `${tag}: frontmatter name "${fm.name}" does not match the roster name`);
        if (typeof fm.description === "string" && fm.description.length > 1024) add("warn", `${tag}: description is ${fm.description.length} chars (Agent Skills limit is 1024)`);
        if (/[<>]/.test(String(fm.description || "")) && /<[a-z-]+>/.test(String(fm.description))) add("error", `${tag}: description still contains template placeholders`);
        if (fm.model && !/^(inherit|haiku|sonnet|opus|fable|claude-[a-z0-9.-]+)$/i.test(String(fm.model))) add("warn", `${tag}: model "${fm.model}" is not an alias (haiku, sonnet, opus, fable), "inherit" or a claude-… id`);
        if (/fable/i.test(String(fm.model || ""))) add("warn", `${tag}: model fable is the top tier and draws on a separate credit pool — keep it opt-in (an [escalate: reason] dispatch), not an agent's default`);
        if (fm.effort && !/^(low|medium|high|xhigh|max)$/i.test(String(fm.effort))) add("warn", `${tag}: effort "${fm.effort}" is not one of low, medium, high, xhigh, max`);
        if (/^(xhigh|max)$/i.test(String(fm.effort || ""))) add("warn", `${tag}: effort ${fm.effort} is the most expensive setting — reserve it for a single hard dispatch, not an agent's default`);
        if ((fm.tools || []).some((t) => /^(Agent|Task)$/.test(t))) add("error", `${tag}: tools includes Agent/Task — subagents cannot nest, and this voids the tools list`);
        if (allow) {
          for (const s of fm.skills || []) if (!(allow.skills || []).includes(s)) add("warn", `${tag}: skill "${s}" is not in allowlist.json`);
          for (const t of (fm.tools || []).filter((t) => /^mcp__/.test(t))) if (!(allow.mcp || []).includes(t)) add("warn", `${tag}: MCP tool "${t}" is not in allowlist.json`);
        }
      }
      if (countLines(agentFile) > LINE_BUDGETS.agent) add("warn", `${tag}: agent file is ${countLines(agentFile)} lines (budget ${LINE_BUDGETS.agent}) — trim what the code already shows`);
    } else {
      add("warn", `${tag}: no .claude/agents/${a.name}.md (fine if this project is headless-only)`);
    }
    const tdir = path.join(TEAM_DIR, "tentacles", a.name);
    const budgets = [["PLAYBOOK.md", LINE_BUDGETS.playbook, "playbook"], ["CONTEXT.md", LINE_BUDGETS.context, "context"], ["notes.md", LINE_BUDGETS.notes, "notes"]];
    if (!fs.existsSync(path.join(tdir, "PLAYBOOK.md"))) add("warn", `${tag}: no PLAYBOOK.md (process layer not built — SKILL.md step 3b)`);
    for (const [file, max, label] of budgets) {
      const p = path.join(tdir, file);
      if (fs.existsSync(p) && countLines(p) > max) {
        add("warn", `${tag}: ${file} is ${countLines(p)} lines (budget ${max})${label === "notes" ? " — consolidate: fold repeated entries into one explicit playbook rule and delete the rest" : " — remove anything the code, tests or config already show"}`);
      }
    }
    const pb = path.join(tdir, "PLAYBOOK.md");
    if (fs.existsSync(pb)) {
      const t = fs.readFileSync(pb, "utf8");
      if (/\[UNCONFIRMED\]/.test(t)) add("warn", `${tag}: PLAYBOOK.md still has ${(t.match(/\[UNCONFIRMED\]/g) || []).length} [UNCONFIRMED] line(s)`);
      if (!/^## Definition of done/m.test(t)) add("error", `${tag}: PLAYBOOK.md has no "Definition of done" section`);
      else {
        // Rows of the Definition-of-done table: the last column says who enforces the check. Only the
        // self-verification command is enforced by the gate; "agent-reported" rows are a sentence in a report.
        const dod = t.replace(/\r\n/g, "\n").match(/^## Definition of done[\s\S]*?(?=^## |(?![\s\S]))/m)[0];
        const rows = dod.split("\n").filter((l) => /^\|/.test(l) && !/^\|\s*(#|-+)/.test(l) && !/^\|[-\s|:]+\|?$/.test(l));
        const cells = (l) => l.split("|").map((c) => c.trim()).filter((c, i, arr) => !(c === "" && (i === 0 || i === arr.length - 1)));
        const reported = rows.filter((l) => /agent-reported/i.test(cells(l).slice(-1)[0] || "")).length;
        if (rows.length >= 3 && reported >= 3 && reported / rows.length > 0.5) {
          add("warn", `${tag}: ${reported} of ${rows.length} Definition-of-done checks are only agent-reported — move the ones that can be commands into files/checks.sh (assets/checks.sh.template) and call it from selfVerification so the gate enforces them`);
        }
        const checksFile = path.join(tdir, "files", "checks.sh");
        if (fs.existsSync(checksFile) && !/checks\.sh/.test(a.selfVerification || "")) add("warn", `${tag}: files/checks.sh exists but selfVerification never runs it, so the gate does not enforce it`);
      }
    }
  }
  for (const f of ownershipFit(roster)) add(f.level, f.msg);
  if (roster.auditPatterns !== undefined && !Array.isArray(roster.auditPatterns)) add("error", `roster "auditPatterns" must be a list of { name, match, coverage }`);
  for (const [i, p] of (Array.isArray(roster.auditPatterns) ? roster.auditPatterns : []).entries()) {
    if (!p || typeof p.name !== "string" || typeof p.match !== "string") add("error", `auditPatterns[${i}] needs a string "name" and a string "match" regex`);
    else {
      try {
        new RegExp(p.match);
      } catch (e) {
        add("error", `auditPatterns[${i}] ("${p.name}"): "match" is not a valid regex: ${e.message}`);
      }
      if (!p.coverage) add("warn", `auditPatterns "${p.name}" has no "coverage": say what proves every instance follows the pattern (a test that fails on a route without it, a grep that must come back empty), or a regex alone decides what is mechanical`);
      if (p.match.length < 6 || /^\.\*|\|\.\*|^\(\?:\.\*\)/.test(p.match)) add("warn", `auditPatterns "${p.name}": the match regex looks too loose; a pattern that accepts most lines hides real logic changes in a "light" audit`);
    }
  }
  const activeAgents = (roster.agents || []).filter((x) => !x.dormant).length;
  if (activeAgents > 5) add("info", `${activeAgents} active agents: each adds a playbook, context and hand-offs, and a scaling study found multi-agent coordination costs 39–70% on sequential work. Check \`orchestrator.mjs usage\` and mark agents that barely run "dormant": true`);

  // (7) A playbook, tiers and guards are all unproven until measured. Evals are the measurement.
  const evalDir = path.join(TEAM_DIR, "evals");
  const tasksFile = path.join(evalDir, "tasks.json");
  if (!fs.existsSync(tasksFile)) {
    add("info", "no evals configured (.agent-team/evals/tasks.json) — nothing here is measured; see SKILL.md step 11");
  } else {
    let dispatchTasks = 0;
    try {
      dispatchTasks = (readJson(tasksFile).tasks || []).filter((x) => x.kind === "dispatch").length;
    } catch {
      add("error", "evals/tasks.json is not valid JSON");
    }
    const results = fs.readdirSync(evalDir).filter((f) => /^results-.*\.json$/.test(f));
    if (dispatchTasks === 0) add("info", "evals: only routing tasks (no kind: dispatch), so whether agents produce correct work is unmeasured — add tasks drawn from real failures");
    else if (dispatchTasks > 0 && !results.length) add("warn", `evals: ${dispatchTasks} dispatch task(s) defined but no results file — the playbook and tiers have never been measured (run: node .agent-team/evals/run.mjs dispatch --yes --k 3, then again with --baseline)`);
    else if (results.length && !results.some((f) => /baseline/.test(f))) add("info", "evals: no --baseline (playbook off) run recorded, so the playbook's effect is not measured");
  }

  // (8) One place for lessons. Two (a per-agent notes.md and a project-level lessons file) means neither gets used.
  const lessonsRel = roster.lessonsFile || (fs.existsSync(path.join(ROOT, "lessons.md")) ? "lessons.md" : null);
  if (roster.lessonsFile && !fs.existsSync(path.join(ROOT, roster.lessonsFile))) add("error", `lessonsFile "${roster.lessonsFile}" does not exist`);
  if (lessonsRel && fs.existsSync(path.join(ROOT, lessonsRel))) {
    const emptyNotes = (roster.agents || []).filter((x) => {
      const n = path.join(TEAM_DIR, "tentacles", x.name, "notes.md");
      return fs.existsSync(n) && fs.readFileSync(n, "utf8").split(/\r?\n/).filter((l) => l.trim() && !/^#/.test(l.trim())).length === 0;
    });
    if (!roster.lessonsFile && emptyNotes.length >= Math.ceil((roster.agents || []).length / 2)) {
      add("warn", `corrections are logged in two places: ${lessonsRel} holds lessons while ${emptyNotes.length} agent notes.md files are empty. Pick one — set "lessonsFile": "${lessonsRel}" in roster.json to make it the single correction log (the AGENTS.md loop writes there), or delete the unused notes.md files`);
    }
  }

  const sensPath = path.join(ROOT, ".claude", "security-sensitive-paths.txt");
  if (fs.existsSync(sensPath)) {
    for (const [i, raw] of fs.readFileSync(sensPath, "utf8").split(/\r?\n/).entries()) {
      const l = raw.trim();
      if (!l || l.startsWith("#")) continue;
      if (/^<[^>]*>$/.test(l)) add("error", `security-sensitive-paths.txt line ${i + 1} is still a template placeholder: ${l}`);
      else {
        try {
          new RegExp(l.replace(/^[?!]/, ""));
        } catch (e) {
          add("error", `security-sensitive-paths.txt line ${i + 1} is not a valid regex: ${e.message}`);
        }
      }
    }
  } else if (roster.securityAgent) {
    add("warn", "roster has a securityAgent but no .claude/security-sensitive-paths.txt — falling back to roster.securitySensitivePaths globs (the commit-time hook reads the .txt, so the two can disagree)");
  }
  if (roster.featureList && !fs.existsSync(path.join(ROOT, roster.featureList))) add("error", `featureList "${roster.featureList}" does not exist`);
  return findings;
}

// A worker is not required to commit, and `git merge` only carries commits. Without this step a
// worktree whose worker left its edits uncommitted merges as "Already up to date" and the work is
// discarded when the worktree is removed. In the shared workspace the orchestrator only commits if
// the tree was clean when the dispatch began, so it never sweeps up someone else's uncommitted work.
function commitWork(cwd, agent, taskText, { skipHooks = false } = {}) {
  const git = (...a) => spawnSync("git", a, { cwd, encoding: "utf8" });
  // Never sweep the orchestrator's own runtime files into a commit, whether or not .gitignore lists them.
  const exclude = RUNTIME_PATHS.map((g) => `:(exclude,glob)${g}`);
  if (git("add", "-A", "--", ".", ...exclude).status !== 0) return { ok: false, output: "git add failed" };
  if (git("diff", "--cached", "--quiet").status === 0) return { ok: true, committed: false };
  const subject = `team(${agent.name}): ${taskText.split(/\r?\n/)[0].slice(0, 72)}`;
  const r = skipHooks ? git("commit", "--no-verify", "-m", subject) : git("commit", "-m", subject);
  return r.status === 0 ? { ok: true, committed: true } : { ok: false, output: (r.stdout || "") + (r.stderr || "") };
}

// Budget: `--max-budget-usd` exists on `claude -p` (confirmed against --help); other providers have
// no equivalent, so the cap is only enforced where providers.json declares a `budgetFlag`, and the
// gap is logged rather than silently ignored.
function dispatchArgs(agent, providers, roster, tier, effort) {
  const p = providers[agent.provider];
  const args = providerArgs(p, tier, effort);
  const budget = agent.maxBudgetUsd ?? (roster.defaults && roster.defaults.maxBudgetUsd);
  if (budget != null) {
    if (!Number.isFinite(Number(budget)) || Number(budget) <= 0) throw new Error(`maxBudgetUsd must be a positive number, got "${budget}"`);
    if (p.budgetFlag) args.push(p.budgetFlag, String(Number(budget)));
    else logEvent("budget_unenforced", { agent: agent.name, provider: agent.provider });
  }
  return args;
}

async function dispatchOnce(agent, taskText, providers, roster, { worktree, tier, effort } = {}) {
  const early = (blocked, extra = {}) => ({ pass: false, blocked, cwd: ROOT, branch: null, ...extra });

  if (stopRequested()) {
    logEvent("stopped", { agent: agent.name, where: "before-dispatch" });
    return early("STOP file present (.agent-team/STOP) — run `node .agent-team/orchestrator.mjs resume` to continue", { deferred: true });
  }

  // Protected files are checked BEFORE anything is spent: a previous worker, a merge, or a person
  // may have changed the gate's own config since it was sealed.
  const pre = verifyIntegrity(ROOT, roster);
  if (!pre.sealed) console.log("orchestrator: warning — project is not sealed, so edits to the gate config are not detected. Run `orchestrator.mjs seal`.");
  if (pre.problems.length) {
    logEvent("integrity_violation", { agent: agent.name, phase: "pre", problems: pre.problems.slice(0, 20) });
    return early(`protected files differ from the sealed manifest:\n  ${pre.problems.join("\n  ")}\nIf you changed them on purpose, review the diff and run: node .agent-team/orchestrator.mjs seal`);
  }

  // Quota is checked before creating a worktree so a deferred item never pays setup cost. A failed
  // quota check (reliable: false) is treated exactly like no check happened.
  const quota = await checkQuota(agent.provider);
  if (quota.reliable && quota.percent >= QUOTA_HARD_THRESHOLD) {
    const resetNote = quota.resetsAt ? ` — resets ~${new Date(quota.resetsAt).toISOString()}` : "";
    logEvent("deferred", { agent: agent.name, provider: agent.provider, reason: "quota", percent: quota.percent });
    return early(`${agent.provider} usage at ${quota.percent}% (>= ${QUOTA_HARD_THRESHOLD}% hard limit)${resetNote} — deferring, no new token-consuming dispatch starts until the window resets`, { deferred: true });
  }
  if (quota.reliable && quota.percent >= QUOTA_SOFT_THRESHOLD) {
    console.log(`orchestrator: ${agent.provider} usage at ${quota.percent}% — inside the ${QUOTA_SOFT_THRESHOLD}-${QUOTA_HARD_THRESHOLD}% emergency band, proceeding anyway`);
  }

  let cwd = ROOT;
  let branch = null;
  // The commit the worker starts from: the security gate checks base...HEAD.
  const base = spawnSync("git", ["rev-parse", "HEAD"], { cwd: ROOT, encoding: "utf8" }).stdout.trim();
  if (worktree || agent.worktree) {
    const id = `${agent.name}-${Date.now()}`;
    branch = `team/${id}`;
    cwd = path.join(TEAM_DIR, "worktrees", id);
    fs.mkdirSync(path.dirname(cwd), { recursive: true });
    try {
      await execFileP("git", ["worktree", "add", cwd, "-b", branch], { cwd: ROOT });
    } catch (e) {
      // Reported, not thrown: an uncaught rejection kills the whole run with a stack trace and no
      // queue update. Windows path-length limits are the usual cause on repos with deep generated
      // paths (REFERENCE.md, worktree failure mode 3) — seen again in a live run.
      const long = /Filename too long/i.test(String(e.message));
      logEvent("worktree_failed", { agent: agent.name, longPath: long });
      fs.rmSync(cwd, { recursive: true, force: true }); // a failed add can leave a half-created directory
      spawnSync("git", ["worktree", "prune"], { cwd: ROOT });
      spawnSync("git", ["branch", "-D", branch], { cwd: ROOT });
      return early(`could not create the worktree${long ? " — a path inside it exceeds the OS path-length limit. Keep the repo checkout path short, or run `git config core.longpaths true` (Windows)" : ""}:\n${trimOutput(String(e.message))}`);
    }
    if (agent.setupCommand) {
      // A fresh worktree only has tracked files — gitignored dependency directories (vendor/,
      // node_modules/) don't exist until something installs them here. Verified live: a Composer
      // project's self-verification failed with "no such file or directory" for vendor/bin/phpunit
      // in a brand-new worktree until this ran once.
      const setup = runSelfVerification(agent.setupCommand, cwd, agent.shell);
      if (!setup.pass) {
        return { pass: false, blocked: `worktree setup command failed:\n${trimOutput(setup.output)}`, cwd, branch };
      }
    }
  }

  const startedClean = !branch && isTreeClean().clean;
  const baseSha = gitHead(cwd);
  logEvent("dispatch_start", { agent: agent.name, provider: agent.provider, worktree: Boolean(branch), baseSha });

  let priorFailure = null;
  const startTier = tier || agent.tier;
  const startEffort = effort || agent.effort;
  const tiersTried = [];
  const stepsTried = [];
  const startedAt = Date.now();
  const finish = (outcome) => {
    logDispatch({ agent: agent.name, provider: agent.provider, tiersTried, efforts: stepsTried.map((x) => x.effort || null), startTier: startTier || null, attempts: tiersTried.length, pass: Boolean(outcome.pass), deferred: Boolean(outcome.deferred), ms: Date.now() - startedAt, taskWords: wordHashes(taskText), blocked: outcome.pass ? undefined : String(outcome.blocked || "").slice(0, 200) });
    return outcome;
  };
  for (let attempt = 1; attempt <= SELF_VERIFY_ATTEMPT_BUDGET; attempt++) {
    if (stopRequested()) {
      logEvent("stopped", { agent: agent.name, where: "between-attempts" });
      return finish({ pass: false, deferred: true, blocked: "STOP file present — halted between attempts", cwd, branch });
    }
    const prompt = buildPrompt(agent, taskText, priorFailure, roster);
    const step = stepForAttempt(startTier, startEffort, attempt, agent.escalateOnFail, providers[agent.provider], roster.escalateEffortFirst !== false);
    const attemptTier = step.tier;
    tiersTried.push(attemptTier || "cli-default");
    stepsTried.push(step);
    const started = Date.now();
    const result = await invokeProvider(agent.provider, providers, prompt, cwd, { args: dispatchArgs(agent, providers, roster, attemptTier, step.effort), watchStop: true });
    logEvent("attempt", { agent: agent.name, provider: agent.provider, attempt, tier: attemptTier || "cli-default", effort: step.effort || null, ok: result.ok, ms: Date.now() - started, bytes: result.output.length, timedOut: Boolean(result.timedOut), stopped: Boolean(result.stopped) });
    if (result.stopped) return finish({ pass: false, deferred: true, blocked: "STOP file present — worker killed", cwd, branch });
    if (isUsageLimitHit(agent.provider, providers, result.output)) {
      logEvent("deferred", { agent: agent.name, provider: agent.provider, reason: "usage-limit" });
      return finish({
        pass: false,
        deferred: true,
        blocked: `${agent.provider} usage limit reached — deferring to the next scheduled firing instead of burning a self-verification attempt:\n${trimOutput(result.output)}`,
        cwd,
        branch,
      });
    }
    if (!result.ok) {
      priorFailure = `Provider exited abnormally${result.timedOut ? " (timed out — possible stuck/looping worker, killed)" : ""}:\n${result.output}`;
      continue;
    }

    // Protected-file tamper is NOT retried: an agent that edited its own gate config is not
    // something to hand back "fix it" — the worktree is preserved for a human to inspect.
    const post = verifyIntegrity(cwd, roster, { lenient: cwd !== ROOT });
    if (post.problems.length) {
      logEvent("integrity_violation", { agent: agent.name, phase: "post", problems: post.problems.slice(0, 20) });
      return finish({ pass: false, blocked: `the worker changed protected files (gate config, hooks, agent files or playbooks):\n  ${post.problems.join("\n  ")}\nNothing was merged.`, cwd, branch });
    }

    const tamper = [...checkOwnership(cwd, baseSha, agent, roster), ...checkTestTamper(cwd, baseSha, roster, taskText), ...checkFeatureList(cwd, baseSha, roster)];
    if (tamper.length) {
      logEvent("tamper", { agent: agent.name, attempt, problems: tamper });
      priorFailure = `Rejected before verification:\n- ${tamper.join("\n- ")}\nRevert anything outside your ownership, restore any tests or feature entries, and fix the actual code instead of weakening the checks.`;
      continue;
    }

    const check = runSelfVerification(agent.selfVerification, cwd, agent.shell);
    logEvent("self_verification", { agent: agent.name, attempt, pass: check.pass });
    if (check.pass) {
      const ver = await runVerifier(agent, taskText, cwd, baseSha, providers, result.output);
      if (ver.verdict === "FAIL") {
        priorFailure = `The independent reviewer rejected this change even though the self-verification command passed:\n${ver.reason}`;
        continue;
      }
      // Commit, then gate base...HEAD with the project's own security-gate script in range mode.
      // Worktree mode commits on the worker's branch with hooks skipped, because the range gate
      // right below runs the same script on that commit. Shared-workspace mode commits on the
      // real branch only if the tree was clean when the dispatch began, and keeps the git hooks,
      // so the pre-commit gate stops a sensitive change before it lands.
      if (branch || startedClean) {
        const c = commitWork(cwd, agent, taskText, { skipHooks: Boolean(branch) });
        if (!c.ok) return finish({ pass: false, blocked: `could not commit the worker's changes (a git hook, the security gate or an identity problem?):\n${trimOutput(c.output)}`, cwd, branch });
        if (c.committed) logEvent("committed", { agent: agent.name });
      }
      const gate = runSecurityGate(cwd, base, "HEAD", roster);
      if (!gate.pass) {
        logEvent("security_gate", { agent: agent.name, pass: false });
        return finish({ pass: false, blocked: `security gate blocked this change before merge:\n${trimOutput(gate.output)}`, cwd, branch });
      }
      return finish({ pass: true, cwd, branch, attempts: attempt, tiersTried });
    }
    priorFailure = check.output;
  }
  logEvent("blocked", { agent: agent.name, reason: "attempt-budget" });
  return finish({ pass: false, blocked: `self-verification failed after ${SELF_VERIFY_ATTEMPT_BUDGET} attempts (tiers: ${tiersTried.join(" -> ")}):
${trimOutput(priorFailure)}`, cwd, branch });
}

// Returns what happened so the caller can report it accurately:
//   { merged: true }                          merged, integration check (if any) passed
//   { manual: true }                          mergePolicy "manual": branch and worktree left for a human
//   { integrationFailed, detail, rolledBack } merged, then the whole-repo check failed
// `allowReset` is true only when the caller knows the tree was clean before the merge, so undoing the
// merge commit cannot throw away anyone's uncommitted work.
async function finishMerge(result, roster, agent, { allowReset }) {
  if (result.branch && agent.mergePolicy === "manual") {
    logEvent("merge_held", { agent: agent.name, branch: result.branch });
    return { manual: true };
  }
  let preSha = null;
  if (result.branch) {
    preSha = gitHead(ROOT);
    await execFileP("git", ["merge", "--no-ff", result.branch], { cwd: ROOT });
    logEvent("merge", { agent: agent.name, branch: result.branch });
  }
  // Each agent's own check proves its layer; this proves the layers still work TOGETHER. A clean
  // merge says nothing about integration — in the 33,596-PR study, zero textual conflicts still
  // left hours of debugging.
  if (roster.integrationCheck) {
    const chk = runSelfVerification(roster.integrationCheck, ROOT, roster.integrationShell);
    logEvent("integration_check", { agent: agent.name, pass: chk.pass });
    if (!chk.pass) {
      const rolledBack = Boolean(preSha && allowReset && spawnSync("git", ["reset", "--hard", preSha], { cwd: ROOT }).status === 0);
      return { integrationFailed: true, detail: trimOutput(chk.output) || "(the check printed nothing)", rolledBack };
    }
  }
  if (result.branch) await execFileP("git", ["worktree", "remove", result.cwd, "--force"], { cwd: ROOT });
  return { merged: true };
}

async function runPhase() {
  const { clean, reason } = isTreeClean();
  if (!clean) {
    console.log(`orchestrator: dirty tree (${reason || "uncommitted changes"}) — a live session or a prior run is mid-phase, skipping this firing`);
    return;
  }
  const roster = readJson(ROSTER_PATH);
  const providers = readJson(PROVIDERS_PATH);
  const statusContent = readStatusFile();
  const items = parseQueue(statusContent);
  const item = nextQueueItem(items);
  if (!item) {
    console.log("orchestrator: queue empty, nothing to do");
    return;
  }
  let agent;
  try {
    agent = resolveAgent(roster, item);
  } catch (e) {
    writeStatusFile(markItemBlocked(statusContent, item.lineIndex, e.message));
    console.log(`orchestrator: blocked — ${e.message}`);
    return;
  }
  console.log(`orchestrator: dispatching ${agent.name} (${agent.provider}) on: ${item.text}`);
  // Opt-in cheap start: only for an agent with "autoTier": true, only when the item carries no [tier:x] of its own,
  // and only downward (to light). A failed check still escalates.
  let startTier = item.tier;
  let startEffort = item.effort;
  if (!startTier && agent.autoTier) {
    const sug = suggestTier(item.text);
    const learned = sug.tier === "light" ? learnedTier(item.text, sug) : null;
    if (learned) logEvent("auto_tier_skipped", { agent: agent.name, why: learned.why });
    if (sug.tier === "light" && !learned) {
      startTier = "light";
      if (!startEffort && !agent.effort) startEffort = sug.effort;
      logEvent("auto_tier", { agent: agent.name, tier: "light", effort: startEffort || null, why: sug.why });
    }
  }
  const result = await dispatchOnce(agent, item.text, providers, roster, { tier: startTier, effort: startEffort });
  if (result.pass) {
    const fin = await finishMerge(result, roster, agent, { allowReset: true });
    if (fin.manual) {
      writeStatusFile(markItemBlocked(statusContent, item.lineIndex, `awaiting human merge of branch ${result.branch} (mergePolicy "manual"); worktree at ${result.cwd}`));
      console.log(`orchestrator: ${agent.name} passed; mergePolicy is manual — branch ${result.branch} left for review at ${result.cwd}`);
    } else if (fin.integrationFailed) {
      const note = `integration check failed after merge${fin.rolledBack ? " (merge rolled back)" : " (NOT rolled back)"}: ${fin.detail}`;
      writeStatusFile(markItemBlocked(statusContent, item.lineIndex, note));
      console.log(`orchestrator: blocked — ${note}`);
    } else {
      writeStatusFile(markItemDone(statusContent, item.lineIndex));
      console.log(`orchestrator: done in ${result.attempts} attempt(s), tiers ${result.tiersTried.join(" -> ")}`);
    }
  } else if (result.deferred) {
    // STATUS.md is intentionally left untouched — same item, same unblocked state, so the next
    // scheduled firing picks it up as a fresh attempt.
    console.log(`orchestrator: deferred — ${result.blocked}`);
  } else {
    writeStatusFile(markItemBlocked(statusContent, item.lineIndex, result.blocked));
    console.log(`orchestrator: blocked — ${result.blocked}`);
  }
  // One phase per firing, then stop — never let one unattended run try to clear the whole queue.
}

async function spawnAdHoc(agentName, taskText, opts) {
  const roster = readJson(ROSTER_PATH);
  const providers = readJson(PROVIDERS_PATH);
  const found = roster.agents.find((a) => a.name === agentName);
  if (!found) throw new Error(`unknown agent "${agentName}" — check roster.json`);
  // --no-escalate pins every attempt to the starting tier. A fair model comparison needs it: otherwise a failing
  // small-model run quietly retries on a bigger one and the difference disappears.
  const agent = opts.noEscalate ? { ...found, escalateOnFail: false } : found;
  const treeWasClean = isTreeClean().clean;
  const result = await dispatchOnce(agent, taskText, providers, roster, opts);
  if (result.pass) {
    if (opts.noMerge) {
      console.log(`spawn: ${agentName} done in ${result.attempts} attempt(s) — --no-merge set, worktree preserved at ${result.cwd} on branch ${result.branch} for inspection, not merged`);
      return;
    }
    const fin = await finishMerge(result, roster, agent, { allowReset: treeWasClean });
    if (fin.manual) console.log(`spawn: ${agentName} passed; mergePolicy is manual — branch ${result.branch} left for review at ${result.cwd}`);
    else if (fin.integrationFailed) console.log(`spawn: ${agentName} integration check failed${fin.rolledBack ? " (merge rolled back)" : " (NOT rolled back — the tree had uncommitted changes)"}:\n${fin.detail}`);
    else console.log(`spawn: ${agentName} done in ${result.attempts} attempt(s)`);
  } else if (result.deferred) {
    console.log(`spawn: ${agentName} deferred — ${result.blocked}`);
    if (result.branch) console.log(`worktree preserved at ${result.cwd} for inspection (not merged)`);
  } else {
    console.log(`spawn: ${agentName} blocked — ${result.blocked}`);
    if (result.branch) console.log(`worktree preserved at ${result.cwd} for inspection (not merged)`);
  }
}

function printStatus() {
  const roster = readJson(ROSTER_PATH);
  const items = parseQueue(readStatusFile());
  const done = items.filter((i) => i.done).length;
  console.log(`${done}/${items.length} queue items done`);
  for (const i of items) {
    const mark = i.done ? "x" : i.blocked ? "!" : " ";
    console.log(`  [${mark}] ${i.agent ? `(${i.agent}) ` : ""}${i.text}`);
  }
  console.log(`agents: ${roster.agents.map((a) => `${a.name}(${a.provider})`).join(", ")}`);
}

// --- `ask` / adviseOnce — one text-only answer from one provider, for the llm-council skill and for
// the independent verifier. A council member or reviewer is an advisor, not a worker, so this
// deliberately does NOT use providers.json's `args` (which carry each CLI's no-approval / bypass
// flag so an unattended dispatch can edit files). It uses the provider's separate `adviceArgs`
// (read-only / no-tools) and REFUSES to run if a provider has none, rather than silently falling
// back to the write-capable flags. No git, no worktree, no self-verification: an answer is text,
// not a change. The prompt travels over stdin for the same reason as invokeProvider (a multi-line
// prompt as an argv string gets mangled by the shell).
// Result codes: 0 answered; 1 failed (message says why); 2 deferred by a usage limit or quota.
const COUNCIL_TIMEOUT_MS = 5 * 60 * 1000;

async function adviseOnce(providerName, providers, prompt, { model } = {}) {
  const fail = (message, code = 1) => ({ ok: false, code, message, answer: "" });
  const p = providers[providerName];
  if (!p || providerName.startsWith("_")) return fail(`no provider adapter named "${providerName}" in providers.json`);
  if (!Array.isArray(p.adviceArgs)) {
    return fail(`provider "${providerName}" has no "adviceArgs" in providers.json. Refusing to fall back to its dispatch args, which allow file edits.`);
  }
  const args = [];
  let outfile = null;
  for (const a of p.adviceArgs) {
    if (a === "{outfile}") {
      outfile = path.join(os.tmpdir(), `council-${process.pid}-${Date.now()}-${crypto.randomBytes(3).toString("hex")}.txt`);
      args.push(`"${outfile}"`);
    } else {
      args.push(a);
    }
  }
  if (model) {
    if (!p.modelFlag) return fail(`provider "${providerName}" has no "modelFlag" in providers.json, so a model cannot be passed`);
    if (!MODEL_ID_RE.test(model)) return fail(`model "${model}" contains characters outside [A-Za-z0-9._:/-]`);
    args.push(p.modelFlag, model);
  }
  const q = await checkQuota(providerName);
  if (q.reliable && q.percent >= QUOTA_HARD_THRESHOLD) {
    return fail(`${providerName} is at ${q.percent}% of its usage window (hard limit ${QUOTA_HARD_THRESHOLD}%)`, 2);
  }
  if (!prompt.trim()) return fail("empty prompt");

  const r = await invokeProvider(providerName, providers, prompt, ROOT, { args, timeoutMs: COUNCIL_TIMEOUT_MS });
  let answer = r.output;
  if (outfile) {
    // Some CLIs (codex) print a banner and an echo of the prompt around the answer; their own
    // "write the final message to a file" flag gives the answer alone.
    answer = fs.existsSync(outfile) ? fs.readFileSync(outfile, "utf8") : "";
    fs.rmSync(outfile, { force: true });
  }
  logEvent("advise", { provider: providerName, model: model || null, ok: r.ok, bytes: answer.length });
  if (!r.ok) {
    if (isUsageLimitHit(providerName, providers, r.output)) return fail(`${providerName} usage limit`, 2);
    return fail(`${r.timedOut ? "(timed out) " : ""}${trimOutput(r.output)}`);
  }
  if (!answer.trim()) return fail(`${providerName} returned no answer`);
  return { ok: true, code: 0, message: "", answer: answer.trim() };
}

async function askProvider(providerName, model) {
  const r = await adviseOnce(providerName, readJson(PROVIDERS_PATH), fs.readFileSync(0, "utf8"), { model });
  if (!r.ok) {
    console.error(`${r.code === 2 ? "DEFERRED" : "FAILED"}: ${r.message}`);
    process.exit(r.code);
  }
  process.stdout.write(r.answer + "\n");
}

// --- Operator commands --------------------------------------------------------
async function confirmSeal() {
  if (process.env.AGENT_TEAM_ALLOW_NONINTERACTIVE_SEAL === "1") return true; // CI and the test suite only
  if (!process.stdin.isTTY) {
    console.error("seal refused: it needs a person at an interactive terminal. A worker's shell has no TTY, so a worker cannot re-seal its own changes.");
    return false;
  }
  const rl = (await import("node:readline")).createInterface({ input: process.stdin, output: process.stdout });
  const answer = await new Promise((resolve) => rl.question("Review `git diff` of the protected files first. Type 'seal' to record them as trusted: ", resolve));
  rl.close();
  return answer.trim() === "seal";
}

function printIntegrity() {
  const roster = fs.existsSync(ROSTER_PATH) ? readJson(ROSTER_PATH) : {};
  const v = verifyIntegrity(ROOT, roster);
  if (!v.sealed) {
    console.log("not sealed — run `node .agent-team/orchestrator.mjs seal`");
    return 0;
  }
  if (!v.problems.length) {
    console.log(`integrity ok (${Object.keys(computeManifest(ROOT, roster)).length} protected files match the seal)`);
    return 0;
  }
  console.log("integrity FAILED:\n  " + v.problems.join("\n  "));
  return 1;
}

function printLog(n) {
  if (!fs.existsSync(EVENTS_PATH)) return console.log("no events recorded yet");
  const lines = fs.readFileSync(EVENTS_PATH, "utf8").split("\n").filter(Boolean);
  for (const l of lines.slice(-n)) console.log(l);
}

// =====================================================================================================
// Interactive-path hooks: `orchestrator.mjs hook <SubagentStart|PreToolUse|SubagentStop>`
// =====================================================================================================
// Everything above guards the HEADLESS path (run-phase / spawn). When a person works in a live Claude Code
// session, subagents are dispatched through the Agent tool and none of those guards run. Measured on a real
// project's transcripts: only a quarter of specialist runs ever opened their PLAYBOOK, a quarter followed its
// report format, and 27% of dispatches asked for a more expensive model than the agent file declares. A rule
// written in a file the agent must go and open is mostly not followed; a rule already in its context is.
// So these hooks put the rules IN CONTEXT and enforce them at the moment they matter:
//
//   SubagentStart   inject the agent's playbook digest (Definition of done + decisions + edge cases) as context
//   PreToolUse      Agent|Task: log every dispatch, flag/stop an upward model override without a stated reason
//                   Write|Edit|...: inside a subagent, refuse writes to protected files and outside its ownership
//   SubagentStop    log tokens/turns/models from the subagent's transcript (per-agent usage), and send the agent
//                   back ONCE if its final report lacks the playbook's CHECKS / UNVERIFIED block
//
// Verified payloads (Claude Code 2.1.207, captured from a real subagent run): PreToolUse(Agent) has
// tool_input.{subagent_type,model,prompt}; subagent-scoped hooks carry agent_id + agent_type; SubagentStop has
// agent_transcript_path + last_assistant_message + stop_hook_active; SubagentStart's
// hookSpecificOutput.additionalContext reaches the subagent's context.
// Every internal error fails OPEN (exit 0). Only a deliberate block exits 2. Policies live in roster.json:
//   modelPolicy      "warn"(default) | "enforce" | "off"     reportPolicy    "enforce"(default) | "warn" | "off"
//   ownershipPolicy  "enforce"(default) | "warn" | "off"     protectedPolicy "enforce"(default) | "warn" | "off"
//   tamperPolicy     "warn"(default) | "enforce" | "off"     playbookDigestLines (default 80)
// Families, cheapest to dearest. Fable is the top tier AND draws on its own usage-credit pool (a run on an account
// without credits fails outright), so it is only ever opt-in. Versions do not matter here: "claude-opus-4-6" and
// "opus" are the same family; pin a full id only when reproducibility matters.
const MODEL_RANK = { haiku: 1, sonnet: 2, opus: 3, fable: 4 };
const modelRank = (n) => {
  const m = String(n || "").toLowerCase().match(/haiku|sonnet|opus|fable/);
  return m ? MODEL_RANK[m[0]] : 0;
};

function extractSection(text, heading) {
  const re = new RegExp("^## " + heading + "[\\s\\S]*?(?=^## |(?![\\s\\S]))", "m");
  const m = text.replace(/\r\n/g, "\n").match(re);
  return m ? m[0].trim() : "";
}

function playbookDigest(name, roster) {
  if (process.env.AGENT_TEAM_NO_PLAYBOOK === "1") return null; // A/B evals: same task without the playbook
  const p = path.join(TEAM_DIR, "tentacles", name, "PLAYBOOK.md");
  if (!fs.existsSync(p)) return null;
  const text = fs.readFileSync(p, "utf8");
  const parts = ["Definition of done", "Decisions", "Edge cases"].map((h) => extractSection(text, h)).filter(Boolean);
  if (!parts.length) return null;
  const max = Number(roster.playbookDigestLines) || 80;
  let body = parts.join("\n\n").split("\n");
  if (body.length > max) body = [...body.slice(0, max), `… (truncated; the full playbook is .agent-team/tentacles/${name}/PLAYBOOK.md)`];
  return [
    `## Your playbook (injected by the orchestrator; source: .agent-team/tentacles/${name}/PLAYBOOK.md)`,
    'Follow it. End your final report with the CHECKS / UNVERIFIED block described under "Definition of done"; a report without it is sent back once.',
    "",
    body.join("\n"),
  ].join("\n");
}

// Every turn re-reads the whole conversation, so a run costs roughly (turns x context). A measured project made one
// tool call in 91% of its turns and ran audits of 100 turns at 150k+ tokens of context. Three lines in each subagent's
// context are the cheapest lever there is: batch independent calls, read slices, and hand off instead of grinding on.
// roster "economyHint": false turns it off; "turnBudget": N changes the 60 (0 drops that line).
function economyHint(roster) {
  if (process.env.AGENT_TEAM_NO_PLAYBOOK === "1" || roster.economyHint === false) return null;
  const budget = roster.turnBudget === undefined ? 60 : Number(roster.turnBudget);
  return [
    "## Working economy",
    "Every turn re-reads this whole conversation, so fewer, fuller turns cost less.",
    "- Put independent reads, searches and checks in the SAME turn (several tool calls in one message), not one call per turn.",
    "- Read the slice you need (a line range, `grep -n`, `git diff --stat` before `git diff`), not whole files or whole logs.",
    ...(Number.isFinite(budget) && budget > 0 ? [`- Aim to finish within about ${budget} turns. If the task is bigger, stop at a clean point and report what is left, so the next run starts with a small context.`] : []),
  ].join("\n");
}

function declaredModelFor(type, roster) {
  const f = path.join(ROOT, ".claude", "agents", `${type}.md`);
  if (fs.existsSync(f)) {
    const fm = parseFrontmatter(fs.readFileSync(f, "utf8"));
    if (fm && fm.model) return fm.model;
  }
  const a = (roster.agents || []).find((x) => x.name === type);
  if (a && a.tier && fs.existsSync(PROVIDERS_PATH)) {
    const t = readJson(PROVIDERS_PATH)[a.provider];
    if (t && t.tiers && t.tiers[a.tier]) return t.tiers[a.tier];
  }
  return null;
}

// Canonical form of a path that may not exist yet (a Write creates it): resolve the deepest existing ancestor with
// realpath.native and re-append the rest. Needed because Windows has two spellings of one directory (8.3 short
// "C:\\Users\\RUNNER~1\\…" and long); a hook payload carries one, git reports the other, and comparing them as
// strings made every write look "outside the project" and so allowed. (Found by CI on a Windows runner.)
function canonPath(p) {
  const abs = path.resolve(p);
  const rest = [];
  let cur = abs;
  while (true) {
    try {
      return path.join(fs.realpathSync.native(cur), ...rest.reverse());
    } catch {
      const parent = path.dirname(cur);
      if (parent === cur) return abs;
      rest.push(path.basename(cur));
      cur = parent;
    }
  }
}

function checkoutTop(cwd) {
  const r = spawnSync("git", ["rev-parse", "--show-toplevel"], { cwd: cwd || ROOT, encoding: "utf8" });
  return canonPath(r.status === 0 && r.stdout.trim() ? r.stdout.trim() : ROOT);
}
// The checkout (main tree or linked worktree of THIS repository) that actually contains `abs`, or null. The hook payload's
// cwd is not always the checkout the file is in: a subagent in `.claude/worktrees/<id>/` can report the main root as cwd,
// and judging its path against that root made every owned file look like `.claude/worktrees/<id>/src/...`, outside the
// agent's ownership. A different repository (a nested clone) does not qualify.
const gitCommonDir = (dir) => {
  const r = spawnSync("git", ["rev-parse", "--show-toplevel", "--git-common-dir"], { cwd: dir, encoding: "utf8" });
  const [top, common] = r.status === 0 ? r.stdout.split(/\r?\n/) : [];
  return top && common ? { top: canonPath(top), common: canonPath(path.resolve(dir, common)) } : null;
};
function checkoutContaining(abs) {
  let dir = path.dirname(abs);
  while (!(fs.existsSync(dir) && fs.statSync(dir).isDirectory())) {
    const parent = path.dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
  const here = gitCommonDir(dir);
  const mine = gitCommonDir(ROOT);
  return here && mine && here.common === mine.common ? here.top : null;
}
// A subagent running in an isolated worktree writes under that checkout, not under ROOT, so a path is made
// relative to the top level of the checkout that holds the file (falling back to the one the call came from).
// Outside every checkout of this repository: not ours to police.
function relToRoot(p, cwd) {
  if (!p) return null;
  const abs = canonPath(path.isAbsolute(p) ? p : path.join(cwd || ROOT, p));
  const top = checkoutContaining(abs) || checkoutTop(cwd);
  const rel = path.relative(top, abs).split(path.sep).join("/");
  return rel.startsWith("..") || path.isAbsolute(rel) ? null : rel;
}

function hookStatePath() {
  return path.join(os.tmpdir(), "agent-team-hooks", crypto.createHash("sha1").update(canonicalRoot()).digest("hex") + ".json");
}
function readHookState() {
  try {
    return JSON.parse(fs.readFileSync(hookStatePath(), "utf8"));
  } catch {
    return {};
  }
}
function writeHookState(s) {
  try {
    fs.mkdirSync(path.dirname(hookStatePath()), { recursive: true });
    fs.writeFileSync(hookStatePath(), JSON.stringify(s));
  } catch {
    /* best effort */
  }
}

// Token/turn/model totals for one transcript. Claude Code logs ONE assistant message on several lines (one per
// content block) and the usage on those lines is cumulative while streaming: the first line of a message can
// say output_tokens=6 and the last 501. So a message is counted ONCE, at its MAXIMUM usage. (Summing every
// line overstates; keeping the first line understates — both were tried on real transcripts.)
function summarizeTranscript(file) {
  const r = { turns: 0, out: 0, input: 0, cacheRead: 0, cacheCreate: 0, models: {}, first: null, last: null };
  if (!file || !fs.existsSync(file)) return r;
  const byId = new Map();
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line.includes('"usage"')) continue;
    let o;
    try {
      o = JSON.parse(line);
    } catch {
      continue;
    }
    const m = o.message;
    if (!m || !m.usage || m.model === "<synthetic>") continue;
    const id = m.id || o.uuid;
    const u = m.usage;
    const cur = byId.get(id) || { model: m.model, out: 0, input: 0, cacheRead: 0, cacheCreate: 0 };
    cur.out = Math.max(cur.out, u.output_tokens || 0);
    cur.input = Math.max(cur.input, u.input_tokens || 0);
    cur.cacheRead = Math.max(cur.cacheRead, u.cache_read_input_tokens || 0);
    cur.cacheCreate = Math.max(cur.cacheCreate, u.cache_creation_input_tokens || 0);
    byId.set(id, cur);
    if (o.timestamp) {
      if (!r.first || o.timestamp < r.first) r.first = o.timestamp;
      if (!r.last || o.timestamp > r.last) r.last = o.timestamp;
    }
  }
  for (const m of byId.values()) {
    r.turns++;
    r.out += m.out;
    r.input += m.input;
    r.cacheRead += m.cacheRead;
    r.cacheCreate += m.cacheCreate;
    if (m.model) r.models[m.model] = (r.models[m.model] || 0) + 1;
  }
  return r;
}

const policyOf = (roster, key, dflt) => {
  const v = roster[key];
  return ["off", "warn", "enforce"].includes(v) ? v : dflt;
};

const WRITE_TOOLS = /^(Write|Edit|MultiEdit|NotebookEdit)$/;

// fs.readFileSync(0) throws EOF on a Windows pipe from some shells (found by piping a payload in from Git Bash,
// which silently produced an EMPTY payload and a hook that allowed everything). Read the stream instead.
async function readStdinText() {
  if (process.stdin.isTTY) return "";
  const chunks = [];
  for await (const c of process.stdin) chunks.push(c);
  return Buffer.concat(chunks).toString("utf8");
}

async function runHook(event) {
  let payload = {};
  try {
    payload = JSON.parse((await readStdinText()) || "{}");
  } catch {
    logEvent("hook_error", { event, message: "stdin was not valid JSON" });
  }
  if (!fs.existsSync(ROSTER_PATH)) return 0;
  const roster = readJson(ROSTER_PATH);
  const type = payload.agent_type;
  const agent = type ? (roster.agents || []).find((a) => a.name === type) : null;
  const block = (msg) => {
    console.error(msg);
    return 2;
  };

  if (event === "SubagentStart") {
    if (!agent) return 0;
    const head = gitHead(ROOT);
    const st = readHookState();
    const tamperBase = head && roster.testTamperGuard !== false && policyOf(roster, "tamperPolicy", "warn") !== "off" ? testChangeStats(ROOT, head, roster) : null;
    st[payload.agent_id || type] = { agent: agent.name, head, at: Date.now(), tamperBase };
    writeHookState(st);
    const digest = [playbookDigest(agent.name, roster), economyHint(roster)].filter(Boolean).join("\n\n");
    logEvent("subagent_start", { agent: agent.name, agentId: payload.agent_id, playbookBytes: digest ? digest.length : 0 });
    if (digest) process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: "SubagentStart", additionalContext: digest } }));
    return 0;
  }

  if (event === "PreToolUse") {
    const tool = payload.tool_name || "";
    const input = payload.tool_input || {};
    if (tool === "Agent" || tool === "Task") {
      const t = input.subagent_type || "(default)";
      const declared = declaredModelFor(t, roster);
      const requested = input.model || null;
      const up = Boolean(declared && requested && modelRank(requested) > modelRank(declared));
      const justified = /\[escalate:\s*[^\]]+\]/i.test(String(input.prompt || ""));
      const policy = policyOf(roster, "modelPolicy", "warn");
      logEvent("dispatch_request", { subagent: t, declared, requested, up, justified, background: Boolean(input.run_in_background) });
      if (up && !justified && policy === "enforce" && roster.agents.some((a) => a.name === t)) {
        return block(`Model override refused: ${t} is declared as "${declared}" but this dispatch asks for "${requested}". Re-dispatch without the model parameter (the agent's own model is the default). If a stronger model is genuinely needed, add "[escalate: <reason>]" to the task prompt (for example after a failed check) and say why.`);
      }
      return 0;
    }
    if (WRITE_TOOLS.test(tool) && agent) {
      const rel = relToRoot(input.file_path || input.notebook_path || input.path, payload.cwd);
      if (!rel) return 0;
      const protectedList = protectedFiles(ROOT, roster);
      const isProtected = protectedList.includes(rel) || PROTECTED_DIRS.some((d) => rel.startsWith(d + "/")) || /^\.agent-team\/tentacles\/[^/]+\/(PLAYBOOK|CONTEXT)\.md$/.test(rel) || rel === ".agent-team/integrity.json";
      const excluded = GATE_STATE_RE.test(rel) || (roster.integrityExclude || []).includes(rel);
      if (isProtected && !excluded) {
        const pol = policyOf(roster, "protectedPolicy", "enforce");
        logEvent("protected_write", { agent: agent.name, file: rel, policy: pol });
        if (pol === "enforce") return block(`${rel} is protected (gate config, hooks, agent definitions and playbooks are sealed). Do not edit it; describe the change you want in your final report and a person will apply and re-seal it.`);
        return 0;
      }
      if (ledgerForbidden(agent, roster, rel)) {
        const pol = policyOf(roster, "ownershipPolicy", "enforce");
        logEvent("ownership_violation", { agent: agent.name, file: rel, policy: pol });
        if (pol === "enforce") return block(`${rel} may only be changed by the security agent (${roster.securityAgent}): the security gate trusts it, so an agent must not write its own approval. Report what needs auditing instead.`);
      }
      if (roster.ownershipGuard !== false && agent.ownershipGuard !== false && (agent.ownership || []).length) {
        const allowed = [...agent.ownership, ...(roster.sharedPaths || []), ".claude/contracts/**", ...RUNTIME_PATHS].map(globToRegex);
        if (!allowed.some((re) => re.test(rel))) {
          const pol = policyOf(roster, "ownershipPolicy", "enforce");
          logEvent("ownership_violation", { agent: agent.name, file: rel, policy: pol });
          if (pol === "enforce") return block(`${rel} is outside ${agent.name}'s ownership (${agent.ownership.slice(0, 6).join(", ")}${agent.ownership.length > 6 ? ", …" : ""}). Do not change it. If the task needs it, stop and report "NEEDS <agent-name>: <what's needed>" in your final message.`);
        }
      }
    }
    return 0;
  }

  if (event === "SubagentStop") {
    const sum = summarizeTranscript(payload.agent_transcript_path);
    const ms = sum.first && sum.last ? Date.parse(sum.last) - Date.parse(sum.first) : null;
    logEvent("subagent_stop", { agent: type || "(unknown)", agentId: payload.agent_id, turns: sum.turns, outTokens: sum.out, inTokens: sum.input, cacheRead: sum.cacheRead, cacheCreate: sum.cacheCreate, models: sum.models, ms });
    if (!agent) return 0;

    // 1. the playbook's report format
    const pbPath = path.join(TEAM_DIR, "tentacles", agent.name, "PLAYBOOK.md");
    const reportPolicy = policyOf(roster, "reportPolicy", "enforce");
    if (reportPolicy !== "off" && fs.existsSync(pbPath) && /^## Definition of done/m.test(fs.readFileSync(pbPath, "utf8")) && process.env.AGENT_TEAM_NO_PLAYBOOK !== "1") {
      const msg = String(payload.last_assistant_message || "");
      const ok = /UNVERIFIED/.test(msg) && /\b(PASS|FAIL)\b\s*[—–-]/.test(msg);
      if (!ok) {
        logEvent("report_missing", { agent: agent.name, policy: reportPolicy, retry: Boolean(payload.stop_hook_active) });
        if (reportPolicy === "enforce" && !payload.stop_hook_active) {
          return block('Your final report is missing the playbook\'s proof block. Re-send your report ending with one line per Definition-of-done check, "PASS — <check> — evidence: <what you observed>" or "FAIL — <check> — evidence: <...>", then an "UNVERIFIED" list (or "UNVERIFIED: none"). Do not claim a check passed that you did not run.');
        }
      }
    }

    // 2. checks weakened to pass (deleted tests, added skips): needs a start commit; a shared tree can
    //    attribute another agent's change to this one, so this defaults to warn
    const tpol = policyOf(roster, "tamperPolicy", "warn");
    if (tpol !== "off") {
      const st = readHookState();
      const rec = st[payload.agent_id || type];
      if (rec && rec.head) {
        const problems = checkTestTamper(ROOT, rec.head, roster, "", rec.tamperBase || null);
        if (problems.length) {
          logEvent("tamper_suspected", { agent: agent.name, problems, policy: tpol });
          if (tpol === "enforce" && !payload.stop_hook_active) return block(`Checks appear to have been weakened: ${problems.join("; ")}. Restore them and fix the code instead.`);
        }
        delete st[payload.agent_id || type];
        writeHookState(st);
      }
    }
    return 0;
  }
  return 0;
}

// =====================================================================================================
// `usage` — what the agent team actually did and cost, read from Claude Code's own transcripts.
// =====================================================================================================
// Nothing else answers "is the team effective and efficient?": the headless run record (events.jsonl) is empty
// when the work happens in a live session. This reads counts and token totals only, never message content.
//   node .agent-team/orchestrator.mjs usage [--days N] [--json] [--transcripts <dir>]
// Layout it relies on (verified): <projects>/<mangled-project-path>/<session>.jsonl for the main session, and
// <session>/subagents/agent-<id>.jsonl + agent-<id>.meta.json ({agentType, model, ...}) for each subagent run.
function transcriptDir(override) {
  if (override) return path.resolve(override);
  const base = path.join(os.homedir(), ".claude", "projects");
  if (!fs.existsSync(base)) return null;
  const want = canonicalRoot().replace(/[^A-Za-z0-9]/g, "-").toLowerCase();
  const hit = fs.readdirSync(base).find((d) => d.toLowerCase() === want);
  return hit ? path.join(base, hit) : null;
}

function findJsonl(dir, acc = []) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) findJsonl(p, acc);
    else if (e.name.endsWith(".jsonl")) acc.push(p);
  }
  return acc;
}

// One pass over a transcript: usage counted once per message at its maximum (see summarizeTranscript),
// whether the agent opened its PLAYBOOK, and the last text it said.
function scanTranscript(file) {
  const byId = new Map();
  const r = { out: 0, turns: 0, models: {}, playbookRead: false, lastText: "", first: null, last: null, dispatches: [], limits: [] };
  const stamps = [];
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    if (!line) continue;
    const quick = line.includes('"usage"') || line.includes('"tool_use"') || line.includes('"text"');
    if (!quick) continue;
    let o;
    try {
      o = JSON.parse(line);
    } catch {
      continue;
    }
    const m = o.message;
    if (o.type !== "assistant" || !m) continue;
    // Claude Code writes "You've hit your session limit · resets 3:10pm (…)" as a synthetic assistant message with
    // error: "rate_limit". It is the limit, not work: it must not count as activity, a report, or the last thing said.
    if (o.isApiErrorMessage && o.error === "rate_limit") {
      const text = (Array.isArray(m.content) ? m.content : []).map((c) => c.text || "").join(" ");
      if (o.timestamp) r.limits.push({ at: Date.parse(o.timestamp), text });
      continue;
    }
    if (o.timestamp) {
      if (!r.first || o.timestamp < r.first) r.first = o.timestamp;
      if (!r.last || o.timestamp > r.last) r.last = o.timestamp;
      stamps.push(Date.parse(o.timestamp));
    }
    if (m.usage && m.model !== "<synthetic>") {
      const cur = byId.get(m.id || o.uuid) || { model: m.model, out: 0, t: o.timestamp ? Date.parse(o.timestamp) : null, input: 0, cacheRead: 0, cacheCreate: 0, calls: new Set() };
      cur.out = Math.max(cur.out, m.usage.output_tokens || 0);
      cur.input = Math.max(cur.input, m.usage.input_tokens || 0);
      cur.cacheRead = Math.max(cur.cacheRead, m.usage.cache_read_input_tokens || 0);
      cur.cacheCreate = Math.max(cur.cacheCreate, m.usage.cache_creation_input_tokens || 0);
      byId.set(m.id || o.uuid, cur);
    }
    for (const c of Array.isArray(m.content) ? m.content : []) {
      if (c.type === "text" && c.text) r.lastText = c.text;
      if (c.type === "tool_use") {
        const turn = byId.get(m.id || o.uuid);
        if (turn) turn.calls.add(c.id);
        const inp = c.input || {};
        if (c.name === "Read" && /PLAYBOOK/i.test(String(inp.file_path || inp.path || ""))) r.playbookRead = true;
        if ((c.name === "Agent" || c.name === "Task") && inp.subagent_type !== undefined) r.dispatches.push({ id: c.id, type: inp.subagent_type || "(default)", model: inp.model || null, prompt: String(inp.prompt || ""), at: o.timestamp });
      }
    }
  }
  // Every turn re-reads the whole conversation so far, so what a run costs is mostly (turns x context size), not what it
  // writes: context = fresh input + cache read + cache created on that turn. First turn = what the run starts with.
  Object.assign(r, { cold: 0, ctxSum: 0, maxCtx: 0, cacheRead: 0, cacheCreate: 0, freshInput: 0, toolTurns: 0, batchedTurns: 0, toolCalls: 0 });
  for (const m of byId.values()) {
    r.turns++;
    r.out += m.out;
    if (m.model) r.models[m.model] = (r.models[m.model] || 0) + 1;
    const ctx = m.input + m.cacheRead + m.cacheCreate;
    if (r.turns === 1) r.cold = ctx;
    r.ctxSum += ctx;
    r.maxCtx = Math.max(r.maxCtx, ctx);
    r.cacheRead += m.cacheRead;
    r.cacheCreate += m.cacheCreate;
    r.freshInput += m.input;
    if (m.calls.size) r.toolTurns++;
    if (m.calls.size > 1) r.batchedTurns++;
    r.toolCalls += m.calls.size;
  }
  // Active segments. First-to-last message overstates a run that was resumed hours later or sat waiting on a
  // background task, so time between messages longer than IDLE_GAP_MS counts as idle, not work.
  const IDLE_GAP_MS = 20 * 60 * 1000;
  stamps.sort((x, y) => x - y);
  r.segments = [];
  for (const t of stamps) {
    const seg = r.segments[r.segments.length - 1];
    if (seg && t - seg[1] <= IDLE_GAP_MS) seg[1] = t;
    else r.segments.push([t, t]);
  }
  r.activeMs = r.segments.reduce((acc, [x, y]) => acc + (y - x), 0);
  r.stamps = stamps;
  r.msgs = [...byId.values()];
  return r;
}

// A session limit is the other thing that makes a project slow, and nothing in a transcript says so except that
// message. Each limit hit is followed by silence until the next real assistant message anywhere in the project: that
// gap is the stall. A session limit cannot outlast its 5-hour window, so a stall is counted up to that cap (the person
// may simply have come back later than the reset); a weekly limit has no such cap. Hits that end at the same moment
// (several agents stopped by one limit) are one stall.
const WINDOW_MS = 5 * 3600e3;
function limitStalls(hits, stamps, now) {
  const stalls = [];
  for (const h of [...hits].sort((a, b) => a.at - b.at)) {
    const next = stamps.find((t) => t > h.at) ?? null;
    const prev = stalls[stalls.length - 1];
    if (prev && prev.resumedAt === next) {
      prev.hits++;
      continue;
    }
    const weekly = /week/i.test(h.text);
    const waited = (next ?? now) - h.at;
    stalls.push({ at: h.at, resumedAt: next, hits: 1, weekly, resets: ((h.text.match(/resets\s+(.+?)\s*$/i) || [])[1] || "").trim() || null, minutes: Math.round((weekly ? waited : Math.min(waited, WINDOW_MS)) / 60000), capped: !weekly && waited > WINDOW_MS });
  }
  return stalls;
}

// Output tokens, commits and time in each stretch of work between stalls: "how far did one window of quota get us".
function limitPeriods(stalls, msgs, firstAt, lastAt) {
  const cuts = [];
  let from = firstAt;
  let open = false;
  for (const s of stalls) {
    if (s.at >= from) cuts.push([from, s.at]);
    open = s.resumedAt == null; // still waiting: no window after it yet
    from = s.resumedAt ?? lastAt;
  }
  if (!open && from <= lastAt) cuts.push([from, lastAt]);
  return cuts.map(([a, b]) => {
    const inside = msgs.filter((m) => m.t != null && m.t >= a && m.t <= b);
    const byModel = {};
    for (const m of inside) {
      const k = (m.model || "?").replace(/^claude-/, "").replace(/-\d.*$/, "");
      byModel[k] = (byModel[k] || 0) + m.out;
    }
    const out = inside.reduce((x, m) => x + m.out, 0);
    const g = spawnSync("git", ["rev-list", "--count", `--since=${new Date(a).toISOString()}`, `--until=${new Date(b).toISOString()}`, "HEAD"], { cwd: ROOT, encoding: "utf8" });
    const commits = g.status === 0 ? Number(g.stdout.trim()) || 0 : null;
    return { from: new Date(a).toISOString(), to: new Date(b).toISOString(), minutes: Math.round((b - a) / 60000), out, byModel, commits, outPerCommit: commits ? Math.round(out / commits) : null };
  });
}

// Blocked writes that keep hitting the same file mean the ownership map does not fit how the work is cut.
function ownershipFriction(roster, since) {
  if (!fs.existsSync(EVENTS_PATH)) return { blocks: 0, files: [] };
  const byFile = new Map();
  let blocks = 0;
  for (const line of fs.readFileSync(EVENTS_PATH, "utf8").split("\n")) {
    if (!line.includes('"ownership_violation"')) continue;
    let e;
    try {
      e = JSON.parse(line);
    } catch {
      continue;
    }
    if (e.type !== "ownership_violation" || !e.file || (since && Date.parse(e.ts) < since)) continue;
    const file = e.file.replace(/^\.(?:claude|agent-team)\/worktrees\/[^/]+\//, "");
    blocks++;
    const cur = byFile.get(file) || { file, n: 0, agents: new Set() };
    cur.n++;
    cur.agents.add(e.agent);
    byFile.set(file, cur);
  }
  const owners = (roster.agents || []).map((a) => ({ name: a.name, res: (a.ownership || []).map(globToRegex) }));
  const files = [...byFile.values()]
    .sort((a, b) => b.n - a.n)
    .map((f) => ({ file: f.file, blocks: f.n, agents: [...f.agents], owners: owners.filter((o) => o.res.some((re) => re.test(f.file))).map((o) => o.name) }));
  return { blocks, files };
}

const LONG_RUN_TURNS = 80;

function usageReport(opts) {
  const roster = fs.existsSync(ROSTER_PATH) ? readJson(ROSTER_PATH) : { agents: [] };
  const dir = transcriptDir(opts.transcripts);
  if (!dir || !fs.existsSync(dir)) return { error: `no Claude Code transcripts found for this project${dir ? ` at ${dir}` : ""} (pass --transcripts <dir>)` };
  const since = opts.days ? Date.now() - opts.days * 86400000 : 0;
  // Main sessions first: they hold the dispatch prompts a subagent run is matched to ([escalate: reason]).
  const files = findJsonl(dir).sort((a, b) => Number(/[\\/]subagents[\\/]/.test(a)) - Number(/[\\/]subagents[\\/]/.test(b)));
  const runs = [];
  const mainOut = { out: 0, turns: 0, byModel: {} };
  const dispatchById = new Map();
  const allStamps = [];
  const allLimits = [];
  const allMsgs = [];
  for (const f of files) {
    const isSub = /[\\/]subagents[\\/]/.test(f);
    const s = scanTranscript(f);
    for (const t of s.stamps) if (t >= since) allStamps.push(t);
    for (const l of s.limits) if (l.at >= since) allLimits.push(l);
    for (const m of s.msgs) if (m.t != null && m.t >= since) allMsgs.push(m);
    if (!isSub) {
      // only the messages inside the --days window: the figure sits next to the subagent total, which is windowed
      const inWindow = s.msgs.filter((m) => !since || (m.t != null && m.t >= since));
      mainOut.out += inWindow.reduce((a, m) => a + m.out, 0);
      mainOut.turns += inWindow.length;
      for (const d of s.dispatches) dispatchById.set(d.id, d);
      continue;
    }
    if (since && s.last && Date.parse(s.last) < since) continue;
    let meta = {};
    try {
      meta = JSON.parse(fs.readFileSync(f.replace(/\.jsonl$/, ".meta.json"), "utf8"));
    } catch {
      /* no meta: type unknown */
    }
    const type = meta.agentType || "(unknown)";
    const dominant = Object.entries(s.models).sort((a, b) => b[1] - a[1])[0];
    runs.push({
      agent: type,
      requestedModel: meta.model || null,
      actualModel: dominant ? dominant[0] : null,
      out: s.out,
      turns: s.turns,
      cold: s.cold,
      ctxSum: s.ctxSum,
      cacheRead: s.cacheRead,
      cacheCreate: s.cacheCreate,
      freshInput: s.freshInput,
      toolTurns: s.toolTurns,
      batchedTurns: s.batchedTurns,
      ms: s.activeMs,
      segments: s.segments,
      playbookRead: s.playbookRead,
      reportBlock: /UNVERIFIED/.test(s.lastText) && /\b(PASS|FAIL)\b\s*[—–-]/.test(s.lastText),
      escalated: /\[escalate:\s*[^\]]+\]/i.test((dispatchById.get(meta.toolUseId) || {}).prompt || ""),
      // null when the dispatch prompt is not in the transcripts (an older log): unknown, not "not a re-audit"
      // (only the head of the prompt: it names the kind of audit; the body may mention earlier rounds in passing)
      reaudit: dispatchById.has(meta.toolUseId) ? /re-?audit|round 2|re-?check|fix round/i.test((dispatchById.get(meta.toolUseId).prompt || "").slice(0, 120)) : null,
    });
  }
  const rosterNames = new Set((roster.agents || []).map((a) => a.name));
  const per = {};
  for (const r of runs) {
    const p = (per[r.agent] ||= { agent: r.agent, runs: 0, out: 0, turns: 0, ms: 0, ctxSum: 0, cacheRead: 0, playbookRead: 0, reportBlock: 0, up: 0, upExplained: 0, byModel: {} });
    p.runs++;
    p.out += r.out;
    p.turns += r.turns;
    p.ctxSum += r.ctxSum;
    p.cacheRead += r.cacheRead;
    p.ms += r.ms || 0;
    if (r.playbookRead) p.playbookRead++;
    if (r.reportBlock) p.reportBlock++;
    const declared = declaredModelFor(r.agent, roster);
    if (declared && r.requestedModel && modelRank(r.requestedModel) > modelRank(declared)) {
      p.up++;
      if (r.escalated) p.upExplained++;
    }
    const mk = (r.actualModel || "?").replace(/^claude-/, "").replace(/-\d.*$/, "");
    p.byModel[mk] = (p.byModel[mk] || 0) + r.out;
  }
  const rows = Object.values(per).sort((a, b) => b.runs - a.runs);
  const totalRuns = runs.length;
  const totalOut = runs.reduce((a, r) => a + r.out, 0);
  const byModel = {};
  for (const r of runs) {
    const mk = (r.actualModel || "?").replace(/^claude-/, "").replace(/-\d.*$/, "");
    byModel[mk] = (byModel[mk] || 0) + r.out;
  }
  const flags = [];
  for (const a of roster.agents || []) {
    const p = per[a.name];
    const share = p ? p.runs / Math.max(1, totalRuns) : 0;
    if (a.dormant) continue;
    if (totalRuns >= 20 && share < 0.05) flags.push(`${a.name}: ${p ? p.runs : 0} of ${totalRuns} runs (${Math.round(share * 100)}%) — consider \`"dormant": true\` or merging it into a neighbour until it is needed`);
  }
  for (const p of rows) {
    if (rosterNames.has(p.agent) && p.runs >= 5 && p.playbookRead / p.runs < 0.5 && !opts.hooksSeen) flags.push(`${p.agent}: opened its playbook in only ${Math.round((100 * p.playbookRead) / p.runs)}% of runs — wire the SubagentStart hook so the playbook reaches it without its cooperation`);
    if (p.up - p.upExplained > 0 && rosterNames.has(p.agent)) flags.push(`${p.agent}: ${p.up - p.upExplained} dispatch(es) asked for a costlier model than declared, with no [escalate: reason]`);
  }
  // Audit chains: the security agent run again and again on the same work (fix, audit, re-audit, ...). Extra review
  // rounds don't converge: later rounds fabricate narrower findings once the real ones are exhausted (a 2026
  // preprint measured +62% false positives from multi-round review). A chain is consecutive runs of the security
  // agent each starting within 90 minutes of the previous one ending. Audits of DIFFERENT changes run one after another
  // are not a loop (each slice of a build gets its own audit, and its own re-audit), so a chain only counts when two
  // re-audits come back to back: a third round on one change. A run counts as a re-audit when its dispatch said
  // "re-audit" or "round 2", or when the dispatch could not be read (an older log), so old logs still get the flag.
  if (roster.securityAgent) {
    const sec = runs.filter((r) => r.agent === roster.securityAgent && r.segments && r.segments.length).map((r) => ({ s: r.segments[0][0], e: r.segments[r.segments.length - 1][1], re: r.reaudit })).sort((x, y) => x.s - y.s);
    let chain = 0, adjacent = false, longest = 0, loops = 0, counted = false;
    for (let i = 0; i < sec.length; i++) {
      const joined = i > 0 && sec[i].s - sec[i - 1].e <= 90 * 60000;
      if (!joined) [chain, adjacent, counted] = [0, false, false];
      chain++;
      if (joined && sec[i].re !== false && sec[i - 1].re !== false) adjacent = true;
      if (chain >= 3 && adjacent) {
        longest = Math.max(longest, chain);
        if (!counted) [loops, counted] = [loops + 1, true];
      }
    }
    if (longest >= 3) flags.push(`${roster.securityAgent}: ${loops} audit chain(s) of 3+ back-to-back runs (longest ${longest}) with two re-audits in a row — a third round on one change; a re-audit should verify the claimed fix and rerun the original probes only, Low/Info findings go to a backlog, and a third round needs a person's decision`);
  }
  // Where the tokens go. What a run writes is a small part of what it costs: every turn re-reads the whole conversation,
  // so cost is roughly turns x context, and context grows with each turn. Measured on a real project, cache reads were
  // about 160x the output. Two habits move that number: several tool calls in one turn, and shorter runs.
  const sumRuns = (f) => runs.reduce((a, r) => a + f(r), 0);
  const totalCacheRead = sumRuns((r) => r.cacheRead);
  const totalTurns = sumRuns((r) => r.turns);
  const toolTurns = sumRuns((r) => r.toolTurns);
  const batchedTurns = sumRuns((r) => r.batchedTurns);
  const longRuns = runs.filter((r) => r.turns > LONG_RUN_TURNS);
  const context = {
    cacheRead: totalCacheRead,
    cacheCreate: sumRuns((r) => r.cacheCreate),
    freshInput: sumRuns((r) => r.freshInput),
    output: totalOut,
    cacheReadPerOutput: totalOut ? Math.round(totalCacheRead / totalOut) : null,
    coldStartAvg: totalRuns ? Math.round(sumRuns((r) => r.cold) / totalRuns) : 0,
    avgContext: totalTurns ? Math.round(sumRuns((r) => r.ctxSum) / totalTurns) : 0,
    turns: totalTurns,
    toolTurns,
    singleCallPct: toolTurns ? Math.round((100 * (toolTurns - batchedTurns)) / toolTurns) : 0,
    longRuns: longRuns.length,
    longRunCacheReadPct: totalCacheRead ? Math.round((100 * longRuns.reduce((a, r) => a + r.cacheRead, 0)) / totalCacheRead) : 0,
  };
  if (toolTurns >= 200 && context.singleCallPct >= 75) {
    flags.push(`${context.singleCallPct}% of ${toolTurns} tool turns made a single call, and each turn re-reads the whole conversation (about ${Math.round(context.avgContext / 1000)}k tokens on average here): independent reads, searches and checks issued together in one turn cut the turn count, and with it the cost (the SubagentStart hook now tells agents so; \`economyHint\`, \`turnBudget\` in roster.json)`);
  }
  if (longRuns.length >= 2 && context.longRunCacheReadPct >= 40) {
    flags.push(`${longRuns.length} runs over ${LONG_RUN_TURNS} turns used ${context.longRunCacheReadPct}% of all cache reads: cost grows faster than turns because the context grows with each one. Split work that large at a clean point (a handoff, then a fresh run) or give the agent a narrower task`);
  }
  // The same audit run again and again on the same shape of work (batch 1, batch 2, ...): each one full depth. Once the
  // first has verified the shape, the rest only need to confirm it was followed.
  if (roster.securityAgent && !loadAuditPatterns(roster).length) {
    const ledgerFile = path.join(ROOT, LEDGER_REL);
    const shapes = {};
    // Only recent entries: a shape whose batches are finished is history, not a suggestion. The window is --days, or 14 days.
    const shapeSince = since || Date.now() - 14 * 86400000;
    for (const m of fs.existsSync(ledgerFile) ? fs.readFileSync(ledgerFile, "utf8").matchAll(/^## (\d{4}-\d\d-\d\d)\s+[—–-]\s+(.+)$/gm) : []) {
      const title = m[2];
      if (Date.parse(m[1]) < shapeSince) continue;
      if (/re-?audit|round 2|light audit/i.test(title)) continue;
      const key = title.replace(/\(.*$/, "").toLowerCase().replace(/\bround \d( of \d)?\b/g, "").replace(/\d+/g, "#").replace(/[^a-z#]+/g, " ").trim();
      if (key.length >= 12) (shapes[key] ||= []).push(title);
    }
    const worst = Object.entries(shapes).sort((a, b) => b[1].length - a[1].length)[0];
    if (worst && worst[1].length >= 3) flags.push(`${worst[1].length} audit entries share one shape ("${worst[1][0].replace(/\(.*$/, "").trim().slice(0, 70)}"): repeated same-shape work. Declare it in roster "auditPatterns" ({ name, match, coverage }) so the first batch is audited in full and the rest light (\`orchestrator.mjs risk\` applies it)`);
  }
  const opusShare = totalOut ? (byModel.opus || 0) / totalOut : 0;
  const declaredOpus = (roster.agents || []).filter((a) => modelRank(declaredModelFor(a.name, roster)) === 3 && !a.dormant).length;
  if (totalOut && opusShare > 0.6 && declaredOpus < (roster.agents || []).length / 2) flags.push(`top-tier model produced ${Math.round(opusShare * 100)}% of subagent output although only ${declaredOpus} of ${(roster.agents || []).length} agents declare it — model tiering is not in effect`);
  // Concurrency: how much of the time that ANY agent was ACTIVE did two or more run together? Sweep over active
  // segments. Agent-minutes / busy-minutes is the parallelism actually achieved (1.0 = strictly one at a time).
  const ev = [];
  for (const r of runs) for (const [x, y] of r.segments || []) if (y > x) ev.push([x, 1], [y, -1]);
  ev.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
  let cur = 0, maxC = 0, busy = 0, overlap = 0, last = null;
  for (const [t, d] of ev) {
    if (last !== null && cur >= 1) { busy += t - last; if (cur >= 2) overlap += t - last; }
    cur += d; maxC = Math.max(maxC, cur); last = t;
  }
  const agentMs = runs.reduce((a, r) => a + (r.ms || 0), 0);
  const concurrency = { maxConcurrent: maxC, busyMinutes: Math.round(busy / 60000), agentMinutes: Math.round(agentMs / 60000), overlapPct: busy ? Math.round((100 * overlap) / busy) : 0, parallelism: busy ? Math.round((agentMs / busy) * 100) / 100 : 0 };
  if (totalRuns >= 10 && concurrency.busyMinutes >= 30 && concurrency.overlapPct < 15) {
    flags.push(`work ran almost entirely one agent at a time (${concurrency.overlapPct}% of busy time had two or more running, parallelism ${concurrency.parallelism}x): \`orchestrator.mjs plan\` shows which queue items are independent and could run side by side in worktrees`);
  }

  // Session limits: how much of the period the project sat waiting for a quota window to reset, and how far one window went.
  allStamps.sort((a, b) => a - b);
  let limits = null;
  if (allLimits.length && allStamps.length) {
    const stalls = limitStalls(allLimits, allStamps, Date.now());
    const stalledMinutes = stalls.reduce((a, s) => a + s.minutes, 0);
    const spanEnd = Math.max(allStamps[allStamps.length - 1], ...stalls.map((s) => s.at + s.minutes * 60000));
    const spanMinutes = Math.round((spanEnd - Math.min(allStamps[0], stalls[0].at)) / 60000);
    const periods = limitPeriods(stalls, allMsgs, allStamps[0], allStamps[allStamps.length - 1]);
    limits = { hits: allLimits.length, stalls, stalledMinutes, spanMinutes, stalledPct: spanMinutes ? Math.round((100 * stalledMinutes) / spanMinutes) : 0, periods };
    if (stalls.length >= 2 || limits.stalledPct >= 15) {
      const heavy = periods.filter((p) => p.out > 0 && (p.byModel.opus || 0) / p.out > 0.4).length;
      flags.push(`session limit hit ${stalls.length} time(s): about ${Math.round(stalledMinutes / 6) / 10}h of the ${Math.round(spanMinutes / 6) / 10}h span (${limits.stalledPct}%) was spent waiting for a quota reset, so throughput is set by how far one window goes, not by how fast agents run${heavy ? `. ${heavy} of ${periods.length} windows were over 40% top-tier output: mechanical and audit work on a lighter tier (\`orchestrator.mjs tier\`, roster "autoTier") stretches a window` : ""}`);
    }
  }
  // Blocked writes that recur on one file: the ownership map does not fit how the work is cut.
  const friction = ownershipFriction(roster, since);
  for (const f of friction.files.filter((x) => x.blocks >= 2).slice(0, 4)) {
    flags.push(
      f.owners.length
        ? `${f.file}: ${f.blocks} blocked writes (${f.agents.join(", ")}) but it belongs to ${f.owners.join(", ")} — the task was cut across agents; hand that part to its owner, or list the path in roster "sharedPaths" if it is genuinely cross-cutting`
        : `${f.file}: ${f.blocks} blocked writes (${f.agents.join(", ")}) and no agent owns it — give it an owner or list it in roster "sharedPaths" (\`orchestrator.mjs lint\` lists every unowned file)`,
    );
  }
  // Cost, in relative units, because the question that matters is cost per SOLVED change, not tokens per run. Weights are
  // assumptions you can set in roster "costWeights": model multipliers (cheapest = Haiku) and per-token ratios (output
  // costs several times an input token; a cache read a tenth). Commits stand in for solved changes.
  const cw = roster.costWeights || {};
  const mult = { haiku: 0.33, sonnet: 1, opus: 2, fable: 5, ...(cw.models || {}) };
  const tw = { input: 1, cacheWrite: 1.25, cacheRead: 0.1, output: 5, ...(cw.tokens || {}) };
  const famOf = (m) => (/fable/i.test(m || "") ? "fable" : /opus/i.test(m || "") ? "opus" : /haiku/i.test(m || "") ? "haiku" : /sonnet/i.test(m || "") ? "sonnet" : "sonnet");
  const costOf = (r) => (mult[famOf(r.actualModel)] ?? 1) * (r.freshInput * tw.input + r.cacheCreate * tw.cacheWrite + r.cacheRead * tw.cacheRead + r.out * tw.output);
  const unitsByAgent = {};
  const unitsByModel = {};
  const runCosts = [];
  for (const r of runs) {
    const c = costOf(r);
    runCosts.push(c);
    unitsByAgent[r.agent] = (unitsByAgent[r.agent] || 0) + c;
    const fam = famOf(r.actualModel);
    unitsByModel[fam] = (unitsByModel[fam] || 0) + c;
  }
  const totalUnits = runCosts.reduce((a, c) => a + c, 0);
  const sortedCosts = [...runCosts].sort((a, b) => a - b);
  const firstRunAt = Math.min(...runs.flatMap((r) => (r.segments || []).map((x) => x[0])).concat([Infinity]));
  let commits = null;
  if (Number.isFinite(firstRunAt)) {
    const g = spawnSync("git", ["rev-list", "--count", "--no-merges", "--since=" + new Date(since || firstRunAt).toISOString(), "HEAD"], { cwd: ROOT, encoding: "utf8" });
    commits = g.status === 0 ? Number(g.stdout.trim()) || 0 : null;
  }
  const byAgentRows = Object.entries(unitsByAgent).sort((a, b) => b[1] - a[1]).map(([agent, units]) => ({ agent, units: Math.round(units), share: totalUnits ? Math.round((100 * units) / totalUnits) : 0 }));
  const verifyShare = roster.securityAgent && totalUnits ? Math.round((100 * (unitsByAgent[roster.securityAgent] || 0)) / totalUnits) : 0;
  const cost = {
    assumed: true,
    units: Math.round(totalUnits),
    commits,
    perCommit: commits ? Math.round(totalUnits / commits) : null,
    p90Run: sortedCosts.length ? Math.round(sortedCosts[Math.min(sortedCosts.length - 1, Math.floor(sortedCosts.length * 0.9))]) : 0,
    byModelPct: Object.fromEntries(Object.entries(unitsByModel).map(([k, v]) => [k, totalUnits ? Math.round((100 * v) / totalUnits) : 0])),
    byAgent: byAgentRows,
    verificationShare: verifyShare,
  };
  if (verifyShare >= 40) flags.push(roster.securityAgent + " is " + verifyShare + "% of the cost: when checking costs about as much as building, the savings from routing are eaten by the checker. Audit depth by risk (`orchestrator.mjs risk`: a light audit on the middle tier at medium effort), a declared auditPattern for repeated shapes, and effort one step lower for re-audits are the levers; Opus at high effort is for first-use and logic changes");
  // Headless routing outcomes: how often a dispatch needed more than one attempt, by the tier it started on.
  const routing = { dispatches: 0, escalated: 0, escalationRatePct: 0, byStartTier: {}, efforts: {} };
  if (fs.existsSync(EVENTS_PATH)) {
    for (const line of fs.readFileSync(EVENTS_PATH, "utf8").split("\n")) {
      if (!line.includes('"dispatch_end"')) continue;
      let e;
      try {
        e = JSON.parse(line);
      } catch {
        continue;
      }
      if (e.type !== "dispatch_end" || e.deferred || (since && Date.parse(e.ts) < since)) continue;
      routing.dispatches++;
      const st = (routing.byStartTier[e.startTier || "cli-default"] ||= { dispatches: 0, escalated: 0 });
      st.dispatches++;
      if (e.attempts > 1) {
        routing.escalated++;
        st.escalated++;
      }
      for (const ef of e.efforts || []) if (ef) routing.efforts[ef] = (routing.efforts[ef] || 0) + 1;
    }
    routing.escalationRatePct = routing.dispatches ? Math.round((100 * routing.escalated) / routing.dispatches) : 0;
  }
  return { dir, days: opts.days || null, mainOut, totalRuns, totalOut, byModel, per: rows, flags, concurrency, limits, ownership: friction, context, cost, routing };
}

function printUsage(rep) {
  if (rep.error) return console.log(rep.error);
  const M = (n) => (n >= 1e6 ? (n / 1e6).toFixed(2) + "M" : Math.round(n / 1000) + "k");
  console.log(`subagent runs: ${rep.totalRuns}   output tokens: ${M(rep.totalOut)} (main session ${M(rep.mainOut.out)})${rep.days ? `   last ${rep.days} days` : ""}`);
  if (rep.concurrency) console.log(`time: ${rep.concurrency.agentMinutes} agent-min in ${rep.concurrency.busyMinutes} busy-min, up to ${rep.concurrency.maxConcurrent} at once, ${rep.concurrency.overlapPct}% of busy time overlapped (parallelism ${rep.concurrency.parallelism}x)`);
  if (rep.limits) {
    const L = rep.limits;
    console.log(`session limit: ${L.stalls.length} stall(s), about ${Math.round(L.stalledMinutes / 6) / 10}h waiting of a ${Math.round(L.spanMinutes / 6) / 10}h span (${L.stalledPct}%; each stall counted up to the 5h window)`);
    console.log("  window                         min   output  top-tier  commits  output/commit");
    for (const p of L.periods.slice(-8)) {
      const opus = p.out ? Math.round((100 * (p.byModel.opus || 0)) / p.out) + "%" : "-";
      console.log(`  ${p.from.slice(5, 16).replace("T", " ")} → ${p.to.slice(5, 16).replace("T", " ")}  ${String(p.minutes).padStart(5)}  ${M(p.out).padStart(7)}  ${opus.padStart(8)}  ${String(p.commits ?? "-").padStart(7)}  ${(p.outPerCommit ? M(p.outPerCommit) : "-").padStart(13)}`);
    }
  }
  if (rep.context && rep.context.turns) {
    const C = rep.context;
    console.log(`context: ${M(C.cacheRead)} read from cache for ${M(C.output)} written${C.cacheReadPerOutput ? ` (${C.cacheReadPerOutput}x)` : ""}; a run starts at ~${Math.round(C.coldStartAvg / 1000)}k and a turn averages ~${Math.round(C.avgContext / 1000)}k of context; ${C.singleCallPct}% of tool turns made a single call; ${C.longRuns} run(s) over ${LONG_RUN_TURNS} turns used ${C.longRunCacheReadPct}% of cache reads`);
  }
  if (rep.cost && rep.cost.units) {
    const C = rep.cost;
    console.log(`cost: ${M(C.units)} units (assumed price weights, roster costWeights)${C.perCommit ? `, ${M(C.perCommit)} per commit (${C.commits} commits)` : ""}, p90 run ${M(C.p90Run)}; by model ${Object.entries(C.byModelPct).map(([k, v]) => `${k} ${v}%`).join(" ")}${C.verificationShare ? `; verification ${C.verificationShare}%` : ""}`);
  }
  if (rep.routing && rep.routing.dispatches) {
    const R = rep.routing;
    console.log(`headless routing: ${R.dispatches} dispatch(es), ${R.escalationRatePct}% needed escalating; by start tier ${Object.entries(R.byStartTier).map(([k, v]) => `${k} ${v.escalated}/${v.dispatches}`).join(", ")}`);
  }
  console.log("by model: " + Object.entries(rep.byModel).map(([k, v]) => `${k} ${rep.totalOut ? Math.round((100 * v) / rep.totalOut) : 0}%`).join("  "));
  console.log("\nagent".padEnd(26) + "runs  share  avg out  active-min  min-share  playbook-read  report-block  upward-model  turns/run  cache-read");
  for (const p of rep.per) {
    console.log(
      p.agent.padEnd(25) +
        String(p.runs).padStart(4) + "  " +
        (Math.round((100 * p.runs) / Math.max(1, rep.totalRuns)) + "%").padStart(5) + "  " +
        M(p.out / p.runs).padStart(7) + "  " +
        String(Math.round(p.ms / 60000)).padStart(10) + "  " +
        (Math.round((100 * p.ms) / Math.max(1, rep.per.reduce((a, x) => a + x.ms, 0))) + "%").padStart(9) + "  " +
        (Math.round((100 * p.playbookRead) / p.runs) + "%").padStart(13) + "  " +
        (Math.round((100 * p.reportBlock) / p.runs) + "%").padStart(12) + "  " +
        `${p.up}${p.upExplained ? ` (${p.upExplained} explained)` : ""}`.padStart(12) + "  " +
        String(Math.round(p.turns / p.runs)).padStart(9) + "  " +
        (rep.context && rep.context.cacheRead ? Math.round((100 * p.cacheRead) / rep.context.cacheRead) + "%" : "-").padStart(10),
    );
  }
  if (rep.flags.length) console.log("\nattention:\n" + rep.flags.map((f) => "  - " + f).join("\n"));
  else console.log("\nnothing flagged");
}

// =====================================================================================================
// `risk` — how deep does this change need to be audited?
// =====================================================================================================
// A security audit of a change that only moves files or re-points imports costs as much as one of a rewritten
// permission check, yet carries a fraction of the risk (a real ledger showed audits of import-only slices
// finding nothing, run at full depth). This classifies each sensitive file's diff so the security agent can
// start light where the change is mechanical and go deep where it is logic. It is ADVISORY: the gate still
// requires a ledger entry for every sensitive path, and anything the classifier is unsure about is "logic".
//   node .agent-team/orchestrator.mjs risk [<base> [<head>]] [--staged] [--json]
//   (no arguments: working tree against HEAD, plus new untracked files)
//   mechanical   pure rename/move (100% similarity), whitespace, comments, closing punctuation
//   import-only  imports re-pointed to another module path with the SAME bindings (confirm the new target is
//                the moved/renamed module — a changed specifier can swap in different code)
//   pattern      only lines of a project-declared repeated shape changed (roster "auditPatterns"); light once one
//                full audit of that shape is on record, full the first time
//   logic        everything else, including new files, deleted files, added/removed bindings
const COMMENT_RE = /^\s*(\/\/|\/\*|\*\/?|#|--|<!--|-->|"""|''')/;
const PUNCT_RE = /^\s*[)\]};,]*\s*$/;
const IMPORT_FROM_RE = /^\s*(?:import|export)\b([^'"]*?)\bfrom\s*['"][^'"]+['"]\s*;?\s*$/;
const IMPORT_BARE_RE = /^\s*import\s*['"][^'"]+['"]\s*;?\s*$/;
const REQUIRE_RE = /^\s*(?:const|let|var)\s+([\w${}\s,:]+?)\s*=\s*require\(\s*['"][^'"]+['"]\s*\)\s*;?\s*$/;
const PY_FROM_RE = /^\s*from\s+[\w.]+\s+import\s+(.+?)\s*$/;
const CONT_NAME_RE = /^\s*[\w$]+(?:\s+as\s+[\w$]+)?\s*,?\s*$/;
const CLOSE_FROM_RE = /^\s*\}\s*from\s*['"][^'"]+['"]\s*;?\s*$/;

// The identity of an import line that does NOT depend on where it points: what it binds.
function importSignature(line) {
  let m = IMPORT_FROM_RE.exec(line);
  if (m) return "bind:" + m[1].replace(/[{}\s]+/g, " ").trim().split(/[\s,]+/).filter(Boolean).sort().join(",");
  m = REQUIRE_RE.exec(line);
  if (m) return "bind:" + m[1].replace(/[{}\s]+/g, " ").trim().split(/[\s,]+/).filter(Boolean).sort().join(",");
  m = PY_FROM_RE.exec(line);
  if (m) return "bind:" + m[1].split(/[\s,]+/).filter(Boolean).sort().join(",");
  if (CLOSE_FROM_RE.test(line)) return "closer";
  if (CONT_NAME_RE.test(line)) return "name:" + line.replace(/[\s,]+/g, " ").trim();
  return null;
}

const isTrivialLine = (l) => l.trim() === "" || COMMENT_RE.test(l) || PUNCT_RE.test(l);

// A project can declare a repeated change shape in roster.json: "auditPatterns": [{ "name", "match": "<regex>",
// "coverage": "<what proves every instance follows it>" }]. A file whose WHITESPACE-INSENSITIVE diff (git diff -w, so
// re-indentation vanishes) has only lines that match one pattern is class "pattern", not "logic". It is audited light
// only once a full audit of that pattern is on record (the ledger names `pattern: <name>`); the first use is full.
// The regex is the project's own statement of what counts as mechanical, so keep it tight: a loose one hides logic.
function loadAuditPatterns(roster) {
  return (Array.isArray(roster.auditPatterns) ? roster.auditPatterns : []).flatMap((p) => {
    try {
      return p && typeof p.name === "string" && typeof p.match === "string" ? [{ name: p.name, coverage: p.coverage || null, re: new RegExp(p.match) }] : [];
    } catch {
      return []; // lint reports the bad regex
    }
  });
}
function matchAuditPattern(patterns, removed, added) {
  const lines = [...removed, ...added].filter((l) => !isTrivialLine(l));
  return (lines.length && patterns.find((p) => lines.every((l) => p.re.test(l)))) || null;
}

function classifyChange(removed, added) {
  const nonTrivial = (l) => !isTrivialLine(l);
  const r = removed.filter(nonTrivial);
  const a = added.filter(nonTrivial);
  if (!r.length && !a.length) return { cls: "mechanical", why: "whitespace, comments or punctuation only" };
  const rs = r.map(importSignature);
  const as = a.map(importSignature);
  if (rs.some((x) => x === null) || as.some((x) => x === null)) {
    const sample = [...r, ...a].find((l, i) => (i < r.length ? rs[i] : as[i - r.length]) === null);
    return { cls: "logic", why: `code changed: ${String(sample || "").trim().slice(0, 90)}` };
  }
  if (!rs.concat(as).some((x) => x.startsWith("bind:"))) return { cls: "logic", why: "name lists changed outside an import" };
  const key = (xs) => xs.slice().sort().join("|");
  if (key(rs) !== key(as)) return { cls: "logic", why: "imports added or removed (the set of bindings changed)" };
  return { cls: "import-only", why: "imports re-pointed with identical bindings" };
}

// The path list the security gate uses (.claude/security-sensitive-paths.txt: one regex per line, `#` comments, a
// leading `?` = may match nothing yet, a leading `!` = sensitive even in a test file). Falls back to the roster's
// glob list for a project without the file. An unparseable line is skipped here; `lint` reports it.
function sensitivePatterns(roster) {
  const listPath = path.join(ROOT, ".claude", "security-sensitive-paths.txt");
  if (fs.existsSync(listPath)) {
    return fs
      .readFileSync(listPath, "utf8")
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter((l) => l && !l.startsWith("#"))
      .flatMap((l) => {
        try {
          return [new RegExp(l.replace(/^[?!]/, ""), "i")];
        } catch {
          return [];
        }
      });
  }
  return (roster.securitySensitivePaths || []).map(globToRegex);
}

function riskReport(args) {
  const roster = fs.existsSync(ROSTER_PATH) ? readJson(ROSTER_PATH) : {};
  const positional = args.filter((a) => !a.startsWith("--"));
  const rev = args.includes("--staged") ? ["--cached"] : positional.length ? positional.slice(0, 2) : ["HEAD"];
  const gitArgs = ["diff", "-M", "-U0", "--no-color", ...rev];
  const res = spawnSync("git", gitArgs, { cwd: ROOT, encoding: "utf8", maxBuffer: 100 * 1024 * 1024 });
  if (res.status !== 0) return { error: `git diff failed: ${(res.stderr || "").trim().slice(0, 200)}` };
  const patterns = loadAuditPatterns(roster);
  const wlines = new Map();
  if (patterns.length) {
    const w = spawnSync("git", ["diff", "-M", "-w", "-U0", "--no-color", ...rev], { cwd: ROOT, encoding: "utf8", maxBuffer: 100 * 1024 * 1024 });
    for (const b of w.status === 0 ? w.stdout.split(/^diff --git /m).slice(1) : []) {
      const h = b.split("\n")[0].match(/a\/(.+?) b\/(.+)$/);
      if (!h) continue;
      const rec = { removed: [], added: [] };
      for (const l of b.split("\n")) {
        if (l.startsWith("---") || l.startsWith("+++")) continue;
        if (l.startsWith("-")) rec.removed.push(l.slice(1));
        else if (l.startsWith("+")) rec.added.push(l.slice(1));
      }
      wlines.set(h[2], rec);
    }
  }
  const ledgerPath = path.join(ROOT, LEDGER_REL);
  const ledgerText = fs.existsSync(ledgerPath) ? fs.readFileSync(ledgerPath, "utf8") : "";
  const patternAudited = (name) => new RegExp(`pattern:\\s*${name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?![\\w-])`, "i").test(ledgerText);
  const files = [];
  const blocks = res.stdout.split(/^diff --git /m).slice(1);
  for (const b of blocks) {
    const head = b.split("\n")[0].match(/a\/(.+?) b\/(.+)$/);
    if (!head) continue;
    const file = head[2];
    if (/^rename from /m.test(b) && /^similarity index 100%/m.test(b)) {
      files.push({ file, status: "R", cls: "mechanical", why: `pure rename from ${(b.match(/^rename from (.+)$/m) || [])[1]}` });
      continue;
    }
    if (/^new file mode/m.test(b)) { files.push({ file, status: "A", cls: "logic", why: "new file" }); continue; }
    if (/^deleted file mode/m.test(b)) { files.push({ file, status: "D", cls: "logic", why: "file deleted (a removed control matters)" }); continue; }
    const removed = [], added = [];
    for (const l of b.split("\n")) {
      if (l.startsWith("---") || l.startsWith("+++")) continue;
      if (l.startsWith("-")) removed.push(l.slice(1));
      else if (l.startsWith("+")) added.push(l.slice(1));
    }
    let c = classifyChange(removed, added);
    const w = c.cls === "logic" ? wlines.get(file) : null;
    const p = w && matchAuditPattern(patterns, w.removed, w.added);
    if (p) c = { cls: "pattern", pattern: p.name, coverage: p.coverage, seen: patternAudited(p.name), why: `only the "${p.name}" pattern changed (whitespace ignored)${patternAudited(p.name) ? "" : "; first use, no full audit of it on record"}` };
    files.push({ file, status: "M", ...c });
  }
  if (!args.includes("--staged") && !positional.length) {
    const un = spawnSync("git", ["ls-files", "--others", "--exclude-standard"], { cwd: ROOT, encoding: "utf8" }).stdout.split("\n").filter(Boolean);
    for (const f of un) files.push({ file: f, status: "A", cls: "logic", why: "new untracked file" });
  }
  const pats = sensitivePatterns(roster);
  const scoped = pats.length ? files.filter((f) => pats.some((re) => re.test(f.file))) : files;
  // A pattern file is light only once a full audit of that pattern is on record; its first use is audited in full.
  const logic = scoped.filter((f) => f.cls === "logic" || (f.cls === "pattern" && !f.seen));
  const light = scoped.filter((f) => !logic.includes(f));
  const repeats = scoped.filter((f) => f.cls === "pattern" && f.seen);
  const firstUse = [...new Set(scoped.filter((f) => f.cls === "pattern" && !f.seen).map((f) => f.pattern))];
  const coverage = [...new Set(repeats.map((f) => f.coverage).filter(Boolean))];
  let depth = "none";
  if (scoped.length) depth = logic.length ? "full" : "light";
  const patternNote = repeats.length
    ? ` ${repeats.length} file(s) change only the already-audited pattern ${[...new Set(repeats.map((f) => `"${f.pattern}"`))].join(", ")}: confirm with \`git diff -w\` that nothing else changed${coverage.length ? ` and that the coverage check passes (${coverage.join("; ")})` : ""}, and do not hunt for older issues in the code those files already contained (note any in the backlog; they do not block this change).`
    : "";
  const firstNote = firstUse.length ? ` First use of pattern ${firstUse.map((n) => `"${n}"`).join(", ")}: audit one batch in full, confirm with \`git diff -w\` that only the pattern's lines changed, then write \`pattern: ${firstUse[0]}\` in the ledger entry so later batches of the same shape can be audited light.` : "";
  const advice =
    depth === "none"
      ? "No sensitive file changed: no audit entry is required by the gate for this diff."
      : depth === "light"
        ? `Light audit: every changed sensitive file is mechanical, import-only or a repeat of an audited pattern. Verify each re-pointed import resolves to the moved/renamed module, then write a short ledger entry naming all files. A cheaper model is enough.${patternNote}`
        : `Full audit for ${logic.length} file(s) with logic changes or a first-use pattern; the ${light.length} other file(s) need one line each in the same ledger entry.${firstNote}${patternNote}`;
  // The route an audit of this depth needs (tier + effort): thinking harder is cheaper than a bigger model and keeps the
  // prompt cache, so a light audit gets the middle tier at medium effort and only a full one the top tier at high.
  const route = depth === "none" ? null : depth === "light" ? { tier: "default", effort: "medium" } : { tier: "high", effort: "high" };
  return { depth, route, advice, sensitiveFiles: scoped.length, totalFiles: files.length, files: scoped };
}

function printRisk(rep) {
  if (rep.error) return console.log(rep.error);
  for (const f of rep.files) console.log(`${f.cls.padEnd(12)} ${f.status} ${f.file}   (${f.why})`);
  console.log(`\naudit depth: ${rep.depth.toUpperCase()} — ${rep.advice}`);
  if (rep.route) console.log(`suggested route: tier ${rep.route.tier}, effort ${rep.route.effort}`);
}

// =====================================================================================================
// `stamp` and `plan` — stop repeating work, and stop serialising work that is independent
// =====================================================================================================
// stamp: "the suite is green for THIS exact tree". In a real project the same ~1,000-test suite ran three times
// per change (the agent, the person, the auditor), each rerun adding minutes and tokens and no information.
// A stamp records a fingerprint of the tree (HEAD + uncommitted diff + new files) when a check passes; the next
// role runs `stamp check` and, if the tree is unchanged, reuses the result and runs only its own targeted probes.
// Write the stamp as the LAST step of the command the gate runs (selfVerification), so it can only exist after
// that command passed:   "selfVerification": "<suite> && node .agent-team/orchestrator.mjs stamp write suite"
// It caches a check that ran; it is not proof against an agent that writes one by hand.
const STAMPS_PATH = path.join(TEAM_DIR, "stamps.json");

function treeFingerprint(cwd = ROOT) {
  const h = crypto.createHash("sha256");
  h.update(gitHead(cwd) || "no-head");
  const diff = spawnSync("git", ["diff", "HEAD", "--no-color"], { cwd, encoding: "utf8", maxBuffer: 300 * 1024 * 1024 }).stdout || "";
  h.update(diff);
  const skip = RUNTIME_PATHS.map(globToRegex);
  for (const f of untrackedFiles(cwd).filter((x) => !skip.some((re) => re.test(x))).sort()) {
    h.update("\0" + f + "\0");
    try {
      h.update(fs.readFileSync(path.join(cwd, f)));
    } catch {
      /* unreadable: its name still counts */
    }
  }
  return h.digest("hex");
}

function readStamps() {
  try {
    return JSON.parse(fs.readFileSync(STAMPS_PATH, "utf8"));
  } catch {
    return {};
  }
}

function stampCommand(args) {
  const [sub, label = "default"] = args;
  const maxAgeIdx = args.indexOf("--max-age-min");
  const maxAge = maxAgeIdx >= 0 ? Number(args[maxAgeIdx + 1]) : null;
  if (sub === "write") {
    const s = readStamps();
    s[label] = { fingerprint: treeFingerprint(), at: new Date().toISOString(), head: gitHead(ROOT) };
    fs.mkdirSync(TEAM_DIR, { recursive: true });
    fs.writeFileSync(STAMPS_PATH, JSON.stringify(s, null, 2) + "\n");
    logEvent("stamp_write", { label });
    console.log(`stamped "${label}" for this tree`);
    return 0;
  }
  if (sub === "check") {
    const rec = readStamps()[label];
    if (!rec) {
      console.log(`no stamp "${label}": run the check`);
      return 1;
    }
    const ageMin = Math.round((Date.now() - Date.parse(rec.at)) / 60000);
    if (maxAge != null && ageMin > maxAge) {
      console.log(`stale: "${label}" was stamped ${ageMin} min ago (limit ${maxAge}): run the check`);
      return 1;
    }
    if (rec.fingerprint !== treeFingerprint()) {
      console.log(`stale: the tree changed since "${label}" was stamped ${ageMin} min ago: run the check`);
      return 1;
    }
    logEvent("stamp_reused", { label, ageMin });
    console.log(`valid: "${label}" passed ${ageMin} min ago for this exact tree: reuse it, run only your own targeted probes`);
    return 0;
  }
  if (sub === "show") {
    const s = readStamps();
    for (const [k, v] of Object.entries(s)) console.log(`${k}: ${v.at} head ${String(v.head).slice(0, 8)} ${v.fingerprint === treeFingerprint() ? "(valid for this tree)" : "(stale)"}`);
    if (!Object.keys(s).length) console.log("no stamps");
    return 0;
  }
  console.error("usage: orchestrator.mjs stamp write|check|show [label] [--max-age-min N]");
  return 1;
}

// plan: which open queue items can run side by side? Two items conflict if they go to the same agent, to agents
// whose ownership overlaps, or one says [after:N] (N = its number in this list). Items that don't conflict form
// a batch; dispatch a batch's items in ONE message, each in its own worktree. Parallelism pays only for
// independent work (a scaling study measured +81% on parallelisable tasks and -39% to -70% on sequential ones),
// so the default is conservative: unknown or empty ownership conflicts with everything.
function ownershipPrefixes(agent) {
  const g = agent.ownership || [];
  if (!g.length) return [""];
  return g.map((x) => x.replace(/\*.*$/, ""));
}

function planBatches() {
  const roster = readJson(ROSTER_PATH);
  const items = parseQueue(readStatusFile()).filter((i) => !i.done && !i.blocked);
  const rows = items.map((it, i) => {
    let agent = null;
    let error = null;
    try {
      agent = resolveAgent(roster, it);
    } catch (e) {
      error = e.message;
    }
    const after = (it.text.match(/\[after:(\d+)\]/) || [])[1];
    return { n: i + 1, text: it.text, agent, error, after: after ? Number(after) : null };
  });
  const conflicts = (a, b) => {
    if (!a.agent || !b.agent) return true;
    if (a.agent.name === b.agent.name) return true;
    const pa = ownershipPrefixes(a.agent);
    const pb = ownershipPrefixes(b.agent);
    return pa.some((x) => pb.some((y) => x.startsWith(y) || y.startsWith(x)));
  };
  const cap = Number(roster.maxParallel) || 3;
  const batches = [];
  const batchOf = new Map();
  for (const r of rows) {
    let start = 0;
    if (r.after && batchOf.has(r.after)) start = batchOf.get(r.after) + 1;
    for (const prev of rows.slice(0, r.n - 1)) if (conflicts(r, prev) && batchOf.has(prev.n)) start = Math.max(start, batchOf.get(prev.n) + 1);
    let b = start;
    while (b < batches.length && batches[b].length >= cap) b++;
    (batches[b] ||= []).push(r);
    batchOf.set(r.n, b);
  }
  return batches.map((b) => b.map((r) => ({ n: r.n, agent: r.agent ? r.agent.name : null, text: r.text, error: r.error, suggestedTier: suggestTier(r.text).tier })));
}

function printPlan(batches) {
  if (!batches.length) return console.log("queue is empty");
  batches.forEach((b, i) => {
    console.log(`batch ${i + 1}${b.length > 1 ? `  — ${b.length} independent items: dispatch together, each in its own worktree` : "  — one item"}`);
    for (const r of b) console.log(`  #${r.n} ${r.agent ? `[${r.agent}]` : "[UNROUTED]"}${r.suggestedTier === "light" ? " [tier:light suggested]" : ""} ${r.text.replace(/\[after:\d+\]/, "").trim().slice(0, 100)}${r.error ? `   (${r.error.slice(0, 60)})` : ""}`);
  });
  console.log(`\n${batches.filter((b) => b.length > 1).length} parallel batch(es). A batch runs after the previous one finishes. Tag a dependency with [after:N].`);
}

// =====================================================================================================
// `tier` — which model should this task START on?
// =====================================================================================================
// Nothing in the system used the cheapest model for the work it suits: in a real project the small model produced
// 0.4% of subagent output, because a tier only applies if a person tags the item or sets the agent's tier. A pilot
// of mechanical tasks (a docs edit, a config edit, a rename, a test written to a spec) passed 4/4 on Haiku and 4/4
// on Sonnet with escalation off. This is a small, deliberately conservative hint: it can only move a task DOWN to
// "light", never up, and never for anything near authentication, tenancy, secrets, migrations or design. If a light
// attempt fails its check, escalation (light -> default -> high) takes over, so a wrong guess costs one cheap try.
// It is a keyword heuristic, not a classifier: opt in per agent with `"autoTier": true` and watch `usage`.
const TIER_SENSITIVE_RE = /\b(auth\w*|rls|row[- ]level|tenan\w*|migrat\w*|secur\w*|permission\w*|rbac|encrypt\w*|secret\w*|credential\w*|token\w*|password\w*|threat|audit\w*|architect\w*|schema|crypto\w*|injection|sanitiz\w*)\b/i;
const TIER_REASONING_RE = /\b(design|implement|refactor|investigate|debug|diagnos\w*|why|optimi[sz]e|performance|race|concurren\w*|bug|failing|broken|regression)\b/i;
const TIER_MECHANICAL_RE = /\b(rename|typo|comment|docs?|documentation|readme|changelog|glossary|format(?:ting)?|prettier|whitespace|bump|pin|configuration|config|summari[sz]e|boilerplate|test scaffold\w*|add (?:a |one |the )?(?:new )?test (?:named|to (?:the )?spec|for)|license header)\b/i;

function suggestTier(text) {
  const t = String(text || "").replace(/\[[^\]]*\]/g, " ").trim();
  if (TIER_SENSITIVE_RE.test(t)) return { tier: "default", effort: "high", why: "touches a sensitive area (auth, tenancy, secrets, migrations, schema, audit): never start light, and think harder" };
  if (TIER_REASONING_RE.test(t)) return { tier: "default", effort: "medium", why: "asks for design, debugging or other reasoning, not a mechanical edit" };
  if (t.length > 450) return { tier: "default", effort: "medium", why: "long, multi-part task: not clearly mechanical" };
  if (TIER_MECHANICAL_RE.test(t)) return { tier: "light", effort: "low", why: "mechanical edit with an objective check (docs, config, rename, formatting, test to a spec)" };
  return { tier: "default", effort: "medium", why: "no mechanical signal" };
}

// Routing memory. Every headless dispatch logs what it was asked, the tier and effort of each attempt and whether it passed
// (dispatch_end). A task that resembles earlier ones which needed escalating should not start on the cheap rung again.
// This is a nearest-neighbour lookup over the project's OWN outcomes, not a trained router: published comparisons found
// such a lookup matched far more complex learned routers and held up better on new kinds of task. It only ever moves a
// start UP (never below what the rules say), needs two or more similar tasks, and says what it based the call on.
const STOP_WORDS = new Set(["this", "that", "with", "from", "into", "each", "every", "then", "also", "make", "update", "change", "should", "which", "there", "their", "about", "after", "before", "when", "will", "must"]);
const wordsOf = (t) => new Set((String(t || "").toLowerCase().match(/[a-z][a-z0-9_-]{3,}/g) || []).filter((w) => !STOP_WORDS.has(w)));
// The event log never holds prompt or output text (a prompt can carry anything), so what a dispatch was about is kept as
// short hashes of its keywords: enough to tell two tasks are alike, not a way to read the task back.
const wordHashes = (t) => [...wordsOf(t)].slice(0, 40).map((w) => crypto.createHash("sha1").update(w).digest("hex").slice(0, 8));
function learnedTier(text, sug) {
  if (!fs.existsSync(EVENTS_PATH)) return null;
  const mine = wordsOf(text);
  if (mine.size < 2) return null;
  const myHashes = new Set(wordHashes(text));
  const near = [];
  for (const line of fs.readFileSync(EVENTS_PATH, "utf8").split("\n")) {
    if (!line.includes('"dispatch_end"')) continue;
    let e;
    try {
      e = JSON.parse(line);
    } catch {
      continue;
    }
    if (e.type !== "dispatch_end" || !Array.isArray(e.taskWords) || !e.taskWords.length || e.deferred) continue;
    const theirs = new Set(e.taskWords);
    const shared = [...myHashes].filter((w) => theirs.has(w)).length;
    const sim = shared / (myHashes.size + theirs.size - shared || 1);
    if (sim >= 0.4) near.push({ sim, e });
  }
  const top = near.sort((a, b) => b.sim - a.sim).slice(0, 5).map((x) => x.e);
  const escalated = top.filter((e) => e.attempts > 1 || !e.pass);
  if (top.length < 2 || escalated.length < 2 || escalated.length / top.length < 2 / 3) return null;
  const rank = (t) => TIER_LADDER.indexOf(t);
  const endOf = (e) => ({ tier: e.tiersTried[e.tiersTried.length - 1], effort: (e.efforts || [])[e.efforts.length - 1] || null });
  const ends = escalated.map(endOf).filter((x) => rank(x.tier) >= 0).sort((a, b) => rank(b.tier) - rank(a.tier) || EFFORT_LADDER.indexOf(b.effort) - EFFORT_LADDER.indexOf(a.effort));
  if (!ends.length) return null;
  const best = ends[0];
  const raises = rank(best.tier) > rank(sug.tier) || (rank(best.tier) === rank(sug.tier) && EFFORT_LADDER.indexOf(best.effort) > EFFORT_LADDER.indexOf(sug.effort));
  if (!raises) return null;
  return { tier: best.tier, effort: best.effort || sug.effort, why: String(escalated.length) + " of " + String(top.length) + " similar past tasks needed escalating and ended on " + best.tier + (best.effort ? " at " + best.effort + " effort" : ""), based: top.length };
}

const [, , cmd, ...rest] = process.argv;
if (cmd === "run-phase") {
  await runPhase();
} else if (cmd === "spawn") {
  const worktree = rest.includes("--worktree") || rest.includes("--no-merge");
  const noMerge = rest.includes("--no-merge");
  const noEscalate = rest.includes("--no-escalate");
  const ti = rest.indexOf("--tier");
  const tier = ti >= 0 ? rest[ti + 1] : undefined;
  if (tier !== undefined && !TIER_LADDER.includes(tier)) {
    console.error(`--tier must be one of ${TIER_LADDER.join(", ")}`);
    process.exit(1);
  }
  const ei = rest.indexOf("--effort");
  const effort = ei >= 0 ? rest[ei + 1] : undefined;
  if (effort !== undefined && !EFFORT_RE.test(String(effort))) {
    console.error("--effort must be one of low, medium, high, xhigh, max");
    process.exit(1);
  }
  const [agentName, taskText] = rest.filter((a, i) => !["--worktree", "--no-merge", "--no-escalate", "--tier", "--effort"].includes(a) && !(ti >= 0 && i === ti + 1) && !(ei >= 0 && i === ei + 1));
  if (!agentName || !taskText) {
    console.error('usage: orchestrator.mjs spawn <agent-name> "<task text>" [--worktree] [--no-merge] [--tier light|default|high] [--effort low|medium|high|xhigh] [--no-escalate]');
    process.exit(1);
  }
  await spawnAdHoc(agentName, taskText, { worktree, noMerge, tier, effort, noEscalate });
} else if (cmd === "ask") {
  const modelIdx = rest.indexOf("--model");
  const model = modelIdx >= 0 ? rest[modelIdx + 1] : null;
  const providerName = rest.find((a, i) => !a.startsWith("--") && (modelIdx < 0 || i !== modelIdx + 1));
  if (!providerName || (modelIdx >= 0 && !model)) {
    console.error("usage: orchestrator.mjs ask <provider> [--model <id>]   (prompt on stdin)");
    process.exit(1);
  }
  await askProvider(providerName, model);
} else if (cmd === "tier") {
  const text = rest.filter((a) => !a.startsWith("--")).join(" ");
  const base = suggestTier(text);
  const learned = learnedTier(text, base);
  const sug = learned ? { tier: learned.tier, effort: learned.effort, why: learned.why, rule: base, learned } : base;
  if (rest.includes("--json")) console.log(JSON.stringify(sug));
  else console.log(`${sug.tier}${sug.effort ? ` (effort ${sug.effort})` : ""} — ${sug.why}${learned ? `; the rules alone said ${base.tier}` : ""}`);
  process.exit(0);
} else if (cmd === "stamp") {
  process.exit(stampCommand(rest));
} else if (cmd === "plan") {
  const batches = planBatches();
  if (rest.includes("--json")) console.log(JSON.stringify(batches, null, 2));
  else printPlan(batches);
  process.exit(0);
} else if (cmd === "risk") {
  const rep = riskReport(rest);
  if (rest.includes("--json")) console.log(JSON.stringify(rep, null, 2));
  else printRisk(rep);
  process.exit(rep.error ? 1 : 0);
} else if (cmd === "usage") {
  const di = rest.indexOf("--days");
  const ti = rest.indexOf("--transcripts");
  const hooksSeen = fs.existsSync(EVENTS_PATH) && fs.readFileSync(EVENTS_PATH, "utf8").includes('"subagent_start"');
  const rep = usageReport({ days: di >= 0 ? Number(rest[di + 1]) || null : null, transcripts: ti >= 0 ? rest[ti + 1] : null, hooksSeen });
  if (rest.includes("--json")) console.log(JSON.stringify(rep, null, 2));
  else printUsage(rep);
  process.exit(rep.error ? 1 : 0);
} else if (cmd === "hook") {
  // Claude Code hook entry point. Any internal failure must fail OPEN: only a deliberate block exits 2.
  let code = 0;
  try {
    code = await runHook(rest[0]);
  } catch (e) {
    logEvent("hook_error", { event: rest[0], message: String(e.message).slice(0, 160) });
  }
  process.exit(code);
} else if (cmd === "seal") {
  const roster = fs.existsSync(ROSTER_PATH) ? readJson(ROSTER_PATH) : {};
  if (!(await confirmSeal())) process.exit(1);
  console.log(`sealed ${sealNow(roster)} protected files`);
} else if (cmd === "integrity") {
  process.exit(printIntegrity());
} else if (cmd === "stop") {
  fs.mkdirSync(TEAM_DIR, { recursive: true });
  fs.writeFileSync(STOP_PATH, `${new Date().toISOString()}\n`);
  logEvent("stop_requested");
  console.log("STOP set — running workers are killed within ~2s and no new dispatch starts. `resume` clears it.");
} else if (cmd === "resume") {
  fs.rmSync(STOP_PATH, { force: true });
  logEvent("resumed");
  console.log("STOP cleared");
} else if (cmd === "lint") {
  const findings = lintProject();
  for (const f of findings) console.log(`[${f.level}] ${f.msg}`);
  const errors = findings.filter((f) => f.level === "error").length;
  console.log(`${errors} error(s), ${findings.length - errors} warning(s)`);
  process.exit(errors ? 1 : 0);
} else if (cmd === "log") {
  printLog(Number(rest[0]) || 20);
} else if (cmd === "status") {
  printStatus();
} else if (cmd === "quota") {
  const providers = readJson(PROVIDERS_PATH);
  for (const name of Object.keys(providers)) {
    if (name.startsWith("_")) continue; // skip _comment / _extension_pattern entries
    const q = await checkQuota(name);
    if (q.reliable) {
      const resetNote = q.resetsAt ? `, resets ${new Date(q.resetsAt).toISOString()}` : "";
      const band = q.percent >= QUOTA_HARD_THRESHOLD ? "HARD LIMIT" : q.percent >= QUOTA_SOFT_THRESHOLD ? "emergency band" : "normal";
      console.log(`${name}: ${q.percent}% (${band})${resetNote}`);
    } else {
      console.log(`${name}: unknown — ${q.error}`);
    }
  }
} else {
  console.error('usage: orchestrator.mjs run-phase | spawn <agent> "<task>" [--worktree] [--no-merge] [--tier t] [--no-escalate] | ask <provider> [--model <id>] | seal | integrity | stop | resume | lint | log [n] | usage [--days N] [--json] | risk [base [head]] [--staged] | stamp write|check|show [label] | plan [--json] | tier "<task>" | hook <event> | status | quota');
  process.exit(1);
}
