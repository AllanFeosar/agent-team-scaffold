#!/usr/bin/env bash
# Security gate: blocks a change when it touches security-sensitive files and
# the security-audit-log ledger doesn't name them in lines that same change
# adds. One script, three entry points, so every provider enforces one rule:
#
#   security-gate.sh                    Claude Code PreToolUse hook on Bash
#                                       (reads the hook JSON from stdin; acts on
#                                       `git commit` / `git push` commands only)
#   security-gate.sh pre-commit         git pre-commit hook: covers Codex,
#                                       Gemini CLI, any other agent, and people
#   security-gate.sh range <base> <head>  a branch or PR diff: used by
#                                       orchestrator.mjs before a worktree
#                                       merge, and by CI
#
# Exit 2 blocks (the PreToolUse hook and git both treat non-zero as a block);
# exit 0 lets the change through.
#
# The path list is .claude/security-sensitive-paths.txt. It is read from git,
# never the working tree, so an unstaged edit can't weaken the gate, and a
# change can't remove its own coverage: classification uses the union of the
# list before and after the change. The gate's own files are hard-coded below.
#
# Path-list syntax, identical to security-gate.ps1: one regex per line; "?regex" may match no tracked file yet;
# "!regex" is required and stays sensitive even if it is a test file. The ledger is append-only: a change may
# add lines but not edit or remove existing ones. One difference remains: the PowerShell script also parses
# the shell command in pretooluse mode and refuses spellings that hide a commit (quoted or escaped git, GIT_DIR
# overrides, -c core.hooksPath); this script only matches the words `git commit|push`. Where agents run
# arbitrary shell commands, prefer the PowerShell script (it also runs under pwsh on Linux and macOS) or rely
# on the git pre-commit hook, which sees the real commit.
# FAIL OPEN only for problems outside the repo's control (unparseable hook
# input, not inside a git repository). Anything that would silently disable
# the gate (missing or invalid list, git failing mid-check) blocks instead.
set +e

ledger_path=".claude/contracts/security-audit-log.md"
paths_file=".claude/security-sensitive-paths.txt"
self_pattern='^\.claude/(hooks/security-gate\.(ps1|sh)|security-sensitive-paths\.txt|settings(\.local)?\.json)$|^\.githooks/pre-commit$'
test_pattern='<test-file regex, e.g. \.(test|spec)\.[jt]sx?$ or (^|/)tests?/>'

# One line on every passing check in pre-commit and range mode, so CI can tell a real check from an old
# gate script that ignores its arguments and exits 0.
pass_checked() { [ "$mode" = "pretooluse" ] || echo "security-gate: checked $1 changed file(s) in $mode mode"; exit 0; }
fail_open() { echo "security-gate: $1 (fail-open, letting the change through)"; exit 0; }
fail_config() { echo "Security gate blocked this change: $1" >&2; exit 2; }
fail_gate() {
    echo "Security gate blocked this change: $1" >&2
    echo "Dispatch <security-agent-name> to audit the files above, have it append a $ledger_path entry naming them, then retry." >&2
    exit 2
}
g() { git -c core.quotePath=false "$@"; }

mode="${1:-pretooluse}"
case "$mode" in
    pretooluse)
        command -v jq >/dev/null 2>&1 || fail_config "jq is required to read the hook input"
        payload="$(cat)"
        cmd="$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null)" || fail_open "could not parse hook input"
        [ -z "$cmd" ] && exit 0
        # Catches `git commit`, `git -C dir commit`, `git -c k=v commit`, and push.
        printf '%s' "$cmd" | grep -qE '(^|[^[:alnum:]_])git([^;&|[:alnum:]_][^;&|]*)?[^[:alnum:]_](commit|push)([^[:alnum:]_]|$)' || exit 0
        ;;
    pre-commit) ;;
    range)
        base="$2"; head="$3"
        [ -n "$base" ] && [ -n "$head" ] || fail_config "range mode needs <base> <head>"
        ;;
    *) fail_config "unknown mode '$mode'" ;;
esac

top="$(git rev-parse --show-toplevel 2>/dev/null)" || fail_open "not inside a git repository"
cd "$top" || fail_open "cannot cd to the repository root"

# Changed files, the list before and after, and the ledger lines this change adds.
# --no-renames lists a move as delete + add, so the source path is classified too.
if [ "$mode" = "range" ]; then
    changed="$(g diff --name-only --no-renames "$base...$head")" || fail_config "git diff $base...$head failed"
    list_before="$(g show "$base:$paths_file" 2>/dev/null)"
    list_after="$(g show "$head:$paths_file" 2>/dev/null)" || fail_config "$paths_file is missing at $head"
    tracked="$(g ls-tree -r --name-only "$head")" || fail_config "git ls-tree $head failed"
    ledger_old_ref="$base"; ledger_new_ref="$head"
    ledger_changed() { printf '%s\n' "$changed" | grep -qxF "$ledger_path"; }
    ledger_added() { g diff -U0 "$base...$head" -- "$ledger_path" | grep '^+' | grep -v '^+++' | cut -c2-; }
else
    changed="$(g diff --cached --name-only --no-renames)" || fail_config "git diff --cached failed"
    list_before="$(g show "HEAD:$paths_file" 2>/dev/null)"
    list_after="$(g show ":$paths_file" 2>/dev/null)" || fail_config "$paths_file is not in the index (missing, deleted, or never added)"
    tracked="$(g ls-files)" || fail_config "git ls-files failed"
    ledger_old_ref="HEAD"; ledger_new_ref=""
    ledger_changed() { printf '%s\n' "$changed" | grep -qxF "$ledger_path"; }
    ledger_added() { g diff --cached -U0 -- "$ledger_path" | grep '^+' | grep -v '^+++' | cut -c2-; }
fi
[ -z "$changed" ] && pass_checked 0
nchanged="$(printf '%s\n' "$changed" | grep -c .)"

patterns_of() { printf '%s\n' "$1" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -vE '^(#|$)'; }
required_of() { patterns_of "$1" | grep -v '^?' | sed 's/^!//'; }
optional_of() { patterns_of "$1" | grep '^?' | sed 's/^?//'; }
tests_of() { patterns_of "$1" | grep '^!' | sed 's/^!//'; }
valid_re() { echo "" | grep -qiE -- "$1" 2>/dev/null; [ $? -ne 2 ]; }

after_all="$( { required_of "$list_after"; optional_of "$list_after"; } | sort -u)"
[ -z "$after_all" ] && fail_config "$paths_file has no patterns"
# Validate every pattern on its own: one bad line in the new list must block, not disable the rest. A bad line
# that is only in the old list never matched anything, so it is skipped and the commit that fixes it isn't blocked.
while IFS= read -r p; do
    [ -z "$p" ] && continue
    valid_re "$p" || fail_config "invalid pattern in $paths_file: '$p'"
done <<< "$after_all"
extra=""
while IFS= read -r p; do
    [ -z "$p" ] && continue
    printf '%s\n' "$after_all" | grep -qxF -- "$p" && continue
    if valid_re "$p"; then extra="$extra$p"$'\n'; else echo "security-gate: ignoring invalid pattern '$p' from the previous $paths_file"; fi
done <<< "$( { required_of "$list_before"; optional_of "$list_before"; } | sort -u)"
all_patterns="$(printf '%s\n%s\n%s\n' "$after_all" "$extra" "$self_pattern" | grep -v '^$')"
required="$(required_of "$list_after")"

# Liveness: every required pattern must still match a tracked file. A pattern
# that matches nothing means files moved or were deleted without the list
# moving with them, which would leave them ungated.
dead=""
while IFS= read -r p; do
    [ -z "$p" ] && continue
    printf '%s\n' "$tracked" | grep -qiE -- "$p" || dead="$dead $p"
done <<< "$required"
if [ -n "$dead" ]; then
    echo "Security gate blocked this change: these patterns in $paths_file match no tracked file:$dead" >&2
    echo "Files they covered were moved or deleted. Point the patterns at the new paths (or prefix a planned path with '?'), then retry." >&2
    exit 2
fi

# A test file is exempt unless a "!" line names it (a test that is itself a security control).
test_controls=""
while IFS= read -r p; do
    [ -z "$p" ] && continue
    valid_re "$p" && test_controls="$test_controls$p"$'\n'
done <<< "$( { tests_of "$list_after"; tests_of "$list_before"; } | sort -u)"
candidates="$(printf '%s\n' "$changed" | grep -iE -f <(printf '%s\n' "$all_patterns"))"
sensitive=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    if printf '%s\n' "$f" | grep -qE -- "$test_pattern"; then
        [ -n "$test_controls" ] && printf '%s\n' "$f" | grep -qiE -f <(printf '%s' "$test_controls") || continue
    fi
    sensitive="$sensitive$f"$'\n'
done <<< "$candidates"
[ -z "$sensitive" ] && pass_checked "$nchanged"

ledger_changed || fail_gate "security-sensitive files changed ($(echo $sensitive)) but $ledger_path has no new entry in this change"

# The ledger is append-only: the old content must be an exact prefix of the new.
if g show "$ledger_old_ref:$ledger_path" >/dev/null 2>&1; then
    old_text="$(g show "$ledger_old_ref:$ledger_path" | tr -d '\r')"
    new_text="$(g show "$ledger_new_ref:$ledger_path" 2>/dev/null | tr -d '\r')" || fail_config "$ledger_path can't be read in the new version"
    if [ -n "$old_text" ]; then
        n="$(printf '%s\n' "$old_text" | wc -l)"
        [ "$(printf '%s\n' "$new_text" | head -n "$n")" = "$old_text" ] || fail_config "$ledger_path is append-only; this change edits or removes existing lines"
    fi
fi

# Only lines this change ADDS to the ledger count, matched case-sensitively on
# path boundaries so `a/b.ts` doesn't satisfy `a/b.tsx` or `xa/b.ts`.
added="$(ledger_added)"
missing=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    esc="$(printf '%s' "$f" | sed 's/[][\.*^$+?(){}|/]/\\&/g')"
    printf '%s\n' "$added" | grep -qE -- "(^|[^[:alnum:]_./-])$esc([^[:alnum:]_./-]|$|\.([^[:alnum:]_./-]|$))" || missing="$missing $f"
done <<< "$sensitive"
[ -n "$missing" ] && fail_gate "these security-sensitive files aren't named in the lines this change adds to $ledger_path:$missing"

pass_checked "$nchanged"
