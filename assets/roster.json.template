{
  "_comment": "The orchestrator's source of truth — machine-readable, so orchestrator.mjs can parse it. AGENTS.md's routing table is generated FROM this for humans; this file is what the script actually reads. Keep both in sync by hand when the roster changes, the same way agent.md and this entry describe the same agent from two angles (prose for a human/harness, data for the script). This file is a PROTECTED file: after a person edits it, review the diff and run `node .agent-team/orchestrator.mjs seal`, or every dispatch refuses to start. Delete the _comment and every optional key you don't use.",

  "agents": [
    {
      "name": "<agent-name>",
      "provider": "<key from providers.json — claude | codex | gemini | ...>",
      "ownership": ["<glob pattern the roster-partition check already validated, e.g. backend/**>"],
      "selfVerification": "<the exact command from this agent's agent.md Self-verification section>",
      "routing": ["<task-type keyword 1>", "<task-type keyword 2>"],
      "worktree": true,
      "setupCommand": "<optional — a command that installs this agent's gitignored dependencies (e.g. 'cd backend && composer.bat install --no-interaction', 'cd frontend && npm.cmd ci') in a fresh worktree before the first dispatch. Omit entirely if this layer has no gitignored install step. Needed because a git worktree only contains tracked files — vendor/, node_modules/, and similar directories won't exist until this runs once per worktree. On Windows, name a global tool with its explicit .bat/.cmd extension ('composer.bat', not bare 'composer') — self-verification and setupCommand both run through bash there by default (see the Windows shell note below), which resolves an explicit extension fine but won't auto-append one the way cmd.exe's PATHEXT does for a bare command name.>",
      "shell": "<optional — 'cmd' or 'bash', overrides the default (bash on Windows, unchanged elsewhere) for BOTH selfVerification and setupCommand on this agent. Omit for POSIX-style commands (vendor/bin/phpunit, ./node_modules/.bin/jest) — bash is already right for those. Set to 'cmd' when this agent's own tooling uses Windows-native single-slash flag syntax (MSBuild, csc.exe, devenv.exe, dotnet.exe with /p: switches) — verified live: bash's own MSYS path-conversion mangles a leading '/' on an argument that looks like a Unix path, silently turning '/p:Configuration=Debug' into 'p:Configuration=Debug' and producing a confusing build error instead of a clean failure. Neither shell is safe to assume for every project; this field is how a project says which one its own commands actually need.>",
      "mergePolicy": "<optional — 'manual' leaves a passing branch and its worktree for a person to review and merge (the queue item is marked BLOCKED 'awaiting human merge'); omit for the default, merge automatically. Use manual for the agents whose output you want to read before it lands (security, migrations, infra). Requires worktree: true.>",
      "maxBudgetUsd": "<optional — a positive number; per-dispatch spend cap, passed to the provider if providers.json declares a budgetFlag for it (Claude Code does: --max-budget-usd). Overrides defaults.maxBudgetUsd. For a provider with no budget flag the cap cannot be enforced and a budget_unenforced event is logged instead.>",
      "verifier": "<optional — { \"provider\": \"codex\", \"model\": \"<optional>\" }: after this agent's self-verification passes, a SECOND read-only call from that provider reviews the diff against the playbook's Definition of done and must end with 'VERDICT: PASS'. A FAIL goes back to the worker as a failed attempt. Prefer a different provider than the worker's — a reviewer from the same model shares its blind spots. The provider needs adviceArgs in providers.json. Fails open if the reviewer is unavailable.>"
    }
  ],

  "securityAgent": "<name of the security-type agent, or omit this key if the roster has none>",
  "securitySensitivePaths": ["<glob pattern, e.g. **/routers/**>", "<e.g. **/middleware/**>", "<e.g. **/auth/**>"],

  "defaults": { "maxBudgetUsd": "<optional — default per-dispatch spend cap in USD, e.g. 2>" },
  "testPaths": ["<optional — globs identifying test files for the tamper guard. Default: **/*.test.*, **/*.spec.*, **/test_*.py, **/*_test.*, **/tests/**, **/test/**, **/__tests__/**>"],
  "testTamperGuard": "<optional — set false only to disable the guard that rejects deleted tests, added skips, and net-removed assertions. A task can opt out for one dispatch by containing [allow-test-changes].>",
  "integrationCheck": "<optional — a whole-repo command (end-to-end or cross-layer contract test) run after every merge. If it fails the merge is rolled back (run-phase, or spawn on a clean tree) and the item is blocked. Each agent's own check proves its layer; this proves the layers still work together.>",
  "integrationShell": "<optional — 'cmd' or 'bash' for integrationCheck, same meaning as an agent's shell>",
  "featureList": "<optional — path to a features.json (assets/features.json.template). Turns on the startup routine in every prompt and the guard that only lets 'passes' change.>",
  "progressFile": "<optional — path to the running progress notes the startup routine tells each session to read>",
  "initScript": "<optional — path to init.sh (assets/init.sh.template)>",
  "integrityExclude": ["<optional — protected paths to leave out of the seal, e.g. a CLAUDE.md or AGENTS.md people edit daily. Default protected: roster/providers/council/allowlist/orchestrator in .agent-team, AGENTS.md, CLAUDE.md, .claude/hooks/**, .claude/agents/**, and each tentacle's PLAYBOOK.md, CONTEXT.md and files/**>"]
}
